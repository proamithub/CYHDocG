        function appendChatMessage(type, text, sender) {
            const stream = document.getElementById('messageStream');
            const isMe = type === 'me';

            const bubbleHtml = `
            <div class="flex items-start gap-3 ${isMe ? 'justify-end' : ''}">
                ${!isMe ? `
                    <div class="w-8 h-8 rounded-xl ${type === 'doctor' ? 'bg-blue-600/20 text-blue-400' : 'bg-emerald-500/20 text-emerald-400'} flex items-center justify-center flex-shrink-0 text-xs font-bold font-heading">
                        ${type === 'doctor' ? 'Dr' : (type === 'ai' ? 'AI' : 'Pt')}
                    </div>
                ` : ''}
                <div class="${isMe ? 'bg-red-600 text-white rounded-2xl rounded-tr-sm' : 'bg-slate-800/90 border border-slate-700/60 text-slate-200 rounded-2xl rounded-tl-sm'} p-3.5 max-w-md text-xs sm:text-sm leading-relaxed shadow">
                    <span class="block text-[10px] font-bold ${isMe ? 'text-red-200' : 'text-slate-400'} mb-1">${sender}</span>
                    ${text.replace(/\n/g, '<br/>')}
                </div>
            </div>`;

            stream.insertAdjacentHTML('beforeend', bubbleHtml);
            stream.scrollTop = stream.scrollHeight;
        }

        function sendQuickPrompt(promptText) {
            document.getElementById('userChatInput').value = promptText;
            document.querySelector('form').dispatchEvent(new Event('submit', { cancelable: true }));
        }

        function openDoctorSelectModal() {
            if (!isUserAuth) {
                if (confirm("Please sign in to connect with a live doctor. Go to Login?")) {
                    window.location.href = '/Account/Login?returnUrl=/LiveChat';
                }
                return;
            }
            document.getElementById('doctorSelectModal').classList.remove('hidden');
        }

        function closeDoctorSelectModal() {
            document.getElementById('doctorSelectModal').classList.add('hidden');
        }

        let pendingDoctorName = '';
        let pendingRate = 0;
        let pendingIsPaid = false;

        async function requestDoctorConsultation(doctorId, doctorName, rate, isPaid) {
            closeDoctorSelectModal();
            pendingDoctorName = doctorName;
            pendingRate = rate;
            pendingIsPaid = isPaid;

            try {
                const res = await fetch('/api/consultation/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctorId: doctorId })
                });
                const data = await res.json();
                if (data.success) {
                    activeConsultationId = data.data;

                    document.getElementById('chatPartnerName').textContent = doctorName;
                    document.getElementById('chatPartnerStatus').textContent = "Waiting for Doctor to Accept...";
                    document.getElementById('chatPartnerStatus').className = "px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-[10px] font-bold uppercase tracking-wider animate-pulse";
                    document.getElementById('escalateBtnWrapper').classList.add('hidden');

                    if (consultationConnection) {
                        await consultationConnection.invoke('JoinConsultation', activeConsultationId.toString());
                    }

                    // Notice: Timer will start strictly upon doctor acceptance via SignalR TimerStarted event
                    appendChatMessage('doctor', `Request sent to Dr. ${doctorName}. Please wait while the doctor accepts the call on their screen. Your billing timer will NOT start until acceptance.`, 'System');
                } else {
                    alert(data.message || 'Consultation request failed');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function endCurrentConsultation() {
            if (!activeConsultationId) return;
            if (!confirm("Are you sure you want to end this video consultation and settle bill?")) return;

            cleanupVideoSession();
            if (consultationConnection) {
                await consultationConnection.invoke('EndSession', activeConsultationId);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initConsultationHub();
            if (window.lucide) lucide.createIcons();

            const urlParams = new URLSearchParams(window.location.search);
            const q = urlParams.get('q');
            const docUnavailable = urlParams.get('doc_unavailable') === '1';

            if (q && q.trim()) {
                handleIncomingSearchQuery(q.trim(), docUnavailable);
            }
        });
    </script>
}

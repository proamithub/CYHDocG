                stream.insertAdjacentHTML('beforeend', alertHtml);
                stream.scrollTop = stream.scrollHeight;
                if (window.lucide) lucide.createIcons();
            }

            const indicatorId = 'aiTyping_' + Date.now();
            appendTypingIndicator(indicatorId);

            // Record user turn in chat history
            chatHistory.push({ role: 'user', content: query });
            if (chatHistory.length > 10) chatHistory.shift();

            try {
                const res = await fetch('/Search/Triage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        query: query,
                        history: chatHistory.slice(-6)
                    })
                });
                const data = await res.json();
                removeTypingIndicator(indicatorId);
                if (data.isMedical && (data.aiAdviceEn || data.aiAdvice)) {
                    chatHistory.push({ role: 'model', content: data.aiAdviceEn || data.aiAdvice });
                    if (chatHistory.length > 10) chatHistory.shift();
                }
                renderAiResponse(data, query);
            } catch (err) {
                console.error(err);
                removeTypingIndicator(indicatorId);
                appendChatMessage('ai', 'Sorry, unable to connect to the AI service. Please try again.', 'CYH Health AI');
            }
        }

        async function handleUserChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('userChatInput');
            const message = input.value.trim();
            if (!message) return;

            appendChatMessage('me', message, 'You');
            input.value = '';

            if (activeConsultationId && consultationConnection) {
                await consultationConnection.invoke('SendMessage', activeConsultationId, message, currentUserRole);
            } else {
                const indicatorId = 'aiTyping_' + Date.now();
                appendTypingIndicator(indicatorId);

                // Record user turn in chat history
                chatHistory.push({ role: 'user', content: message });
                if (chatHistory.length > 10) chatHistory.shift();

                try {

@model List<CYHDocG.Repo.DTOs.DoctorSearchDto>
@{
    ViewData["Title"] = "AI Triage & Live Doctor Consultation";
    bool isAuth = ViewBag.IsAuthenticated ?? false;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<!-- LiveKit Real-Time WebRTC SDK -->
<script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>

<div class="min-h-[calc(100vh-80px)] bg-slate-950 py-4 sm:py-6 px-3 sm:px-6 lg:px-8 flex justify-center items-center">
    <div class="w-full max-w-5xl bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[85vh]">
        
        <!-- ===================== CHAT TOP BAR ===================== -->
        <div class="p-3 sm:p-4 border-b border-slate-800 bg-slate-900/95 backdrop-blur-md flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div id="chatAvatar" class="w-10 h-10 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold">
                    <i data-lucide="bot" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 id="chatPartnerName" class="font-heading font-bold text-sm sm:text-base text-white">CYH Health AI Assistant</h3>
                        <span id="chatPartnerStatus" class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold uppercase tracking-wider">AI Triage</span>
                    </div>
                    <p id="chatPartnerDesc" class="text-xs text-slate-400">Ask symptoms or escalate to live doctor</p>
                </div>
            </div>

            <!-- Dual Synchronized Timer Box (Shows when doctor joins) -->
            <div id="consultationTimerContainer" class="hidden flex items-center gap-3 bg-slate-950 px-3.5 py-1.5 rounded-2xl border border-red-500/30">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                    <span id="consultationClock" class="font-mono font-bold text-sm sm:text-base text-white">00:00:00</span>
                </div>
                <div class="h-5 w-px bg-slate-800"></div>
                <div class="text-right">
                    <div id="consultationAccruedBill" class="text-xs font-bold text-emerald-400">₹0.00</div>
                    <span class="text-[9px] text-slate-400">Live Accrued</span>
                </div>
                <button type="button" onclick="endCurrentConsultation()" class="ml-1 px-3 py-1 bg-red-600/30 hover:bg-red-600 text-red-300 hover:text-white rounded-xl text-xs font-semibold transition-all">
                    End Call
                </button>
            </div>

            <!-- Escalation & Video Call Buttons -->
            <div id="escalateBtnWrapper" class="flex items-center gap-2">
                @if (Model != null && Model.Any(d => d.IsLive))
                {
                    <a href="/LiveDoctor" class="px-3 py-1.5 rounded-xl bg-red-600/30 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/40 text-xs font-bold flex items-center gap-1.5 shadow animate-pulse transition-all">
                        <span class="w-2 h-2 rounded-full bg-red-500"></span>
                        <span>Doctor Live Now</span>
                    </a>
                }
                <button type="button" onclick="openDoctorSelectModal()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold text-xs shadow-md shadow-red-600/20 flex items-center gap-1.5 active:scale-95 transition-all">
                    <i data-lucide="video" class="w-3.5 h-3.5"></i>
                    <span>Connect Live Doctor</span>
                </button>
            </div>
        </div>

        <!-- ===================== LIVEKIT TWO-WAY VIDEO STAGE (Collapsible) ===================== -->
        <div id="videoStageContainer" class="hidden border-b border-slate-800 bg-black relative flex-shrink-0 h-64 sm:h-80 md:h-96 transition-all">
            <!-- Remote Doctor Video Feed -->
            <div class="w-full h-full relative overflow-hidden flex items-center justify-center bg-slate-950">
                <video id="remoteDoctorVideo" autoplay playsinline class="w-full h-full object-cover"></video>
                
                <!-- Waiting placeholder if remote video not yet attached -->
                <div id="remoteVideoPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-center p-4 bg-slate-950">
                    <div class="w-16 h-16 rounded-full bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center mb-3 animate-pulse">
                        <i data-lucide="stethoscope" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-white font-heading font-bold text-sm sm:text-base">Connecting Video Stream...</h4>
                    <p class="text-xs text-slate-400 mt-1">Establishing encrypted WebRTC channel via LiveKit Cloud</p>
                </div>

                <!-- Video HUD Overlay -->
                <div class="absolute top-3 left-3 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 flex items-center gap-2 z-10">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="videoDoctorName" class="text-xs font-semibold text-white">Live Doctor Video</span>
                </div>
            </div>

            <!-- Local Patient Picture-in-Picture (PIP) Self Video -->
            <div class="absolute bottom-4 right-4 w-28 h-20 sm:w-36 sm:h-28 rounded-2xl overflow-hidden border-2 border-white/20 shadow-2xl bg-slate-900 z-20">
                <video id="localPatientVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>
                <div class="absolute bottom-1 left-1 bg-black/70 px-1.5 py-0.5 rounded text-[9px] text-white font-medium">You</div>
            </div>

            <!-- In-Call Media Controls Bar -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 rounded-2xl px-3 py-2 flex items-center gap-2.5 z-30 shadow-2xl">
                <button type="button" id="btnToggleMic" onclick="toggleMicrophone()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all">
                    <i data-lucide="mic" id="iconMic" class="w-4 h-4"></i>
                </button>
                <button type="button" id="btnToggleCam" onclick="toggleCamera()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all">
                    <i data-lucide="video" id="iconCam" class="w-4 h-4"></i>
                </button>
                <button type="button" onclick="toggleVideoStageSize()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all">
                    <i data-lucide="maximize-2" class="w-4 h-4"></i>
                </button>
                <button type="button" onclick="endCurrentConsultation()" class="px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs flex items-center gap-1.5 shadow-lg shadow-red-600/40 transition-all">
                    <i data-lucide="phone-off" class="w-3.5 h-3.5"></i>
                    <span>Leave</span>
                </button>
            </div>
        </div>

        <!-- ===================== MESSAGE STREAM CONTAINER ===================== -->
        <div id="messageStream" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 no-scrollbar">
            <!-- Initial AI Greeting -->
            <div class="flex items-start gap-3 max-w-xl">
                <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i data-lucide="bot" class="w-4 h-4"></i>
                </div>
                <div class="bg-slate-800/90 border border-slate-700/60 rounded-2xl p-4 text-xs sm:text-sm text-slate-200 leading-relaxed shadow">
                    Namaste! 🙏 I am your <strong>CYHDoc AI Health Assistant</strong>.<br />
                    Please tell me what symptoms or health questions you have today (e.g. fever, headache, chest tightness, dosage inquiry). If needed, I will immediately escalate your request to an available live specialist doctor with 2-way HD Video Consultation.
                </div>
            </div>
        </div>

        <!-- ===================== QUICK PROMPTS CHIPS ===================== -->
        <div class="px-4 sm:px-6 py-2 border-t border-slate-800/60 flex items-center gap-2 overflow-x-auto no-scrollbar">
            <span class="text-[11px] text-slate-400 flex-shrink-0">Quick Ask:</span>
            <button onclick="sendQuickPrompt('I have fever and severe headache since 2 days')" class="px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 flex-shrink-0 transition-colors">Fever & Headache</button>
            <button onclick="sendQuickPrompt('Chest tightness and heart palpitation')" class="px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 flex-shrink-0 transition-colors">Chest Tightness</button>
            <button onclick="sendQuickPrompt('Skin itching and red allergy spots')" class="px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 flex-shrink-0 transition-colors">Skin Allergy</button>
            <button onclick="sendQuickPrompt('Need antibiotic prescription dosage guidance')" class="px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 flex-shrink-0 transition-colors">Medicine Dosage</button>
        </div>

        <!-- ===================== CHAT INPUT BAR ===================== -->
        <div class="p-3 sm:p-4 bg-slate-900 border-t border-slate-800">
            <form onsubmit="handleUserChatSubmit(event); return false;" class="relative flex items-center gap-2">
                <input type="text" id="userChatInput" placeholder="Type your health query or symptoms..." 
                       class="w-full pl-4 pr-12 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs sm:text-sm placeholder-slate-400 outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-all" />
                <button type="submit" class="absolute right-2 w-9 h-9 bg-red-600 hover:bg-red-700 text-white rounded-xl flex items-center justify-center transition-all shadow-md shadow-red-600/30 active:scale-95">
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ===================== FLOATING AI TOAST CONTAINER ===================== -->
<div id="aiToastContainer" class="fixed top-24 right-4 z-[999] pointer-events-none flex flex-col gap-2 max-w-sm sm:max-w-md w-full px-4"></div>

<!-- ===================== SELECT DOCTOR MODAL ===================== -->
<div id="doctorSelectModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-lg w-full shadow-2xl relative">
        <button onclick="closeDoctorSelectModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
        <div class="mb-4">
            <h3 class="font-heading font-bold text-lg text-white">Select Live Doctor for Video Consultation</h3>
            <p class="text-xs text-slate-400 mt-0.5">Two-way encrypted HD video room will be launched immediately.</p>
        </div>

        <div class="space-y-3 max-h-80 overflow-y-auto no-scrollbar">
            @if (Model != null && Model.Any())
            {
                foreach (var doc in Model)
                {
                    <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex items-center justify-between gap-3 hover:border-red-500/50 transition-all">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center font-bold text-xs">
                                Dr
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="font-heading font-bold text-sm text-white">@doc.DoctorName</h4>
                                    @if (doc.IsLive)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-red-600 text-[10px] font-black uppercase text-white animate-pulse flex items-center gap-1">
                                            <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
                                        </span>
                                    }
                                </div>
                                <span class="text-[11px] text-slate-400">@doc.Specialty • @doc.Department</span>
                                <div class="text-[10px] text-emerald-400 font-semibold mt-0.5">
                                    @(doc.IsFreeConsultation ? "FREE Consultation" : $"₹{doc.ConsultationFeePerMinute:N0}/min")
                                </div>
                            </div>
                        </div>
                        <button type="button" onclick="requestDoctorConsultation(@doc.DoctorId, '@doc.DoctorName', @doc.ConsultationFeePerMinute, @(doc.IsFreeConsultation ? "false" : "true"))" 
                                class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold shadow-md shadow-red-600/30 transition-all active:scale-95 flex items-center gap-1.5">
                            <i data-lucide="video" class="w-3.5 h-3.5"></i>
                            <span>Call</span>
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-6 text-slate-400 text-xs">
                    No specialist doctors online right now. You can continue with AI chat.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/live-timer.js" asp-append-version="true"></script>
    <script>
        const isUserAuth = @(isAuth ? "true" : "false");
        const currentUserRole = "@(ViewBag.UserRole ?? "User")";
        let activeConsultationId = @(ViewBag.ConsultationId ?? "null");
        let activeDoctorName = "@(ViewBag.DoctorName ?? "Specialist")";
        let activePatientName = "@(ViewBag.PatientName ?? "Patient")";
        let consultationConnection = null;
        let livekitRoom = null;
        let isMicMuted = false;
        let isCamOff = false;
        let localStreamFallback = null;

        // 1. Initialize SignalR for 1-to-1 Consultation Synchronization
        function initConsultationHub() {
            consultationConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/consultation')
                .withAutomaticReconnect()
                .build();

            // Receive message from the other party in this consultation
            consultationConnection.on('ReceiveConsultationMessage', function (payload) {
                const isDoc = payload.SenderRole === 'Doctor';
                const label = isDoc ? `Dr. ${activeDoctorName}` : activePatientName;
                appendChatMessage(isDoc ? 'doctor' : 'user', payload.MessageText, label);
            });

            // Timer starts ONLY when doctor accepts
            consultationConnection.on('TimerStarted', function (timerData) {
                console.log('[LiveChat] Doctor accepted call! Starting synchronized timer:', timerData);
                document.getElementById('chatPartnerStatus').textContent = "1-to-1 Live Video";
                document.getElementById('chatPartnerStatus').className = "px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold uppercase tracking-wider";
                
                startSynchronizedTimer(timerData.startedAt, timerData.ratePerMinute || pendingRate, timerData.isPaid !== undefined ? timerData.isPaid : pendingIsPaid);
                startLiveKitVideoConsultation(activeConsultationId, activeDoctorName);
                appendChatMessage('doctor', `Namaste! Video consultation is now active. Dr. ${activeDoctorName} is ready to consult.`, `Dr. ${activeDoctorName}`);
            });

            consultationConnection.on('ConsultationEnded', function (endData) {
                cleanupVideoSession();
                stopSynchronizedTimer();
                alert(`Consultation completed! Total Duration: ${Math.ceil(endData.durationSeconds / 60)} mins. Billed: ₹${endData.billedAmount}`);
                window.location.reload();
            });

            consultationConnection.start().then(async () => {
                if (activeConsultationId) {
                    await consultationConnection.invoke('JoinConsultation', activeConsultationId.toString());
                    @if (ViewBag.ActiveConsultation != null)
                    {
                        <text>
                        const startedAtVal = "@ViewBag.StartedAt";
                        const rateVal = @(ViewBag.RatePerMinute ?? 0);
                        const isPaidVal = @(ViewBag.IsPaid == true ? "true" : "false");

                        document.getElementById('chatPartnerName').textContent = currentUserRole === "Doctor" ? activePatientName : `Dr. ${activeDoctorName}`;
                        document.getElementById('chatPartnerStatus').textContent = "1-to-1 Live Video Active";
                        document.getElementById('chatPartnerStatus').className = "px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold uppercase tracking-wider";
                        document.getElementById('escalateBtnWrapper').classList.add('hidden');

                        if (startedAtVal) {
                            startSynchronizedTimer(startedAtVal, rateVal, isPaidVal);
                        }
                        await startLiveKitVideoConsultation(activeConsultationId, activeDoctorName);
                        </text>
                    }
                }
            }).catch(err => console.error("SignalR Connection Error: ", err));
        }

        // 2. Start LiveKit Video Consultation
        async function startLiveKitVideoConsultation(consultationId, doctorName) {
            const stage = document.getElementById('videoStageContainer');
            stage.classList.remove('hidden');
            document.getElementById('videoDoctorName').textContent = `Dr. ${doctorName}`;

            try {
                // Fetch dynamic LiveKit Token from backend (configured via appsettings.json)
                const res = await fetch('/api/consultation/video-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ consultationId: consultationId })
                });

                const data = await res.json();
                if (!data.success || !data.token) {
                    throw new Error("Unable to obtain video token");
                }

                if (window.LivekitClient && data.serverUrl) {
                    // Initialize official LiveKit Room
                    livekitRoom = new LivekitClient.Room({
                        adaptiveStream: true,
                        dynacast: true
                    });

                    // Handle Remote Video/Audio Track Subscribed
                    livekitRoom.on(LivekitClient.RoomEvent.TrackSubscribed, (track, publication, participant) => {
                        if (track.kind === LivekitClient.Track.Kind.Video) {
                            const remoteVid = document.getElementById('remoteDoctorVideo');
                            track.attach(remoteVid);
                            document.getElementById('remoteVideoPlaceholder').classList.add('hidden');
                        }
                    });

                    // Connect to LiveKit WebSocket Server
                    await livekitRoom.connect(data.serverUrl, data.token);

                    // Publish Local Camera and Mic
                    await livekitRoom.localParticipant.enableCameraAndMicrophone();

                    // Attach local video track to self PIP
                    const localVideoTrack = Array.from(livekitRoom.localParticipant.videoTrackPublications.values())[0]?.track;
                    if (localVideoTrack) {
                        localVideoTrack.attach(document.getElementById('localPatientVideo'));
                    }
                } else {
                    // Fallback to standard browser WebRTC media stream
                    await startLocalMediaFallback();
                }
            } catch (err) {
                console.warn("LiveKit connection notice, running local camera preview fallback: ", err);
                await startLocalMediaFallback();
            }
        }

        // 3. Fallback Camera Preview
        async function startLocalMediaFallback() {
            try {
                localStreamFallback = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                const localVid = document.getElementById('localPatientVideo');
                localVid.srcObject = localStreamFallback;
                localVid.play();
                document.getElementById('remoteVideoPlaceholder').innerHTML = `
                    <div class="w-16 h-16 rounded-full bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center mb-3">
                        <i data-lucide="video" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-white font-heading font-bold text-sm sm:text-base">Video Room Live</h4>
                    <p class="text-xs text-slate-400 mt-1">Waiting for doctor stream to join...</p>
                `;
                lucide.createIcons();
            } catch (e) {
                console.error("Camera access error: ", e);
            }
        }

        // 4. In-Call Media Controls
        function toggleMicrophone() {
            isMicMuted = !isMicMuted;
            if (livekitRoom?.localParticipant) {
                livekitRoom.localParticipant.setMicrophoneEnabled(!isMicMuted);
            }
            if (localStreamFallback) {
                localStreamFallback.getAudioTracks().forEach(t => t.enabled = !isMicMuted);
            }
            document.getElementById('btnToggleMic').className = isMicMuted 
                ? "w-9 h-9 rounded-xl bg-red-600 text-white flex items-center justify-center transition-all"
                : "w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all";
        }

        function toggleCamera() {
            isCamOff = !isCamOff;
            if (livekitRoom?.localParticipant) {
                livekitRoom.localParticipant.setCameraEnabled(!isCamOff);
            }
            if (localStreamFallback) {
                localStreamFallback.getVideoTracks().forEach(t => t.enabled = !isCamOff);
            }
            document.getElementById('btnToggleCam').className = isCamOff 
                ? "w-9 h-9 rounded-xl bg-red-600 text-white flex items-center justify-center transition-all"
                : "w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition-all";
        }

        function toggleVideoStageSize() {
            const stage = document.getElementById('videoStageContainer');
            if (stage.classList.contains('h-64') || stage.classList.contains('h-80') || stage.classList.contains('h-96')) {
                stage.classList.remove('h-64', 'sm:h-80', 'md:h-96');
                stage.classList.add('h-[60vh]');
            } else {
                stage.classList.remove('h-[60vh]');
                stage.classList.add('h-64', 'sm:h-80', 'md:h-96');
            }
        }

        function cleanupVideoSession() {
            if (livekitRoom) {
                livekitRoom.disconnect();
                livekitRoom = null;
            }
            if (localStreamFallback) {
                localStreamFallback.getTracks().forEach(t => t.stop());
                localStreamFallback = null;
            }
            document.getElementById('videoStageContainer').classList.add('hidden');
        }

        function escapeHtml(text) {
            if (!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.toString().replace(/[&<>"']/g, m => map[m]);
        }

        function appendTypingIndicator(id) {
            const stream = document.getElementById('messageStream');
            const html = `
            <div id="${id}" class="flex items-start gap-3 max-w-xl">
                <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 text-xs font-bold font-heading">
                    AI
                </div>
                <div class="bg-slate-800/90 border border-slate-700/60 rounded-2xl rounded-tl-sm p-3.5 text-xs text-slate-300 flex items-center gap-2.5 shadow">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>AI Clinical Assistant (Gemini AI) is analyzing your symptoms...</span>
                </div>
            </div>`;
            stream.insertAdjacentHTML('beforeend', html);
            stream.scrollTop = stream.scrollHeight;
            if (window.lucide) lucide.createIcons();
        }

        let nonMedicalAttemptsCount = 0;
        let chatHistory = [];

        function removeTypingIndicator(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function showNonMedicalToast(message) {
            const container = document.getElementById('aiToastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto bg-slate-900/95 border border-amber-500/50 text-white rounded-2xl p-4 shadow-2xl backdrop-blur-md flex items-start gap-3 transition-all duration-300 transform -translate-y-2 opacity-0';
            toast.innerHTML = `
                <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i data-lucide="alert-circle" class="w-4 h-4"></i>
                </div>
                <div class="flex-1 text-xs">
                    <div class="font-bold text-amber-400 mb-0.5">Medical & Health Queries Only</div>
                    <div class="text-slate-200 leading-relaxed">${escapeHtml(message)}</div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white p-1">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            `;
            container.appendChild(toast);
            if (window.lucide) lucide.createIcons();

            requestAnimationFrame(() => {
                toast.classList.remove('-translate-y-2', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            });

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function showNonMedicalPolicyAlert(count) {
            const stream = document.getElementById('messageStream');

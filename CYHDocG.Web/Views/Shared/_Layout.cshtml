<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CYHDocGuru | Expert Healthcare & Cardiology Services</title>
    <meta name="description" content="CYHDocGuru - Comprehensive medical consultations, cardiology specialists, diagnostics, preventive care, and personalized health treatment." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme Styles -->
    <link rel="stylesheet" href="~/theme/assets/aos.css" />
    <link rel="stylesheet" href="~/theme/assets/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/theme/assets/output.css" asp-append-version="true" />
    <link rel="icon" href="~/theme/assets/heart.png" type="image/x-icon" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="~/theme/assets/aos.js"></script>
</head>
<body class="font-body text-slate-800 bg-slate-50">

    <!-- ===================== PRELOADER ===================== -->
    <div id="preloader">
        <div class="flex flex-col items-center gap-6">
            <!-- Animated Heart Icon -->
            <svg width="56" height="56" viewBox="0 0 84 84" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path id="heart-path" d="M36 62s-28-18-28-36a16 16 0 0132 0 16 16 0 0132 0c0 18-28 36-28 36z" fill="#DC2626"
                      style="animation: heartbeat 1.4s ease-in-out infinite;">
                </path>
            </svg>

            <!-- ECG Animated Pulse Line -->
            <svg class="ecg-line" viewBox="0 0 260 60">
                <path class="ecg-path"
                      d="M0,30 L40,30 L50,30 L55,10 L60,50 L65,5 L72,55 L78,30 L120,30 L130,30 L135,10 L140,50 L145,5 L152,55 L158,30 L200,30 L210,30 L215,10 L220,50 L225,5 L232,55 L238,30 L260,30" />
            </svg>

            <div class="text-white font-heading text-2xl font-bold tracking-wide mt-2">CYHDocGuru</div>
            <div class="text-slate-400 text-sm">Empowering Your Health & Wellness...</div>
        </div>
    </div>

    <!-- ===================== TOP BAR ===================== -->
    <div class="topbar py-2 text-white text-sm bg-slate-900 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
                <div class="flex items-center gap-6">
                    <span class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                        <strong class="text-red-400">24/7 Helpline:</strong>
                        <a href="tel:+18003624878" class="hover:text-red-300 transition-colors">+1 (800) DOC-GURU</a>
                    </span>
                    <span class="hidden md:flex items-center gap-2 text-slate-400">
                        <span>|</span>
                        <a href="mailto:care@cyhdocguru.com" class="hover:text-white transition-colors">care@cyhdocguru.com</a>
                    </span>
                </div>
                <div class="flex items-center gap-4 text-slate-400 text-xs">
                    <span>Mon–Sat: 8:00 AM – 8:00 PM</span>
                    <span>|</span>
                    <span class="text-green-400 font-medium">Emergency Care: 24/7</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== NAVBAR ===================== -->
    <nav id="navbar" class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-18">
                <!-- Brand Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <div class="w-10 h-10 bg-red-600 rounded-xl flex items-center justify-center shadow-lg shadow-red-600/30">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
                            <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" />
                        </svg>
                    </div>
                    <div>
                        <div class="font-heading font-extrabold text-xl leading-tight text-white">CYH<span class="text-red-500">DocGuru</span></div>
                        <div class="text-[11px] text-slate-400 leading-none tracking-wide">Healthcare & Cardiology</div>
                    </div>
                </a>

                <!-- Desktop Nav -->
                <div class="hidden lg:flex items-center gap-7">
                    <a href="#home" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">Home</a>
                    <a href="#about" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">About</a>
                    <a href="#services" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">Services</a>
                    <a href="#departments" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">Departments</a>
                    <a href="#testimonials" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">Reviews</a>
                    <a href="#faq" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">FAQ</a>
                    <a href="#contact" class="nav-link text-sm font-medium text-slate-200 hover:text-white transition-colors">Contact</a>
                </div>

                <!-- Right Action Button -->
                <div class="flex items-center gap-3">
                    <a href="#appointments" class="hidden lg:inline-flex btn-primary text-sm py-2.5 px-5 rounded-lg">
                        <i data-lucide="calendar" class="w-4 h-4"></i>
                        Book Appointment
                    </a>
                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-btn" aria-label="Toggle Navigation" class="lg:hidden p-2 text-slate-300 hover:text-white focus:outline-none">
                        <i data-lucide="menu" class="w-6 h-6" id="menu-open"></i>
                        <i data-lucide="x" class="w-6 h-6 hidden" id="menu-close"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-white/10 px-4 py-4">
            <div class="flex flex-col gap-2">
                <a href="#home" class="text-slate-200 hover:text-white py-2 text-sm font-medium">Home</a>
                <a href="#about" class="text-slate-200 hover:text-white py-2 text-sm font-medium">About CYHDocGuru</a>
                <a href="#services" class="text-slate-200 hover:text-white py-2 text-sm font-medium">Services</a>
                <a href="#departments" class="text-slate-200 hover:text-white py-2 text-sm font-medium">Departments</a>
                <a href="#testimonials" class="text-slate-200 hover:text-white py-2 text-sm font-medium">Patient Reviews</a>
                <a href="#faq" class="text-slate-200 hover:text-white py-2 text-sm font-medium">FAQ</a>
                <a href="#contact" class="text-slate-200 hover:text-white py-2 text-sm font-medium">Contact</a>
                <a href="#appointments" class="btn-primary mt-2 w-full justify-center text-center py-2.5">Book Appointment</a>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ===================== FOOTER ===================== -->
    <div style="background: linear-gradient(90deg, #7f1d1d 0%, #DC2626 50%, #7f1d1d 100%);" class="py-5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white/15 rounded-full flex items-center justify-center flex-shrink-0 animate-pulse">
                        <i data-lucide="phone-call" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <div class="font-heading font-bold text-white text-lg">Cardiac & Medical Emergency? Call Right Now</div>
                        <div class="text-red-100 text-sm">24/7 dedicated emergency response team ready to assist you.</div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="tel:+18003624878" class="bg-white text-red-700 font-heading font-bold px-6 py-2.5 rounded-lg hover:bg-red-50 transition-all text-sm flex items-center gap-2 shadow-lg">
                        <i data-lucide="phone" class="w-4 h-4"></i> +1 (800) DOC-GURU
                    </a>
                    <a href="#appointments" class="bg-white/15 border border-white/30 text-white font-heading font-semibold px-6 py-2.5 rounded-lg hover:bg-white/25 transition-all text-sm flex items-center gap-2">
                        <i data-lucide="calendar" class="w-4 h-4"></i> Schedule Visit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-slate-900 text-white overflow-hidden relative border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
                <!-- Col 1: About CYHDocGuru -->
                <div>
                    <div class="flex items-center gap-2.5 mb-4">
                        <div class="w-10 h-10 bg-red-600 rounded-xl flex items-center justify-center shadow-lg">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
                                <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" />
                            </svg>
                        </div>
                        <div>
                            <div class="font-heading font-extrabold text-xl leading-tight text-white">CYH<span class="text-red-500">DocGuru</span></div>
                            <div class="text-xs text-slate-400">Heart & Healthcare Specialists</div>
                        </div>
                    </div>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        CYHDocGuru brings world-class medical excellence, experienced cardiologists, state-of-the-art diagnostic labs, and dedicated patient care together under one roof.
                    </p>
                    <div class="flex items-center gap-3">
                        <a href="#" class="w-9 h-9 bg-white/10 rounded-full flex items-center justify-center hover:bg-red-600 transition-colors">
                            <i data-lucide="activity" class="w-4 h-4 text-white"></i>
                        </a>
                        <a href="#" class="w-9 h-9 bg-white/10 rounded-full flex items-center justify-center hover:bg-blue-600 transition-colors">
                            <i data-lucide="shield-check" class="w-4 h-4 text-white"></i>
                        </a>
                        <a href="#" class="w-9 h-9 bg-white/10 rounded-full flex items-center justify-center hover:bg-green-600 transition-colors">
                            <i data-lucide="heart" class="w-4 h-4 text-white"></i>
                        </a>
                    </div>
                </div>

                <!-- Col 2: Services -->
                <div>
                    <h4 class="font-heading font-semibold text-white text-base mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-4 bg-red-600 rounded-full inline-block"></span>
                        Medical Services
                    </h4>
                    <ul class="space-y-2.5 text-sm text-slate-400">
                        <li><a href="#services" class="hover:text-red-400 transition-colors">Cardiac Consultations</a></li>
                        <li><a href="#services" class="hover:text-red-400 transition-colors">ECG & Diagnostics</a></li>
                        <li><a href="#services" class="hover:text-red-400 transition-colors">Hypertension Management</a></li>
                        <li><a href="#services" class="hover:text-red-400 transition-colors">Cardiac Rehabilitation</a></li>
                        <li><a href="#services" class="hover:text-red-400 transition-colors">Preventive Cardiology</a></li>
                        <li><a href="#services" class="hover:text-red-400 transition-colors">Emergency Cardiac Support</a></li>
                    </ul>
                </div>

                <!-- Col 3: Quick Links & Hours -->
                <div>
                    <h4 class="font-heading font-semibold text-white text-base mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-4 bg-blue-500 rounded-full inline-block"></span>
                        Working Hours
                    </h4>
                    <ul class="space-y-2 text-sm text-slate-400 mb-4">
                        <li class="flex justify-between"><span>Mon – Fri:</span> <span class="text-slate-200">8:00 AM – 8:00 PM</span></li>
                        <li class="flex justify-between"><span>Saturday:</span> <span class="text-slate-200">9:00 AM – 5:00 PM</span></li>
                        <li class="flex justify-between"><span>Sunday:</span> <span class="text-red-400 font-semibold">24/7 Emergency</span></li>
                    </ul>
                    <div class="bg-green-500/10 border border-green-500/30 rounded-lg px-3 py-2 flex items-center gap-2">
                        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                        <span class="text-green-400 text-xs font-semibold">Clinic is Currently Open</span>
                    </div>
                </div>

                <!-- Col 4: Contact Us -->
                <div>
                    <h4 class="font-heading font-semibold text-white text-base mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-4 bg-yellow-500 rounded-full inline-block"></span>
                        Contact Information
                    </h4>
                    <ul class="space-y-3 text-sm text-slate-400">
                        <li class="flex items-start gap-3">
                            <i data-lucide="map-pin" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5"></i>
                            <span>123 Medical Health Plaza, Suite 400, Healthcare District</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i data-lucide="phone" class="w-5 h-5 text-red-500 flex-shrink-0"></i>
                            <a href="tel:+18003624878" class="hover:text-white transition-colors">+1 (800) DOC-GURU</a>
                        </li>
                        <li class="flex items-center gap-3">
                            <i data-lucide="mail" class="w-5 h-5 text-red-500 flex-shrink-0"></i>
                            <a href="mailto:care@cyhdocguru.com" class="hover:text-white transition-colors">care@cyhdocguru.com</a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Copyright Bar -->
            <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
                <div>
                    &copy; 2026 <strong class="text-white">CYHDocGuru</strong>. All rights reserved. Designed for healthcare & medical professionals.
                </div>
                <div class="flex flex-wrap gap-4">
                    <a href="#about" class="hover:text-white transition-colors">About</a>
                    <a href="#services" class="hover:text-white transition-colors">Services</a>
                    <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-white transition-colors">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===================== SCROLL TO TOP ===================== -->
    <button id="scroll-top" aria-label="Scroll to top">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" fill="white" stroke="none" />
        </svg>
    </button>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-20 right-4 bg-green-600 text-white px-5 py-3 rounded-lg shadow-lg font-medium text-sm translate-x-full opacity-0 transition-all duration-300 z-[200] flex items-center gap-2">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span id="toast-msg">Appointment request submitted successfully!</span>
    </div>

    <!-- Scripts -->
    <script src="~/theme/assets/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

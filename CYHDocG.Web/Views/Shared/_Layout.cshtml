@inject ISettingsRepository SettingsRepo
@{
    var antiInspectSetting = await SettingsRepo.GetSettingByKeyAsync("AntiInspectEnabled");
    bool isAntiInspect = antiInspectSetting == null || (antiInspectSetting.IsActive && antiInspectSetting.SettingValue == "1");
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="anti-inspect-enabled" content="@(isAntiInspect ? "true" : "false")" />
    <title>@ViewData["Title"] - CYHDocGuru | Expert Healthcare & Cardiology Services</title>
    <meta name="description" content="CYHDocGuru - Comprehensive medical consultations, cardiology specialists, diagnostics, preventive care, and personalized health treatment." />

    <!-- Performance Hints: Preconnect & DNS-Prefetch CDN hosts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    <link rel="dns-prefetch" href="https://unpkg.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme Styles -->
    <link rel="stylesheet" href="~/theme/assets/aos.css" />
    <link rel="stylesheet" href="~/theme/assets/style.css" asp-append-version="true" />
    <link rel="icon" href="~/theme/assets/stethoscope.svg" type="image/svg+xml" />

    <!-- Tailwind CSS Play Engine -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#dc2626',
                        secondary: '#0f172a',
                        accent: '#0ea5e9'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
</head>
<body class="font-body text-slate-800 bg-slate-50">

    <!-- ===================== PRELOADER ===================== -->
    <div id="preloader">
        <div class="flex flex-col items-center gap-6">
            <!-- Animated Stethoscope Brand Icon -->
            <div class="relative flex items-center justify-center">
                <div class="absolute -inset-3 bg-red-600/30 rounded-3xl blur-xl animate-pulse"></div>
                <div class="relative w-16 h-16 bg-gradient-to-tr from-red-600 to-rose-500 rounded-2xl flex items-center justify-center shadow-2xl shadow-red-600/40"
                     style="animation: heartbeat 1.4s ease-in-out infinite;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="7" cy="5" r="1.5" fill="white" stroke="none" />
                        <circle cx="13" cy="5" r="1.5" fill="white" stroke="none" />
                        <path d="M7 6.5 C7 9.5 8.5 12 10 12 C11.5 12 13 9.5 13 6.5" />
                        <path d="M10 12 v2.5 C10 18.5 13.5 21 16.5 19.5 C18 18.8 18.5 17 18.5 15 v-1.5" />
                        <circle cx="18.5" cy="11.5" r="2.8" stroke-width="2" fill="white" fill-opacity="0.25" />
                        <circle cx="18.5" cy="11.5" r="1" fill="white" stroke="none" />
                    </svg>
                </div>
            </div>

            <!-- ECG Animated Pulse Line -->
            <svg class="ecg-line" viewBox="0 0 260 60">
                <path class="ecg-path"
                      d="M0,30 L40,30 L50,30 L55,10 L60,50 L65,5 L72,55 L78,30 L120,30 L130,30 L135,10 L140,50 L145,5 L152,55 L158,30 L200,30 L210,30 L215,10 L220,50 L225,5 L232,55 L238,30 L260,30" />
            </svg>

            <div class="text-white font-heading text-2xl font-bold tracking-wide mt-2">CYHDOC <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-rose-400">Guru JI</span></div>
            <div class="text-slate-400 text-sm">Empowering Your Health & Wellness...</div>
        </div>
    </div>

    <!-- ===================== NAVBAR ===================== -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-white/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                <!-- Brand Logo: CYHDOC Guru JI with stethoscope icon -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 sm:gap-3 group flex-shrink-0">
                    <div class="w-8 h-8 sm:w-11 sm:h-11 bg-gradient-to-tr from-red-600 to-rose-500 rounded-xl sm:rounded-2xl flex items-center justify-center shadow-lg shadow-red-600/30 group-hover:scale-105 transition-transform flex-shrink-0">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
                            <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
                            <circle cx="20" cy="10" r="2"/>
                        </svg>
                    </div>
                    <div class="flex flex-col justify-center">
                        <div class="font-heading font-black text-base sm:text-2xl tracking-tight text-white flex items-center gap-1 leading-none select-none">
                            <span>CYHDOC</span>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-rose-400">Guru JI</span>
                        </div>
                        <div class="hidden sm:block text-[10px] text-slate-400 font-medium tracking-wider uppercase leading-none mt-1" data-i18n="brand_subtitle">Smart Healthcare & Tele-Consultation</div>
                    </div>
                </a>

                <!-- Desktop Nav: Home, LIVE chat, LIVE DOCTOR -->
                <div class="hidden md:flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-slate-200 hover:text-white transition-colors relative py-1 hover:after:w-full after:w-0 after:h-0.5 after:bg-red-500 after:absolute after:bottom-0 after:left-0 after:transition-all" data-i18n="nav_home">Home</a>
                    <a asp-controller="LiveChat" asp-action="Index" class="text-sm font-semibold text-slate-200 hover:text-white transition-colors flex items-center gap-1.5 py-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span data-i18n="nav_live_chat">LIVE chat</span>
                    </a>
                    <a asp-controller="LiveDoctor" asp-action="Index" class="text-sm font-semibold text-slate-200 hover:text-white transition-colors flex items-center gap-1.5 py-1">
                        <span class="px-2 py-0.5 rounded-full bg-red-600/30 border border-red-500/50 text-red-400 text-[10px] font-bold uppercase tracking-wider animate-pulse">Reels</span>
                        <span data-i18n="nav_live_doctor">LIVE DOCTOR</span>
                    </a>
                </div>

                <!-- Right Controls: Language Dropdown + Auth / Profile Dropdown -->
                <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
                    <!-- Language Switcher Dropdown (desktop/tablet) -->
                    <div class="relative group hidden sm:block">
                        <button class="flex items-center gap-1.5 py-1.5 px-3 rounded-xl bg-slate-800/80 hover:bg-slate-800 text-slate-200 text-xs font-medium border border-white/10 transition-all outline-none">
                            <i data-lucide="languages" class="w-3.5 h-3.5 text-red-400"></i>
                            <span id="currentLangLabel">English</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
                        </button>
                        <div class="absolute right-0 mt-1 w-32 bg-slate-900 border border-slate-800 rounded-xl shadow-xl py-1 hidden group-hover:block z-50">
                            <button onclick="switchLanguage('en')" class="w-full text-left px-3.5 py-1.5 text-xs text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center justify-between">
                                English
                            </button>
                            <button onclick="switchLanguage('hi')" class="w-full text-left px-3.5 py-1.5 text-xs text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center justify-between">
                                हिंदी (Hindi)
                            </button>
                            <button onclick="switchLanguage('hinglish')" class="w-full text-left px-3.5 py-1.5 text-xs text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center justify-between">
                                Hinglish
                            </button>
                        </div>
                    </div>

                    <!-- Authentication Controls -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- User Profile Dropdown -->
                        <div class="relative group">
                            <button class="flex items-center gap-1.5 py-1.5 px-2.5 sm:px-3 rounded-xl bg-slate-800 border border-slate-700/80 text-white text-xs font-semibold hover:border-red-500/50 transition-all">
                                <div class="w-6 h-6 rounded-lg bg-red-600 flex items-center justify-center font-bold text-xs text-white">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <span class="hidden sm:inline max-w-[100px] truncate">@User.Identity.Name</span>
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
                            </button>
                            <div class="absolute right-0 mt-1 w-48 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl py-2 hidden group-hover:block z-50">
                                <div class="px-4 py-2 border-b border-slate-800">
                                    <p class="text-xs font-bold text-white truncate">@User.Identity.Name</p>
                                    <span class="text-[10px] text-red-400 font-medium">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </div>
                                @{
                                    string dashboardUrl = User.IsInRole("Admin") ? "/Admin/Dashboard" : (User.IsInRole("Doctor") ? "/Doctor/Dashboard" : "/User/Dashboard");
                                }
                                <a href="@dashboardUrl" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
                                    <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i>
                                    <span data-i18n="nav_profile">Dashboard</span>
                                </a>
                                <a asp-controller="Account" asp-action="ChangePassword" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
                                    <i data-lucide="key-round" class="w-3.5 h-3.5"></i>
                                    <span data-i18n="nav_password">Change Password</span>
                                </a>
                                <div class="border-t border-slate-800 my-1"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full flex items-center gap-2 px-2 py-1.5 text-xs text-red-400 hover:bg-red-500/10 rounded-lg transition-colors">
                                        <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                                        <span data-i18n="nav_logout">Logout</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Login / Sign In Button: Compact & perfectly styled on mobile -->
                        <a asp-controller="Account" asp-action="Login" class="py-1.5 px-3 sm:py-2 sm:px-4 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold text-xs sm:text-sm shadow-md shadow-red-600/30 active:scale-95 transition-all flex items-center gap-1.5 whitespace-nowrap">
                            <i data-lucide="log-in" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                            <span data-i18n="nav_login">Sign In</span>
                        </a>
                    }

                    <!-- Mobile Menu Button with Toggle Icons -->
                    <button id="mobile-menu-btn" type="button" aria-label="Toggle Navigation" class="md:hidden p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white border border-white/10 flex items-center justify-center active:scale-95 transition-all">
                        <i data-lucide="menu" id="menu-icon-open" class="w-5 h-5"></i>
                        <i data-lucide="x" id="menu-icon-close" class="w-5 h-5 hidden"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-t border-white/10 px-4 py-4 space-y-3 shadow-2xl">
            <div class="flex flex-col gap-2">
                <a asp-controller="Home" asp-action="Index" class="text-slate-200 hover:text-white py-2 text-sm font-medium flex items-center gap-2.5 rounded-lg px-2 hover:bg-slate-800" data-i18n="nav_home">
                    <i data-lucide="home" class="w-4 h-4 text-slate-400"></i> Home
                </a>
                <a asp-controller="LiveChat" asp-action="Index" class="text-slate-200 hover:text-white py-2 text-sm font-medium flex items-center gap-2.5 rounded-lg px-2 hover:bg-slate-800" data-i18n="nav_live_chat">
                    <i data-lucide="messages-square" class="w-4 h-4 text-emerald-400"></i> LIVE Chat
                </a>
                <a asp-controller="LiveDoctor" asp-action="Index" class="text-slate-200 hover:text-white py-2 text-sm font-medium flex items-center gap-2.5 rounded-lg px-2 hover:bg-slate-800" data-i18n="nav_live_doctor">
                    <i data-lucide="tv" class="w-4 h-4 text-red-500"></i> LIVE DOCTOR
                </a>
            </div>

            <!-- Mobile Language Switcher Buttons -->
            <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
                <span class="text-xs text-slate-400">Language:</span>
                <div class="flex items-center gap-1.5">
                    <button onclick="switchLanguage('en')" class="px-2.5 py-1 rounded-lg bg-slate-800 text-xs text-white border border-slate-700 hover:bg-slate-700">EN</button>
                    <button onclick="switchLanguage('hi')" class="px-2.5 py-1 rounded-lg bg-slate-800 text-xs text-white border border-slate-700 hover:bg-slate-700">हिंदी</button>
                    <button onclick="switchLanguage('hinglish')" class="px-2.5 py-1 rounded-lg bg-slate-800 text-xs text-white border border-slate-700 hover:bg-slate-700">Hinglish</button>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="pt-2 border-t border-slate-800">
                    <a asp-controller="Account" asp-action="Login" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-md">
                        <i data-lucide="log-in" class="w-4 h-4"></i>
                        <span data-i18n="nav_login">Sign In</span>
                    </a>
                </div>
            }
        </div>
    </nav>

    <!-- Main Content Area with top padding for fixed header -->
    <main role="main" class="pt-16 sm:pt-20">
        @RenderBody()
    </main>

    <!-- ===================== FOOTER ===================== -->
    <div style="background: linear-gradient(90deg, #7f1d1d 0%, #DC2626 50%, #7f1d1d 100%);" class="py-5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white/15 rounded-full flex items-center justify-center flex-shrink-0 animate-pulse">
                        <i data-lucide="phone-call" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <div class="font-heading font-bold text-white text-lg">Cardiac & Medical Emergency? Call Right Now</div>
                        <div class="text-red-100 text-sm">24/7 dedicated emergency response team ready to assist you.</div>
                    </div>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="tel:+18003624878" class="bg-white text-red-700 font-heading font-bold px-6 py-2.5 rounded-lg hover:bg-red-50 transition-all text-sm flex items-center gap-2 shadow-lg">
                        <i data-lucide="phone" class="w-4 h-4"></i> +1 (800) DOC-GURU
                    </a>
                    <a href="#appointments" class="bg-white/15 border border-white/30 text-white font-heading font-semibold px-6 py-2.5 rounded-lg hover:bg-white/25 transition-all text-sm flex items-center gap-2">
                        <i data-lucide="calendar" class="w-4 h-4"></i> Schedule Visit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-slate-900 text-white overflow-hidden relative border-t border-white/10 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Bottom Copyright Bar -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-gradient-to-tr from-red-600 to-rose-500 rounded-xl flex items-center justify-center shadow-lg shadow-red-600/30">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="7" cy="5" r="1.5" fill="white" stroke="none" />
                            <circle cx="13" cy="5" r="1.5" fill="white" stroke="none" />
                            <path d="M7 6.5 C7 9.5 8.5 12 10 12 C11.5 12 13 9.5 13 6.5" />
                            <path d="M10 12 v2.5 C10 18.5 13.5 21 16.5 19.5 C18 18.8 18.5 17 18.5 15 v-1.5" />
                            <circle cx="18.5" cy="11.5" r="2.8" stroke-width="2" fill="white" fill-opacity="0.25" />
                            <circle cx="18.5" cy="11.5" r="1" fill="white" stroke="none" />
                        </svg>
                    </div>
                    <span>&copy; 2026 <strong class="text-white">CYHDOC Guru JI</strong>. All rights reserved. Smart Tele-Healthcare & Online Consultation.</span>
                </div>
                <div class="flex flex-wrap items-center gap-5">
                    <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">Home</a>
                    <a asp-controller="LiveChat" asp-action="Index" class="hover:text-white transition-colors">LIVE Chat</a>
                    <a asp-controller="LiveDoctor" asp-action="Index" class="hover:text-white transition-colors">LIVE Doctor Reels</a>
                    <a asp-controller="Search" asp-action="Index" class="hover:text-white transition-colors">Find Doctors</a>
                    <a asp-controller="Home" asp-action="Faq" class="hover:text-white transition-colors">FAQs</a>
                    <a asp-controller="Home" asp-action="Emergency" class="hover:text-red-400 transition-colors flex items-center gap-1 font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Emergency
                    </a>
                    <a asp-controller="Home" asp-action="Terms" class="hover:text-white transition-colors">Terms</a>
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-white transition-colors">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===================== SCROLL TO TOP ===================== -->
    <button id="scroll-top" aria-label="Scroll to top">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6" />
        </svg>
    </button>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-20 right-4 bg-green-600 text-white px-5 py-3 rounded-lg shadow-lg font-medium text-sm translate-x-full opacity-0 transition-all duration-300 z-[200] flex items-center gap-2">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span id="toast-msg">Appointment request submitted successfully!</span>
    </div>

    <!-- Scripts: Loaded at end of body to prevent render-blocking -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="~/theme/assets/aos.js"></script>
    <script src="~/theme/assets/script.js" asp-append-version="true"></script>
    <script src="~/js/security-guard.js" asp-append-version="true"></script>
    <script src="~/js/language-switcher.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{
    ViewData["Title"] = "Terms and Conditions - CYHDocGuru";
}

<section class="py-16 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-semibold uppercase tracking-wider mb-3">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Platform Policy
        </span>
        <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-2">Terms and Conditions</h1>
        <p class="text-xs sm:text-sm text-slate-400">Last updated: June 2026</p>
    </div>
</section>

<section class="py-12 bg-slate-950 min-h-[60vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-10 space-y-8 text-xs sm:text-sm text-slate-300 leading-relaxed shadow-xl">
            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">1. Medical Telehealth Disclaimer</h2>
                <p class="text-slate-400">
                    CYHDocGuru provides digital health information, AI clinical symptom triage, and teleconsultation software connecting licensed healthcare providers with users. Content generated by AI is intended purely for guidance and clinical triage. Teleconsultations do not replace emergency in-person medical care. In case of acute medical emergencies, immediately contact emergency services or visit the nearest hospital.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">2. Consultation Fees & Wallet Deductions</h2>
                <p class="text-slate-400">
                    Paid doctor consultations utilize a real-time dual-timer mechanism. Fees are deducted per minute from the patient's prepaid platform wallet as specified on the doctor's profile. Wallet balances are non-transferable and can be redeemed for future healthcare consultations and smart prescriptions on CYHDocGuru.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">3. Doctor Streaming & Code of Conduct</h2>
                <p class="text-slate-400">
                    Live broadcasts on LIVE Doctor Reels are strictly for public health education, preventive lifestyle guidance, and medical awareness. Any abusive, misleading, or inappropriate behavior in comments is strictly monitored by our anti-inspect security shield and SignalR real-time moderation system.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">4. Digital Prescriptions & Privacy</h2>
                <p class="text-slate-400">
                    Prescriptions issued through the Smart Prescription Generator are stored encrypted under HIPAA and Indian Digital Health Data protection standards. Patients retain ownership of their medical records and can download or review their dose schedules at any time from their Patient Portal.
                </p>
            </div>
        </div>
    </div>
</section>

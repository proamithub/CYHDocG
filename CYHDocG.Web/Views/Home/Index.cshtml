@{
    ViewData["Title"] = "Home";
}

<!-- ===================== HERO SECTION ===================== -->
<section id="home" class="hero-section flex items-center justify-center relative pt-8 pb-16 lg:py-24 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white overflow-hidden">
    <!-- Ambient Glow Decos -->
    <div class="absolute top-10 right-16 w-80 h-80 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-72 h-72 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Hero Content -->
            <div>
                <!-- Badges -->
                <div class="flex flex-wrap gap-2.5 mb-6" data-aos="fade-up">
                    <span class="hero-badge bg-white/10 border border-white/15 px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                        Board Certified Specialists
                    </span>
                    <span class="hero-badge bg-white/10 border border-white/15 px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2">
                        <i data-lucide="activity" class="w-3.5 h-3.5 text-blue-400"></i>
                        Advanced Diagnostics
                    </span>
                    <span class="hero-badge bg-white/10 border border-white/15 px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-green-400"></i>
                        Patient-Centered Care
                    </span>
                </div>

                <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-tight mb-6" data-aos="fade-up" data-aos-delay="100">
                    Comprehensive Care<br />
                    <span class="text-red-500">For A Healthier</span> Heart & Life
                </h1>

                <p class="text-slate-300 text-lg leading-relaxed mb-8 max-w-xl" data-aos="fade-up" data-aos-delay="200">
                    CYHDocGuru provides state-of-the-art medical and cardiac consultations, rapid diagnostics, preventive wellness programs, and personalized treatment plans for every stage of your life.
                </p>

                <div class="flex flex-wrap gap-4 mb-10" data-aos="fade-up" data-aos-delay="300">
                    <a href="#appointments" class="btn-primary text-base py-3.5 px-8 rounded-xl shadow-lg shadow-red-600/30 flex items-center gap-2 font-semibold">
                        <i data-lucide="calendar-plus" class="w-5 h-5"></i>
                        Schedule Appointment
                    </a>
                    <a href="#services" class="btn-outline text-base py-3.5 px-8 rounded-xl border border-white/30 text-white hover:bg-white/10 transition-colors flex items-center gap-2 font-semibold">
                        <i data-lucide="compass" class="w-5 h-5"></i>
                        Our Services
                    </a>
                </div>

                <!-- Quick Milestone Stats -->
                <div class="flex flex-wrap gap-8 pt-4 border-t border-white/15" data-aos="fade-up" data-aos-delay="400">
                    <div>
                        <div class="font-heading font-bold text-3xl text-white">20+</div>
                        <div class="text-slate-400 text-xs sm:text-sm">Years Experience</div>
                    </div>
                    <div class="border-l border-white/20 pl-8">
                        <div class="font-heading font-bold text-3xl text-white">15K+</div>
                        <div class="text-slate-400 text-xs sm:text-sm">Happy Patients</div>
                    </div>
                    <div class="border-l border-white/20 pl-8">
                        <div class="font-heading font-bold text-3xl text-white">99.4%</div>
                        <div class="text-slate-400 text-xs sm:text-sm">Satisfaction Rate</div>
                    </div>
                </div>
            </div>

            <!-- Right Hero Card / Visual Preview -->
            <div class="hidden lg:flex justify-center relative" data-aos="fade-left" data-aos-delay="200">
                <div class="relative w-full max-w-md">
                    <!-- Feature Card Box -->
                    <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-3xl p-8 border border-white/15 shadow-2xl relative overflow-hidden">
                        <div class="flex items-center justify-between border-b border-white/10 pb-5 mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-red-600/20 text-red-500 flex items-center justify-center">
                                    <i data-lucide="heart-pulse" class="w-7 h-7"></i>
                                </div>
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-white">CYHDocGuru Clinic</h3>
                                    <p class="text-xs text-slate-400">Cardiology & Diagnostics Wing</p>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 bg-green-500/20 text-green-400 text-xs px-2.5 py-1 rounded-full font-semibold">
                                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span> Active
                            </span>
                        </div>

                        <!-- Vitals Overview -->
                        <div class="space-y-4 mb-6">
                            <div class="bg-white/5 border border-white/10 rounded-xl p-4 flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-red-600/20 text-red-400 flex items-center justify-center">
                                        <i data-lucide="activity" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-slate-400">Live Heart Rate</div>
                                        <div class="text-base font-bold text-white">72 BPM (Optimal)</div>
                                    </div>
                                </div>
                                <span class="text-xs text-green-400 font-medium">Normal Wave</span>
                            </div>

                            <div class="bg-white/5 border border-white/10 rounded-xl p-4 flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center">
                                        <i data-lucide="shield-check" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-slate-400">Blood Pressure Metric</div>
                                        <div class="text-base font-bold text-white">120 / 80 mmHg</div>
                                    </div>
                                </div>
                                <span class="text-xs text-blue-400 font-medium">Target Zone</span>
                            </div>

                            <div class="bg-white/5 border border-white/10 rounded-xl p-4 flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-purple-600/20 text-purple-400 flex items-center justify-center">
                                        <i data-lucide="clock" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-slate-400">Doctor Availability</div>
                                        <div class="text-base font-bold text-white">Immediate / Online</div>
                                    </div>
                                </div>
                                <span class="text-xs text-purple-400 font-medium">Available</span>
                            </div>
                        </div>

                        <!-- CTA inside preview card -->
                        <a href="#appointments" class="w-full btn-primary text-center justify-center py-3 text-sm font-semibold rounded-lg">
                            Request Priority Consultation
                        </a>
                    </div>

                    <!-- Floating Badge Top Left -->
                    <div class="absolute -top-5 -left-6 bg-white text-slate-900 rounded-xl px-4 py-3 shadow-xl border border-gray-100 flex items-center gap-3">
                        <div class="w-9 h-9 bg-red-100 text-red-600 rounded-full flex items-center justify-center">
                            <i data-lucide="award" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="font-bold text-xs">Top Rated Clinic</div>
                            <div class="text-[11px] text-slate-500">Excellence in Heart Care</div>
                        </div>
                    </div>

                    <!-- Floating Badge Bottom Right -->
                    <div class="absolute -bottom-5 -right-6 bg-white text-slate-900 rounded-xl px-4 py-3 shadow-xl border border-gray-100 flex items-center gap-3">
                        <div class="w-9 h-9 bg-green-100 text-green-600 rounded-full flex items-center justify-center">
                            <i data-lucide="check-circle" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <div class="font-bold text-xs">24/7 Response</div>
                            <div class="text-[11px] text-slate-500">Always Here For You</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== QUICK APPOINTMENT BOOKING ===================== -->
<section id="appointments" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-aos="fade-up">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-600 mb-3">
                <i data-lucide="calendar-check" class="w-3.5 h-3.5"></i>
                Online Appointment
            </span>
            <h2 class="font-heading font-bold text-3xl lg:text-4xl text-slate-900 mt-2">Book Your Consultation</h2>
            <p class="text-slate-500 max-w-2xl mx-auto mt-3">
                Schedule a consultation with our experienced cardiologists and physicians. We will confirm your preferred timing within 2 business hours.
            </p>
        </div>

        <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-3xl p-8 lg:p-12 shadow-2xl text-white max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            <form id="appt-form" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Patient Full Name *</label>
                    <input type="text" placeholder="John Doe" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Email Address *</label>
                    <input type="email" placeholder="patient@example.com" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Contact Phone *</label>
                    <input type="tel" placeholder="+1 (555) 000-0000" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Preferred Date *</label>
                    <input type="date" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Medical Department</label>
                    <select class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors">
                        <option>General Cardiology</option>
                        <option>ECG & Diagnostics</option>
                        <option>Hypertension Management</option>
                        <option>Preventive Health & Lifestyle</option>
                        <option>Cardiac Rehabilitation</option>
                        <option>Emergency Heart Care</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Brief Medical Concern</label>
                    <input type="text" placeholder="e.g. Chest pain, routine checkup"
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div class="md:col-span-2 lg:col-span-3 text-center mt-4">
                    <button type="submit" class="btn-primary px-10 py-3.5 text-base rounded-xl font-bold shadow-lg shadow-red-600/30 inline-flex items-center gap-2">
                        <i data-lucide="calendar-plus" class="w-5 h-5"></i>
                        Confirm Appointment Request
                    </button>
                    <p class="text-xs text-slate-400 mt-3">We respect your privacy. Medical records remain 100% confidential.</p>
                </div>
            </form>
        </div>
    </div>
</section>


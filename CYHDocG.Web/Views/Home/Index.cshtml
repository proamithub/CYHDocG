<!-- ===================== SERVICES GRID ===================== -->
<section id="services" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-600 mb-3">
                <i data-lucide="heart-pulse" class="w-3.5 h-3.5"></i>
                Clinical Specialties
            </span>
            <h2 class="font-heading font-bold text-3xl sm:text-4xl text-slate-900 mt-2">Comprehensive Healthcare Services</h2>
            <p class="text-slate-500 max-w-2xl mx-auto mt-3">
                Discover our specialized cardiovascular and medical solutions designed to deliver the best diagnostic accuracy and clinical outcomes.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Service 1 -->
            <div class="bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:shadow-xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay="0">
                <div class="w-14 h-14 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center mb-6 group-hover:bg-red-600 group-hover:text-white transition-colors">
                    <i data-lucide="heart" class="w-7 h-7"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-slate-900 mb-3">Cardiac Consultation</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Thorough cardiovascular health evaluations, symptom assessments, risk profiling, and personalized health recommendations.
                </p>
                <a href="#appointments" class="inline-flex items-center gap-2 text-red-600 font-semibold text-sm hover:gap-3 transition-all">
                    Book Consultation <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <!-- Service 2 -->
            <div class="bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:shadow-xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay="100">
                <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="activity" class="w-7 h-7"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-slate-900 mb-3">ECG & Diagnostics</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Advanced 12-lead electrocardiography, Holter monitoring, stress testing, and high-frequency ultrasound imaging.
                </p>
                <a href="#appointments" class="inline-flex items-center gap-2 text-blue-600 font-semibold text-sm hover:gap-3 transition-all">
                    Learn Diagnostics <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <!-- Service 3 -->
            <div class="bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:shadow-xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay="200">
                <div class="w-14 h-14 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center mb-6 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                    <i data-lucide="stethoscope" class="w-7 h-7"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-slate-900 mb-3">Hypertension Management</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Targeted blood pressure stabilization plans blending pharmaceutical management, dietary regimens, and active monitoring.
                </p>
                <a href="#appointments" class="inline-flex items-center gap-2 text-purple-600 font-semibold text-sm hover:gap-3 transition-all">
                    View Care Plan <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <!-- Service 4 -->
            <div class="bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:shadow-xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay="0">
                <div class="w-14 h-14 rounded-2xl bg-green-100 text-green-600 flex items-center justify-center mb-6 group-hover:bg-green-600 group-hover:text-white transition-colors">
                    <i data-lucide="dumbbell" class="w-7 h-7"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-slate-900 mb-3">Cardiac Rehabilitation</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Supervised recovery programs for post-surgical, angioplasty, or myocardial infarction recovery to rebuild stamina and health safely.
                </p>
                <a href="#appointments" class="inline-flex items-center gap-2 text-green-600 font-semibold text-sm hover:gap-3 transition-all">
                    Rehab Details <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>

            <!-- Service 5 -->
            <div class="bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:shadow-xl transition-all duration-300 group" data-aos="fade-up" data-aos-delay="100">
                <div class="w-14 h-14 rounded-2xl bg-yellow-100 text-yellow-600 flex items-center justify-center mb-6 group-hover:bg-yellow-500 group-hover:text-white transition-colors">
                    <i data-lucide="shield" class="w-7 h-7"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-slate-900 mb-3">Preventive Cardiology</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Early lipid profile screening, arterial plaque assessment, and risk prevention routines for individuals with genetic heart history.
                </p>
                <a href="#appointments" class="inline-flex items-center gap-2 text-yellow-600 font-semibold text-sm hover:gap-3 transition-all">
                    Preventive Check <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>

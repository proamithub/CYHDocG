@{
    ViewData["Title"] = "Home - CYHDOC Guru JI";
}

<!-- ===================== HERO SECTION WITH AI SEARCH ===================== -->
<section id="home" class="hero-section flex items-center justify-center relative pt-6 pb-14 lg:pt-8 lg:pb-16 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white overflow-hidden">
    <!-- Ambient Glow Decos -->
    <div class="absolute top-10 right-16 w-80 h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-72 h-72 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
        <div class="max-w-3xl mx-auto text-center">

            <h1 class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight mb-6" data-aos="fade-up">
                CYHDOC <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-rose-400">Guru JI</span>
            </h1>

            <!-- ===================== AI SMART SEARCH BOX ===================== -->
            <div class="relative max-w-2xl mx-auto mb-6 text-left" data-aos="fade-up" data-aos-delay="100">
                <div class="relative bg-slate-900/90 backdrop-blur-xl border-2 border-red-500/40 hover:border-red-500/70 focus-within:border-red-500 focus-within:ring-4 focus-within:ring-red-500/20 rounded-2xl shadow-2xl transition-all p-2 flex items-center gap-2">
                    <div class="pl-3.5 text-red-400 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="sparkles" class="w-5 h-5 animate-pulse"></i>
                    </div>
                    <input type="text" id="homeSearchInput" placeholder="Type fever, heart pain, cough, dermatology..." 
                           class="w-full bg-transparent border-none text-white text-sm sm:text-base placeholder-slate-400 outline-none px-2"
                           autocomplete="off" onkeyup="handleHomeSearch(this.value)" data-i18n="search_placeholder" />
                    <button type="button" onclick="executeSearchRedirect()" class="py-2.5 px-5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs sm:text-sm flex items-center gap-1.5 shadow-lg shadow-red-600/30 transition-all flex-shrink-0 active:scale-95">
                        <i data-lucide="search" class="w-4 h-4"></i>
                        <span data-i18n="search_btn">Search</span>
                    </button>
                </div>

                <!-- Auto-Suggest Dropdown Box (AI Dynamic Suggestions) -->
                <div id="homeSuggestionsBox" class="absolute top-full left-0 right-0 mt-2 bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl p-2 hidden z-50 max-h-80 overflow-y-auto">
                    <!-- Populated dynamically by JS -->
                </div>

                <!-- Quick Symptom Tags -->
                <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs">
                    <span class="text-slate-400">Popular:</span>
                    <button type="button" onclick="setQuickSearch('Chest Pain')" class="px-3 py-1 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">Chest Pain</button>
                    <button type="button" onclick="setQuickSearch('Fever & Cough')" class="px-3 py-1 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">Fever & Cough</button>
                    <button type="button" onclick="setQuickSearch('Cardiology')" class="px-3 py-1 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">Cardiology</button>
                    <button type="button" onclick="setQuickSearch('Dermatology')" class="px-3 py-1 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition-colors">Dermatology</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== MEDICAL AWARENESS SLIDER LAYER ===================== -->
<section class="py-12 bg-slate-900 border-y border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <span class="text-xs font-bold text-red-400 uppercase tracking-wider block" data-i18n="awareness_tag">Daily Health Insights</span>
                <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-white mt-1" data-i18n="awareness_title">Medical Awareness & Prevention</h2>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="scrollAwareness(-1)" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-slate-300 hover:text-white transition-all">
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </button>
                <button onclick="scrollAwareness(1)" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-slate-300 hover:text-white transition-all">
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- Horizontal Smooth Scroll Cards Container (Auto-sliding, No Scrollbar) -->
        <div id="awarenessSlider" class="flex gap-5 overflow-x-auto scroll-smooth pb-4 no-scrollbar" style="scrollbar-width: none; -ms-overflow-style: none;">
            <!-- Card 1 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-red-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-red-600/20 text-red-500 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="heart-pulse" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Cardiac Warning Signs</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Unusual shortness of breath, left arm radiation, or cold sweats demand urgent ECG testing. Never delay.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-red-400 font-semibold">
                    <span>Cardiology Tips</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-blue-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="activity" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Blood Pressure Normalcy</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Maintain 120/80 mmHg with low sodium intake, 30 minutes of aerobic walk, and routine weekly checks.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-blue-400 font-semibold">
                    <span>Hypertension Guide</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-amber-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-amber-600/20 text-amber-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="shield-alert" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Seasonal Viral Infection</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Stay hydrated with electrolyte fluids, prioritize Vitamin C intake, and avoid unprescribed antibiotics.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-amber-400 font-semibold">
                    <span>Preventive Care</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-emerald-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-600/20 text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="bell-ring" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Medication Adherence</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Skipping antibiotic or hypertension doses can trigger resistance. Use CYHDocGuru's dose alarms.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-emerald-400 font-semibold">
                    <span>Dose Reminders</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-purple-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-purple-600/20 text-purple-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="dna" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Diabetes & Vascular Health</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Keep HbA1c below 6.5%. Uncontrolled blood sugar thickens artery walls and doubles heart stroke probability.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-purple-400 font-semibold">
                    <span>Sugar Balance</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="min-w-[280px] sm:min-w-[320px] bg-slate-950/80 border border-slate-800 hover:border-rose-500/40 rounded-2xl p-5 flex flex-col justify-between transition-all group">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-rose-600/20 text-rose-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="sparkles" class="w-5 h-5"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white mb-2">Emergency Response Steps</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        In severe chest pressure, have patient sit upright, avoid exertion, chew 300mg aspirin, and dial our 24/7 team.
                    </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-rose-400 font-semibold">
                    <span>Emergency Guide</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </div>
        </div>
        </div>
    </div>
</section>

<!-- ===================== LIVE DOCTOR CONVERSATION & REEL ANIMATION HOOK ===================== -->
<section class="py-16 bg-slate-950 bg-gradient-to-b from-slate-900 to-slate-950 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Text Content -->
            <div>
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/20 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4" data-i18n="live_hook_tag">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span> Live Broadcast & 1-to-1
                </span>
                <h2 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight mb-5" data-i18n="live_hook_title">
                    Speak Live With Certified Specialists
                </h2>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8 max-w-lg" data-i18n="live_hook_desc">
                    Watch real-time live streams, join interactive video chats, or escalate from AI directly to available doctors in seconds.
                </p>

                <div class="flex flex-wrap items-center gap-4">
                    <a asp-controller="LiveDoctor" asp-action="Index" class="py-3.5 px-6 rounded-2xl bg-red-600 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold text-sm shadow-xl shadow-red-600/30 hover:shadow-red-600/50 active:scale-95 transition-all flex items-center gap-2.5">
                        <i data-lucide="play" class="w-4 h-4 fill-white"></i>
                        <span data-i18n="live_hook_btn">Explore LIVE Doctor Reels</span>
                    </a>
                    <a asp-controller="LiveChat" asp-action="Index" class="py-3.5 px-6 rounded-2xl bg-slate-800/90 hover:bg-slate-800 border border-slate-700 text-slate-200 hover:text-white font-semibold text-sm transition-all flex items-center gap-2">
                        <i data-lucide="message-circle" class="w-4 h-4 text-emerald-400"></i>
                        <span data-i18n="live_chat_btn">Start AI Live Chat</span>
                    </a>
                </div>
            </div>

            <!-- Right: Interactive Reel Phone Mockup Animation -->
            <div class="flex justify-center">
                <a asp-controller="LiveDoctor" asp-action="Index" class="block group relative w-72 sm:w-80 h-[480px] bg-slate-900 rounded-[3rem] p-3 border-4 border-slate-800 shadow-2xl shadow-red-600/10 hover:border-red-500/60 transition-all hover:scale-[1.02]">
                    <!-- Phone Notch & Camera -->
                    <div class="absolute top-5 left-1/2 -translate-x-1/2 w-28 h-5 bg-slate-800 rounded-full z-30 flex items-center justify-center">
                        <div class="w-2.5 h-2.5 rounded-full bg-slate-900 border border-slate-700"></div>
                    </div>

                    <!-- Inner Screen Container -->
                    <div class="relative w-full h-full bg-slate-950 rounded-[2.3rem] overflow-hidden flex flex-col justify-between p-4">
                        <!-- Simulated Doctor Stream Background (Dark aesthetic with doctor badge) -->
                        <div class="absolute inset-0 bg-gradient-to-b from-blue-950/40 via-slate-900/80 to-slate-950 z-0"></div>

                        <!-- Top Overlay: Live Tag + Viewers -->
                        <div class="relative z-10 flex items-center justify-between pt-5">
                            <span class="px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-md shadow-red-600/40 animate-pulse">
                                <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
                            </span>
                            <div class="px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md text-white text-[11px] font-medium flex items-center gap-1 border border-white/10">
                                <i data-lucide="eye" class="w-3.5 h-3.5 text-red-400"></i>
                                <span>1.4k watching</span>
                            </div>
                        </div>

                        <!-- Doctor Info Overlay -->
                        <div class="relative z-10 mt-auto mb-3">
                            <div class="flex items-center gap-2.5 mb-2">
                                <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-xs font-bold text-white shadow">
                                    Dr
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-white">Dr. Arvind Mehta, MD</h4>
                                    <span class="text-[10px] text-slate-400">Chief Cardiologist • 18 yrs exp</span>
                                </div>
                            </div>

                            <!-- Animated Floating Chat Simulation -->
                            <div class="space-y-1.5 bg-black/40 backdrop-blur-md rounded-xl p-2.5 border border-white/5 text-[11px]">
                                <div class="flex items-center gap-1.5 text-slate-300">
                                    <span class="font-bold text-red-400">Ravi K:</span>
                                    <span>Doctor, severe headache since yesterday?</span>
                                </div>
                                <div class="flex items-center gap-1.5 text-slate-300">
                                    <span class="font-bold text-blue-400">Dr. Arvind:</span>
                                    <span>Check your BP first, connect 1-to-1.</span>
                                </div>
                                <div class="flex items-center gap-1.5 text-slate-300">
                                    <span class="font-bold text-emerald-400">Pooja S:</span>
                                    <span>Thank you for the prescription! ❤️</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Floating Action Buttons (Like, Share, Comment) -->
                        <div class="absolute right-3 bottom-24 flex flex-col gap-3.5 z-20 items-center">
                            <div class="w-9 h-9 rounded-full bg-black/60 border border-white/10 flex items-center justify-center text-red-500 shadow hover:scale-110 transition-transform">
                                <i data-lucide="heart" class="w-4 h-4 fill-red-500"></i>
                            </div>
                            <div class="w-9 h-9 rounded-full bg-black/60 border border-white/10 flex items-center justify-center text-white shadow hover:scale-110 transition-transform">
                                <i data-lucide="message-square" class="w-4 h-4"></i>
                            </div>
                            <div class="w-9 h-9 rounded-full bg-black/60 border border-white/10 flex items-center justify-center text-white shadow hover:scale-110 transition-transform">
                                <i data-lucide="share-2" class="w-4 h-4"></i>
                            </div>
                        </div>

                        <!-- Bottom prompt -->
                        <div class="relative z-10 py-1 text-center bg-red-600/30 rounded-xl border border-red-500/40 text-[10px] font-bold text-red-300 group-hover:bg-red-600 group-hover:text-white transition-all">
                            Click to Open Live Doctor Studio
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ===================== QUICK APPOINTMENT BOOKING ===================== -->
<section id="appointments" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-aos="fade-up">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-600 mb-3">
                <i data-lucide="calendar-check" class="w-3.5 h-3.5"></i>
                Online Appointment
            </span>
            <h2 class="font-heading font-bold text-3xl lg:text-4xl text-slate-900 mt-2">Book Your Consultation</h2>
            <p class="text-slate-500 max-w-2xl mx-auto mt-3">
                Schedule a consultation with our experienced cardiologists and physicians. We will confirm your preferred timing within 2 business hours.
            </p>
        </div>

        <div class="bg-slate-900 bg-gradient-to-br from-slate-900 to-slate-800 rounded-3xl p-8 lg:p-12 shadow-2xl text-white max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            <form id="appt-form" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Patient Full Name *</label>
                    <input type="text" placeholder="John Doe" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Email Address *</label>
                    <input type="email" placeholder="patient@example.com" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Contact Phone *</label>
                    <input type="tel" placeholder="+1 (555) 000-0000" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Preferred Date *</label>
                    <input type="date" required
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Medical Department</label>
                    <select class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors">
                        <option>General Cardiology</option>
                        <option>ECG & Diagnostics</option>
                        <option>Hypertension Management</option>
                        <option>Preventive Health & Lifestyle</option>
                        <option>Cardiac Rehabilitation</option>
                        <option>Emergency Heart Care</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Brief Medical Concern</label>
                    <input type="text" placeholder="e.g. Chest pain, routine checkup"
                           class="w-full bg-slate-800/80 border border-slate-700 text-white rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-red-500 transition-colors" />
                </div>

                <div class="md:col-span-2 lg:col-span-3 text-center mt-4">
                    <button type="submit" class="btn-primary px-10 py-3.5 text-base rounded-xl font-bold shadow-lg shadow-red-600/30 inline-flex items-center gap-2">
                        <i data-lucide="calendar-plus" class="w-5 h-5"></i>
                        Confirm Appointment Request
                    </button>
                    <p class="text-xs text-slate-400 mt-3">We respect your privacy. Medical records remain 100% confidential.</p>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ===================== ABOUT SECTION ===================== -->
<section id="about" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Left Info Cards -->
            <div data-aos="fade-right">
                <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-100">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-600 mb-4">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                        About CYHDocGuru
                    </span>
                    <h2 class="font-heading font-bold text-3xl sm:text-4xl text-slate-900 leading-tight mb-5">
                        Your Trusted Medical Partner with Decades of Proven Excellence
                    </h2>
                    <p class="text-slate-600 leading-relaxed mb-6">
                        At CYHDocGuru, our mission is to deliver comprehensive, compassionate, and precise healthcare. Our team comprises fellowship-trained cardiologists, experienced physicians, and skilled clinicians using state-of-the-art diagnostic technology.
                    </p>

                    <div class="grid grid-cols-2 gap-4 mb-8">
                        <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">
                            <div class="font-heading font-extrabold text-3xl text-red-600">20+</div>
                            <div class="text-sm font-medium text-slate-700 mt-1">Years of Care</div>

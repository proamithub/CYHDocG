                                <i data-lucide="check" class="w-4 h-4"></i>
                            </div>
                            <span>Accredited Cardiology & Multi-specialty Healthcare Facility</span>
                        </div>
                        <div class="flex items-center gap-3 text-slate-700 text-sm">

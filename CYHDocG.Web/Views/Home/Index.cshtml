@section Scripts {
    <script>
        let awarenessAutoTimer = null;
        let isAwarenessPaused = false;

        function scrollAwareness(direction) {
            const container = document.getElementById('awarenessSlider');
            if (!container) return;
            const scrollStep = 340;
            const maxScroll = container.scrollWidth - container.clientWidth;

            if (direction > 0 && container.scrollLeft >= maxScroll - 15) {
                // Loop back to start smoothly
                container.scrollTo({ left: 0, behavior: 'smooth' });
            } else if (direction < 0 && container.scrollLeft <= 15) {
                // Loop to end smoothly
                container.scrollTo({ left: maxScroll, behavior: 'smooth' });
            } else {
                container.scrollBy({ left: direction * scrollStep, behavior: 'smooth' });
            }
            resetAwarenessTimer();
        }

        function startAwarenessAutoSlide() {
            if (awarenessAutoTimer) clearInterval(awarenessAutoTimer);
            awarenessAutoTimer = setInterval(() => {
                if (!isAwarenessPaused) {
                    scrollAwareness(1);
                }
            }, 3500);
        }

        function resetAwarenessTimer() {
            if (awarenessAutoTimer) clearInterval(awarenessAutoTimer);
            startAwarenessAutoSlide();
        }

        document.addEventListener('DOMContentLoaded', () => {
            const slider = document.getElementById('awarenessSlider');
            if (slider) {
                slider.addEventListener('mouseenter', () => { isAwarenessPaused = true; });
                slider.addEventListener('mouseleave', () => { isAwarenessPaused = false; });
                slider.addEventListener('touchstart', () => { isAwarenessPaused = true; }, { passive: true });
                slider.addEventListener('touchend', () => { isAwarenessPaused = false; }, { passive: true });
                startAwarenessAutoSlide();
            }
        });

        function setQuickSearch(val) {
            const input = document.getElementById('homeSearchInput');
            if (input) {
                input.value = val;
                handleHomeSearch(val);
            }
        }

        let searchDebounceTimer = null;
        async function handleHomeSearch(val) {
            const box = document.getElementById('homeSuggestionsBox');
            if (!box) return;

            clearTimeout(searchDebounceTimer);
            if (!val || val.trim().length < 2) {
                box.classList.add('hidden');
                box.innerHTML = '';
                return;
            }

            searchDebounceTimer = setTimeout(async () => {
                try {
                    const response = await fetch('/api/search/suggestions?q=' + encodeURIComponent(val));
                    const data = await response.json();
                    
                    if (data && data.length > 0) {
                        let html = '';
                        data.forEach(item => {
                            html += `
                            <a href="/LiveDoctor?q=${encodeURIComponent(item.doctorName)}" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800 transition-colors">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-red-600/20 text-red-500 flex items-center justify-center font-bold text-xs">
                                        Dr
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">${item.doctorName}</div>
                                        <div class="text-[10px] text-slate-400">${item.specialty} • ${item.department}</div>
                                    </div>
                                </div>
                                <span class="text-[10px] px-2 py-0.5 rounded-full ${item.isLive ? 'bg-emerald-500/20 text-emerald-400 font-bold' : 'bg-slate-800 text-slate-400'}">
                                    ${item.isLive ? 'LIVE NOW' : 'Specialist'}
                                </span>
                            </a>
                            `;
                        });
                        box.innerHTML = html;
                        box.classList.remove('hidden');
                    } else {
                        box.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">No specific doctor found for "${val}". Searching symptoms...</div>`;
                        box.classList.remove('hidden');
                    }
                } catch (e) {
                    console.error(e);
                }
            }, 300);
        }

        function executeSearchRedirect() {
            const input = document.getElementById('homeSearchInput');
            const q = input ? input.value : '';
            window.location.href = '/LiveDoctor?q=' + encodeURIComponent(q);
        }
    </script>
}

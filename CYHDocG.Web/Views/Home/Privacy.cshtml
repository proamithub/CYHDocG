@{
    ViewData["Title"] = "Privacy Policy - CYHDocGuru";
}

<section class="py-16 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider mb-3">
            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Patient Confidentiality
        </span>
        <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-white mb-2">Privacy & Health Data Protection</h1>
        <p class="text-xs sm:text-sm text-slate-400">Last updated: June 2026</p>
    </div>
</section>

<section class="py-12 bg-slate-950 min-h-[60vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 sm:p-10 space-y-8 text-xs sm:text-sm text-slate-300 leading-relaxed shadow-xl">
            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">1. Health Data Protection Commitment</h2>
                <p class="text-slate-400">
                    At CYHDocGuru, we prioritize medical privacy and data security. All patient medical history, consultations, prescription slips, and video streams are transmitted with end-to-end encryption. Your confidential data is never sold, rented, or shared with unauthorized commercial entities.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">2. Information Collected</h2>
                <p class="text-slate-400">
                    We collect your name, email, phone number, consultation chat logs, and prescription files exclusively to facilitate healthcare teleconsultations, dose alarms, and billing ledgers.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">3. Video Stream & Chat Security</h2>
                <p class="text-slate-400">
                    LiveKit WebRTC video consultations run via secure peer connections. Patient consultations are strictly confidential between the patient and attending medical practitioner.
                </p>
            </div>

            <div>
                <h2 class="font-heading font-bold text-base sm:text-lg text-white mb-2">4. Contact Our Privacy Office</h2>
                <p class="text-slate-400">
                    For inquiries regarding data retention, deletion, or privacy queries, email our compliance officer at <strong class="text-red-400">privacy@cyhdocguru.com</strong>.
                </p>
            </div>
        </div>
    </div>
</section>

@model CYHDocG.Repo.DTOs.RegisterRequestDto
@{
    ViewData["Title"] = "Create Account";
}

<div class="min-h-[85vh] flex items-center justify-center px-4 py-12 relative overflow-hidden">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-white/95 backdrop-blur-xl border border-slate-200/80 rounded-3xl shadow-2xl p-6 sm:p-8 relative z-10">
        <div class="text-center mb-6">
            <h2 class="font-heading font-extrabold text-2xl text-slate-900 tracking-tight">Join <span class="text-red-600">CYHDocGuru</span></h2>
          
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm flex items-start gap-2.5">
                <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500"></i>
                <div asp-validation-summary="All" class="text-xs"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Full Name <span class="text-red-500">*</span></label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="user" class="w-4 h-4"></i>
                    </span>
                    <input asp-for="FullName" required placeholder="Rahul Sharma" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 text-sm text-slate-800 outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Email Address <span class="text-red-500">*</span></label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                    </span>
                    <input asp-for="Email" type="email" required placeholder="rahul@example.com" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 text-sm text-slate-800 outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                    <span>Mobile Number <span class="text-red-500">*</span></span>
                    <span id="phoneCounter" class="text-[10px] text-slate-400 font-normal lowercase">10 digits</span>
                </label>
                <div class="relative flex items-center">
                    <span class="inline-flex items-center px-3.5 py-2.5 rounded-l-xl border border-r-0 border-slate-200 bg-slate-50 text-slate-600 text-xs font-bold select-none tracking-wide">
                        +91
                    </span>
                    <input asp-for="Phone" id="phoneInput" type="tel" maxlength="10" minlength="10" inputmode="numeric" required 
                           placeholder="9876543210" autocomplete="tel"
                           class="w-full rounded-r-xl border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 text-sm text-slate-800 px-3.5 py-2.5 outline-none font-medium transition-all" />
                </div>
                <span asp-validation-for="Phone" class="text-red-500 text-xs mt-1 block"></span>
                <p id="phoneFeedback" class="text-[11px] mt-1.5 text-slate-400 font-medium transition-all flex items-center gap-1.5">
                    <i data-lucide="info" class="w-3.5 h-3.5 flex-shrink-0"></i>
                    <span id="phoneFeedbackText">Must be 10 digits starting with 6, 7, 8, or 9</span>
                </p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password <span class="text-red-500">*</span></label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="lock" class="w-4 h-4"></i>
                    </span>
                    <input asp-for="Password" type="password" required placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 text-sm text-slate-800 outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Account Type <span class="text-red-500">*</span></label>
                <select asp-for="RoleName" id="accountTypeSelect" onchange="toggleDoctorNotice(this.value)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 text-sm text-slate-800 outline-none bg-white">
                    <option value="User">Patient / User</option>
                    <option value="Doctor">Doctor / Medical Practitioner</option>
                </select>
                <div id="doctorNotice" class="hidden text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-3 mt-2 flex items-start gap-2">
                    <i data-lucide="info" class="w-4 h-4 flex-shrink-0 text-amber-600 mt-0.5"></i>
                    <span>Doctor accounts require verification and approval by CYHDocGuru administration before consultation and live studio features are activated.</span>
                </div>
            </div>

            <button type="submit" class="w-full mt-2 py-3 px-4 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-sm shadow-lg shadow-red-600/30 hover:shadow-red-600/40 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                <span>Create Account</span>
                <i data-lucide="check" class="w-4 h-4"></i>
            </button>
        </form>

        <p class="text-center text-xs sm:text-sm text-slate-500 mt-6">
            Already have an account?
            <a asp-action="Login" class="text-red-600 font-semibold hover:text-red-700 ml-1">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDoctorNotice(val) {
            const notice = document.getElementById('doctorNotice');
            if (notice) {
                notice.classList.toggle('hidden', val !== 'Doctor');
            }
        }

        const phoneInput = document.getElementById('phoneInput');
        const phoneCounter = document.getElementById('phoneCounter');
        const phoneFeedback = document.getElementById('phoneFeedback');
        const phoneFeedbackText = document.getElementById('phoneFeedbackText');

        function validateMobileNumber(val) {
            if (!val) {
                return { valid: false, digits: '', msg: 'Mobile number is required', state: 'empty' };
            }

            // Strip any non-digit
            let digits = val.replace(/\D/g, '');

            // Strip leading 91 if pasted 12 digits
            if (digits.length === 12 && digits.startsWith('91')) {
                digits = digits.substring(2);
            }
            // Strip leading 0 if pasted 11 digits
            else if (digits.length === 11 && digits.startsWith('0')) {
                digits = digits.substring(1);
            }

            // Cap at 10 digits
            if (digits.length > 10) {
                digits = digits.substring(0, 10);
            }

            if (digits.length === 0) {
                return { valid: false, digits: '', msg: 'Mobile number is required', state: 'empty' };
            }

            const first = digits[0];
            if (!['6', '7', '8', '9'].includes(first)) {
                return { valid: false, digits, msg: 'Mobile number must start with 6, 7, 8, or 9', state: 'invalid-start' };
            }

            if (digits.length < 10) {
                return { valid: false, digits, msg: `Enter exactly 10 digits (${digits.length}/10 entered)`, state: 'incomplete' };
            }

            // Check if all 10 digits are identical (e.g. 9999999999, 0000000000, 1111111111)
            if (/^(\d)\1{9}$/.test(digits)) {
                return { valid: false, digits, msg: 'Invalid mobile number (all digits cannot be identical)', state: 'repeated' };
            }

            // Check common dummy sequences
            if (digits === '1234567890' || digits === '0123456789') {
                return { valid: false, digits, msg: 'Sequential dummy numbers like 1234567890 are not permitted', state: 'dummy' };
            }

            return { valid: true, digits, msg: '✓ Valid 10-digit mobile number', state: 'valid' };
        }

        function updatePhoneUI() {
            if (!phoneInput) return false;
            const res = validateMobileNumber(phoneInput.value);

            if (phoneInput.value !== res.digits) {
                phoneInput.value = res.digits;
            }

            if (phoneCounter) {
                phoneCounter.textContent = `${res.digits.length}/10 digits`;
            }

            if (res.state === 'empty') {
                phoneFeedback.className = 'text-[11px] mt-1.5 text-slate-400 font-medium transition-all flex items-center gap-1.5';
                phoneFeedbackText.textContent = 'Must be 10 digits starting with 6, 7, 8, or 9';
                phoneInput.classList.remove('border-red-500', 'border-emerald-500');
            } else if (res.valid) {
                phoneFeedback.className = 'text-[11px] mt-1.5 text-emerald-600 font-semibold transition-all flex items-center gap-1.5';
                phoneFeedbackText.textContent = res.msg;
                phoneInput.classList.remove('border-red-500');
                phoneInput.classList.add('border-emerald-500');
            } else {
                phoneFeedback.className = 'text-[11px] mt-1.5 text-red-600 font-medium transition-all flex items-center gap-1.5';
                phoneFeedbackText.textContent = res.msg;
                phoneInput.classList.remove('border-emerald-500');
                phoneInput.classList.add('border-red-500');
            }

            return res.valid;
        }

        if (phoneInput) {
            phoneInput.addEventListener('input', updatePhoneUI);
            phoneInput.addEventListener('blur', updatePhoneUI);
            phoneInput.addEventListener('paste', () => setTimeout(updatePhoneUI, 20));
        }

        const regForm = document.querySelector('form');
        if (regForm) {
            regForm.addEventListener('submit', function (e) {
                const isValid = updatePhoneUI();
                if (!isValid) {
                    e.preventDefault();
                    if (phoneInput) {
                        phoneInput.focus();
                    }
                }
            });
        }
    </script>
}

@model CYHDocG.Repo.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Change Password";
}

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-slate-950 relative overflow-hidden">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl p-6 sm:p-8 relative z-10">
        <div class="text-center mb-6">
            <div class="w-14 h-14 bg-red-600/20 text-red-400 border border-red-500/30 rounded-2xl mx-auto flex items-center justify-center mb-3">
                <i data-lucide="key-round" class="w-7 h-7"></i>
            </div>
            <h2 class="font-heading font-extrabold text-2xl text-white">Change Password</h2>
            <p class="text-xs text-slate-400 mt-1">Keep your CYHDocGuru account secure with a strong password.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-5 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-2.5">
                <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs flex items-start gap-2.5">
                <i data-lucide="alert-circle" class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5"></i>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Current Password</label>
                <input asp-for="OldPassword" type="password" required placeholder="••••••••"
                       class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-red-500 text-sm text-white placeholder-slate-500 outline-none" />
                <span asp-validation-for="OldPassword" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">New Password</label>
                <input asp-for="NewPassword" type="password" minlength="6" required placeholder="Min 6 characters"
                       class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-red-500 text-sm text-white placeholder-slate-500 outline-none" />
                <span asp-validation-for="NewPassword" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Confirm New Password</label>
                <input asp-for="ConfirmNewPassword" type="password" minlength="6" required placeholder="Re-enter new password"
                       class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-red-500 text-sm text-white placeholder-slate-500 outline-none" />
                <span asp-validation-for="ConfirmNewPassword" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="w-full mt-2 py-3 px-4 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-sm shadow-lg shadow-red-600/30 transition-all flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                <span>Update Password</span>
            </button>
        </form>
    </div>
</div>

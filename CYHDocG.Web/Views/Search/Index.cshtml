@model CYHDocG.Repo.DTOs.AiDiagnosisResultDto
@{
    ViewData["Title"] = "AI Diagnosis & Specialist Match";
}

<div class="min-h-screen bg-slate-950 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-8">

        <!-- Search Header Bar -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-5 sm:p-6 shadow-2xl backdrop-blur-xl">
            <form action="/Search" method="get" class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-red-500">
                        <i data-lucide="sparkles" class="w-5 h-5 animate-pulse"></i>
                    </span>
                    <input type="text" name="q" value="@Model.QueryText" placeholder="Describe symptoms (e.g., chest heaviness, high fever, rash)..." 
                           class="w-full pl-11 pr-4 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-white placeholder-slate-400 text-sm focus:border-red-500 focus:ring-2 focus:ring-red-500/20 outline-none transition-all" />
                </div>
                <button type="submit" class="py-3 px-6 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm shadow-lg shadow-red-600/30 active:scale-95 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    <span>Re-Analyze</span>
                </button>
            </form>
        </div>

        @if (Model.IsEmergency)
        {
            <!-- Emergency Alert Banner -->
            <div class="bg-red-950/80 border-2 border-red-500 rounded-3xl p-6 text-white flex items-start gap-4 shadow-2xl shadow-red-900/40">
                <div class="w-12 h-12 rounded-2xl bg-red-600 flex items-center justify-center flex-shrink-0 animate-bounce">
                    <i data-lucide="alert-triangle" class="w-6 h-6 text-white"></i>
                </div>
                <div class="flex-1">
                    <h3 class="font-heading font-black text-lg text-white">POTENTIAL EMERGENCY DETECTED</h3>
                    <p class="text-xs sm:text-sm text-red-200 mt-1 leading-relaxed">
                        Your reported symptoms suggest a high-risk situation. If you are experiencing sudden severe chest tightness, paralysis, or collapse, call emergency services immediately or visit the nearest ER clinic.
                    </p>
                </div>
            </div>
        }

        <!-- AI Symptom Analysis Card -->
        <div class="bg-gradient-to-br from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5 mb-6">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-red-600/20 text-red-500 border border-red-500/30 flex items-center justify-center">
                        <i data-lucide="cpu" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-red-400 uppercase tracking-wider">AI Clinical Intelligence</span>
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        </div>
                        <h2 class="font-heading font-bold text-xl text-white">Triage Assessment</h2>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-xs px-3 py-1.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 font-medium">
                        Dept: <strong class="text-white">@Model.IdentifiedDepartment</strong>
                    </span>
                    <span class="text-xs px-3 py-1.5 rounded-full font-bold uppercase tracking-wider @(Model.Severity == "High" || Model.Severity == "Emergency" ? "bg-red-500/20 text-red-400 border border-red-500/30" : "bg-blue-500/20 text-blue-400 border border-blue-500/30")">
                        Severity: @Model.Severity
                    </span>
                </div>
            </div>

            <!-- AI Advice -->
            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-5 mb-6">
                <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <i data-lucide="message-square" class="w-3.5 h-3.5 text-blue-400"></i>
                    Clinical Advice
                </h4>
                <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">
                    @Model.AiAdviceEn
                </p>
            </div>

            <!-- Fast Handoff CTAs -->
            <div class="flex flex-wrap items-center gap-4">
                <a asp-controller="LiveDoctor" asp-action="Index" class="py-3 px-5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs sm:text-sm shadow-md shadow-red-600/30 transition-all flex items-center gap-2">
                    <i data-lucide="tv" class="w-4 h-4"></i>
                    <span>Watch Live @Model.IdentifiedDepartment Specialists</span>
                </a>
                <a asp-controller="LiveChat" asp-action="Index" class="py-3 px-5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-xs sm:text-sm border border-slate-700 transition-all flex items-center gap-2">
                    <i data-lucide="bot" class="w-4 h-4 text-emerald-400"></i>
                    <span>Chat With AI Bot</span>
                </a>
            </div>
        </div>

        <!-- Recommended Specialist Doctors -->
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="font-heading font-bold text-lg text-white">Recommended Specialists</h3>
                    <p class="text-xs text-slate-400">Certified doctors matching your symptoms</p>
                </div>
                <span class="text-xs text-slate-400 font-medium">@Model.RecommendedDoctors.Count Doctor(s) Available</span>
            </div>

            @if (Model.RecommendedDoctors.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var doc in Model.RecommendedDoctors)
                    {
                        <div class="bg-slate-900/80 border border-slate-800 hover:border-slate-700 rounded-3xl p-5 shadow-xl transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-3 mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 rounded-2xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center font-bold text-sm">
                                            Dr
                                        </div>
                                        <div>
                                            <h4 class="font-heading font-bold text-base text-white">@doc.DoctorName</h4>
                                            <p class="text-xs text-slate-400">@doc.Specialty • @doc.Department</p>
                                        </div>
                                    </div>
                                    @if (doc.IsLive)
                                    {
                                        <span class="px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shadow animate-pulse">
                                            <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
                                        </span>
                                    }
                                </div>

                                <div class="flex items-center gap-4 text-xs text-slate-300 my-3">
                                    <span class="flex items-center gap-1 text-amber-400">
                                        <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400"></i> 4.9 Rating
                                    </span>
                                    <span>•</span>
                                    <span>@doc.ExperienceYears Yrs Experience</span>
                                    <span>•</span>
                                    <span class="text-emerald-400 font-semibold">
                                        @(doc.IsFreeConsultation ? "FREE Consultation" : $"₹{doc.ConsultationFeePerMinute:N0} / min")
                                    </span>
                                </div>
                            </div>

                            <div class="pt-3 border-t border-slate-800/80 flex items-center gap-2 mt-2">
                                <a asp-controller="LiveDoctor" asp-action="Index" class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold text-center transition-colors">
                                    Watch Stream Reel
                                </a>
                                <a asp-controller="LiveChat" asp-action="Index" class="flex-1 py-2 px-3 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold text-center transition-colors shadow shadow-red-600/30">
                                    Start 1-to-1 Chat
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center text-slate-400">
                    <i data-lucide="stethoscope" class="w-10 h-10 mx-auto text-slate-600 mb-2"></i>
                    <p class="text-sm">No specialized doctors found online right now. You can consult our 24/7 AI Health Chat.</p>
                    <a href="/LiveChat?q=@Uri.EscapeDataString(Model.QueryText)&doc_unavailable=1" class="mt-4 inline-flex items-center gap-2 py-2.5 px-5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 text-white text-xs font-bold shadow-lg shadow-red-600/30 active:scale-95 transition-all">
                        <i data-lucide="bot" class="w-4 h-4 text-emerald-400"></i>
                        <span>Consult AI Health Guru (Gemini AI)</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

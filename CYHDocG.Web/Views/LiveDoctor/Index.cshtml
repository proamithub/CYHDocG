@model List<CYHDocG.Repo.DTOs.DoctorReelDto>
@{
    ViewData["Title"] = "LIVE Doctor Reels Feed";
    bool isAuth = ViewBag.IsAuthenticated ?? false;
}

<!-- LiveKit Real-Time WebRTC SDK & SignalR Client Script -->
<script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<div class="bg-black text-white min-h-[calc(100vh-80px)] flex justify-center items-center py-2 relative overflow-hidden">

    <!-- Reels Scrollable Feed Container (Vertical Snap Scroll) -->
    <div id="reelsContainer" class="w-full max-w-sm sm:max-w-md h-[calc(100vh-96px)] overflow-y-scroll snap-y snap-mandatory no-scrollbar relative rounded-3xl border border-slate-800 shadow-2xl bg-slate-950">
        
        @if (Model != null && Model.Any())
        {
            int index = 0;
            foreach (var reel in Model)
            {
                <div class="reel-card @(index == 0 ? "active-reel" : "") h-full w-full snap-start relative flex flex-col justify-between p-4 overflow-hidden" 
                     data-stream-id="@(reel.StreamId ?? reel.DoctorId)" 
                     data-doctor-id="@reel.DoctorId"
                     data-is-live="@(reel.IsLive ? "true" : "false")"
                     data-index="@index">

                    <!-- Background: Live Stream Video Element / Doctor Poster -->
                    <div class="absolute inset-0 z-0 bg-gradient-to-b from-slate-900 via-slate-950 to-black flex items-center justify-center overflow-hidden">
                        <!-- Video Element for WebRTC Live Stream -->
                        <video class="live-stream-video w-full h-full object-cover @(reel.IsLive ? "" : "hidden")" autoplay playsinline muted loop></video>
                        
                        <!-- Fallback / Waiting Animated Card -->
                        <div class="live-stream-placeholder flex flex-col items-center justify-center text-center p-6 space-y-4 @(reel.IsLive ? "hidden" : "")">
                            <div class="w-20 h-20 rounded-3xl bg-red-600/20 text-red-500 border border-red-500/30 flex items-center justify-center shadow-2xl animate-pulse">
                                <i data-lucide="stethoscope" class="w-10 h-10"></i>
                            </div>
                            <div>
                                <h3 class="font-heading font-extrabold text-xl text-white">@reel.DoctorName</h3>
                                <p class="text-xs text-slate-400 mt-1">@reel.Specialty • @reel.Department</p>
                            </div>
                            @if (reel.ScheduledLiveAt.HasValue && !reel.IsLive)
                            {
                                <div class="px-4 py-2 rounded-2xl bg-slate-900 border border-amber-500/40 text-amber-400 text-xs font-bold tracking-wider" 
                                     data-scheduled-time="@reel.ScheduledLiveAt.Value.ToString("o")">
                                    Calculating countdown...
                                </div>
                            }
                            else
                            {
                                <div class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-700/60 text-slate-400 text-xs flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-slate-500"></span> Doctor currently offline
                                </div>
                            }
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60 pointer-events-none"></div>
                    </div>

                    <!-- Floating Audio Toggle Button (Top Right) -->
                    <button type="button" onclick="toggleReelAudio(this)" class="btn-toggle-audio absolute top-3 right-3 z-30 w-8 h-8 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-black/80 transition-all shadow-md" title="Mute/Unmute Audio">
                        <i data-lucide="volume-x" class="w-4 h-4"></i>
                    </button>

                    <!-- ===================== TOP OVERLAY ===================== -->
                    <div class="relative z-10 flex items-start justify-between pt-2 pr-10">
                        <div class="flex items-center gap-2.5">
                            <div class="w-10 h-10 rounded-full bg-red-600 border-2 border-white flex items-center justify-center font-bold text-xs text-white shadow">
                                @(reel.DoctorPhoto != null ? "" : "Dr")
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-white">@reel.DoctorName</h4>
                                    <span class="doctor-live-badge px-2 py-0.5 rounded-full bg-red-600 text-[10px] font-black uppercase tracking-wider flex items-center gap-1 shadow animate-pulse @(reel.IsLive ? "" : "hidden")">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span> LIVE
                                    </span>
                                </div>
                                <span class="text-[11px] text-slate-300">@reel.Specialty • @reel.ExperienceYears yrs exp</span>
                            </div>
                        </div>

                        <!-- Live Viewers Counter & Follow Button -->
                        <div class="flex flex-col items-end gap-1.5">
                            <span class="px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md text-white text-[11px] font-medium flex items-center gap-1.5 border border-white/10 shadow-lg">
                                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                                <i data-lucide="eye" class="w-3.5 h-3.5 text-red-400"></i>
                                <span class="viewer-count" data-doctor-id="@reel.DoctorId">@(reel.CurrentViewers > 0 ? reel.CurrentViewers : 1)</span>
                            </span>
                            <button type="button" onclick="handleFollowToggle(@reel.DoctorId, this)" class="px-2.5 py-0.5 rounded-full bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold tracking-wider uppercase transition-all shadow">
                                @(reel.IsFollowing ? "Following" : "+ Follow")
                            </button>
                        </div>
                    </div>

                    <!-- ===================== RIGHT ACTION COLUMN ===================== -->
                    <div class="absolute right-3 bottom-24 flex flex-col items-center gap-4 z-20">
                        <!-- Like Button -->
                        <button type="button" onclick="handleToggleReelLike(@(reel.StreamId ?? reel.DoctorId))" class="reel-like-btn flex flex-col items-center gap-1 text-white hover:text-red-500 transition-colors @(reel.HasLiked ? "text-red-500" : "")">
                            <div class="w-11 h-11 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                <i data-lucide="heart" class="w-5 h-5 @(reel.HasLiked ? "fill-current" : "")"></i>
                            </div>
                            <span class="like-count text-[11px] font-bold">@reel.TotalLikes</span>
                        </button>

                        <!-- Comment Button -->
                        <button type="button" onclick="focusChatInput()" class="flex flex-col items-center gap-1 text-white hover:text-blue-400 transition-colors">
                            <div class="w-11 h-11 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                <i data-lucide="message-square" class="w-5 h-5"></i>
                            </div>
                            <span class="text-[11px] font-bold">Chat</span>
                        </button>

                        <!-- Share Button -->
                        <button type="button" onclick="handleShareReel('@reel.EncryptedDoctorId')" class="flex flex-col items-center gap-1 text-white hover:text-emerald-400 transition-colors">
                            <div class="w-11 h-11 rounded-full bg-black/60 backdrop-blur-md border border-white/15 flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                <i data-lucide="share-2" class="w-5 h-5"></i>
                            </div>
                            <span class="text-[11px] font-bold">Share</span>
                        </button>

                        <!-- 1-to-1 Live Call / Chat Handoff -->
                        <button type="button" onclick="open1to1RequestSheet(@reel.DoctorId, '@reel.DoctorName', @reel.ConsultationFeePerMinute, @(reel.IsFreeConsultation ? "true" : "false"))" class="flex flex-col items-center gap-1 text-white hover:text-amber-400 transition-colors" title="Request 1-to-1 Consultation">
                            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-amber-500 to-red-600 border border-white/20 flex items-center justify-center shadow-lg active:scale-90 transition-transform animate-bounce">
                                <i data-lucide="phone-call" class="w-5 h-5 text-white"></i>
                            </div>
                            <span class="text-[10px] font-bold text-amber-400">1-to-1</span>
                        </button>
                    </div>

                    <!-- ===================== BOTTOM: FLOATING COMMENTS & INPUT BAR ===================== -->
                    <div class="relative z-10 space-y-2.5 w-[84%]">
                        <!-- Floating Live Pinned Health Tip / Medicine Advisory Banner -->
                        <div class="pinned-banner-box hidden relative z-20 p-2.5 rounded-2xl bg-black/85 backdrop-blur-md border border-amber-500/50 text-white shadow-2xl transition-all duration-300">
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex items-start gap-2 min-w-0 flex-1">
                                    <span class="pinned-banner-icon text-amber-400 text-base mt-0.5">💡</span>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span class="pinned-banner-type text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">PINNED ADVISORY</span>
                                            <span class="pinned-banner-med hidden text-[9px] font-bold px-1.5 py-0.5 rounded bg-red-500/20 text-red-300 border border-red-500/30"></span>
                                        </div>
                                        <p class="pinned-banner-text text-[11px] sm:text-xs text-slate-100 font-medium mt-1 leading-snug line-clamp-2"></p>
                                    </div>
                                </div>
                                <button type="button" onclick="dismissPinnedBannerLocally(this)" class="text-slate-400 hover:text-white p-1 transition-colors" title="Dismiss banner">
                                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Floating Live Comments Container (Latest 5 streamed real-time) -->
                        <div class="floating-comments-box flex flex-col gap-1.5 max-h-36 overflow-hidden">
                            <div class="flex items-center gap-1.5 text-xs text-white bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-xl border border-white/10">
                                <span class="font-bold text-red-400">System:</span>
                                <span class="text-slate-300">Welcome to @reel.DoctorName's stream!</span>
                            </div>
                        </div>

                        <!-- Bottom Input Bar -->
                        <form onsubmit="handleSendReelComment(event)" class="relative flex items-center">
                            @if (!isAuth)
                            {
                                <input type="text" id="reelChatInput" placeholder="🔒 Sign in to chat with doctor..." readonly
                                       onclick="checkGuestInteraction(event, 'chat')"
                                       class="w-full bg-black/60 backdrop-blur-md border border-white/20 text-white placeholder-slate-400 text-xs rounded-full py-2.5 pl-4 pr-10 outline-none cursor-pointer" />
                            }
                            else
                            {
                                <input type="text" id="reelChatInput" placeholder="Add a comment... (max 250 chars)" maxlength="250"
                                       class="w-full bg-black/60 backdrop-blur-md border border-white/20 text-white placeholder-slate-400 text-xs rounded-full py-2.5 pl-4 pr-10 outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-all" />
                            }
                            <button type="submit" class="absolute right-1.5 w-7 h-7 bg-red-600 hover:bg-red-700 text-white rounded-full flex items-center justify-center transition-all shadow">
                                <i data-lucide="send" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>

                </div>
                index++;
            }
        }
        else
        {
            <div id="noLiveDoctorsPlaceholder" class="h-full flex flex-col items-center justify-center p-8 text-center text-slate-400 space-y-4">
                <div class="w-16 h-16 rounded-3xl bg-slate-900 border border-slate-800 text-slate-500 flex items-center justify-center shadow-xl">
                    <i data-lucide="radio" class="w-8 h-8 text-slate-500"></i>
                </div>
                <div>
                    <h3 class="font-heading font-extrabold text-lg text-white">No Doctors Currently Live</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-xs leading-relaxed">
                        None of our verified doctors are currently broadcasting live. Streams appear here the moment a doctor goes live from their studio.
                    </p>
                </div>
                <div class="flex items-center gap-2.5 pt-2">
                    <a asp-controller="LiveChat" asp-action="Index" class="px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold shadow-lg shadow-red-600/30 flex items-center gap-1.5 transition-all">
                        <i data-lucide="bot" class="w-3.5 h-3.5"></i>
                        <span>Start AI Health Chat</span>
                    </a>
                    <button onclick="window.location.reload()" class="px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium border border-slate-700 transition-all flex items-center gap-1.5">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                        <span>Check Again</span>
                    </button>
                </div>
            </div>
        }

    </div>

    <!-- ===================== 1-TO-1 REQUEST MODAL ===================== -->
    <div id="request1to1Modal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-[999] hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-amber-500/50 rounded-3xl p-6 sm:p-7 max-w-sm w-full shadow-2xl relative text-center">
            <button onclick="close1to1Modal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <div class="w-14 h-14 bg-gradient-to-tr from-amber-500/20 to-red-500/20 text-amber-400 border border-amber-500/30 rounded-2xl mx-auto flex items-center justify-center mb-4">
                <i data-lucide="phone-call" class="w-7 h-7"></i>
            </div>
            <h3 class="font-heading font-extrabold text-lg text-white">1-to-1 Private Consultation</h3>
            <p id="targetDoctorInfo" class="text-xs text-slate-300 mt-1 font-semibold"></p>
            <div id="consultationPricingBadge" class="mt-2.5 inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
            </div>

            <!-- Pre-Request Notice -->
            <div id="requestInitialNotice" class="p-3 rounded-2xl bg-slate-950 border border-slate-800 text-slate-300 text-xs text-left space-y-1.5 mt-4">
                <div class="flex items-center gap-2 text-emerald-400 font-semibold text-[11px]">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                    <span>Fair Billing Guarantee</span>
                </div>
                <p class="text-[11px] leading-relaxed text-slate-400">
                    ⏱️ <strong>Timer will NOT start now.</strong> The timer and per-minute billing will begin strictly after the doctor accepts your request and connects.
                </p>
            </div>

            <!-- Waiting state after request is submitted -->
            <div id="requestWaitingState" class="hidden p-4 rounded-2xl bg-slate-950 border border-blue-500/40 text-center space-y-3 mt-4">
                <div class="flex items-center justify-center gap-2 text-blue-400 font-bold text-xs">
                    <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
                    <span>Waiting for Doctor to Accept...</span>
                </div>
                <p class="text-[11px] text-slate-400 leading-relaxed">
                    Request sent to doctor's studio screen. Please stay on this screen. Timer will begin only after acceptance.
                </p>
            </div>

            <div id="requestBtnWrapper" class="space-y-2 mt-5">
                <button type="button" id="btnSend1to1Request" onclick="submit1to1ConsultationRequest()" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-red-600 hover:from-amber-400 hover:to-red-500 text-white font-bold text-xs shadow-lg shadow-red-600/30 flex items-center justify-center gap-2 transition-all active:scale-95">
                    <i data-lucide="video" class="w-4 h-4"></i>
                    <span>Send Request to Doctor</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ===================== GUEST LOGIN BARRIER MODAL ===================== -->
    <div id="guestLoginBarrierModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[999] hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-red-500/40 rounded-3xl p-6 sm:p-8 max-w-sm w-full shadow-2xl relative text-center">
            <button onclick="closeGuestLoginModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <div class="w-14 h-14 bg-red-600/20 text-red-500 border border-red-500/30 rounded-2xl mx-auto flex items-center justify-center mb-4">
                <i data-lucide="lock" class="w-7 h-7"></i>
            </div>
            <h3 class="font-heading font-extrabold text-xl text-white">Member Access Required</h3>
            <p id="guestBarrierMessage" class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
                Please sign in to like, comment, or continue watching live doctor streams.
            </p>
            <div class="space-y-3 mt-6">
                <a asp-controller="Account" asp-action="Login" class="w-full py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm shadow-lg shadow-red-600/30 flex items-center justify-center gap-2 transition-all">
                    <span>Sign In Now</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
                <a asp-controller="Account" asp-action="Register" class="w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs flex items-center justify-center transition-all">
                    Create New Free Account
                </a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        window.isUserLoggedIn = @(isAuth ? "true" : "false");
        window.livekitServerUrl = "@ViewBag.ServerUrl";

        function focusChatInput() {
            if (checkGuestInteraction(null, 'chat')) {
                const input = document.getElementById('reelChatInput');
                if (input) input.focus();
            }
        }

        async function handleFollowToggle(doctorId, btn) {
            if (!checkGuestInteraction(null, 'follow doctors')) return;
            try {
                const res = await fetch('/api/livedoctor/toggle-follow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(doctorId)
                });
                const data = await res.json();
                if (data.success) {
                    btn.textContent = data.data ? "Following" : "+ Follow";
                }
            } catch (err) {
                console.error(err);
            }
        }

        function dismissPinnedBannerLocally(btn) {
            const box = btn.closest('.pinned-banner-box');
            if (box) box.classList.add('hidden');
        }

        function handleShareReel(encryptedId) {
            const url = window.location.origin + '/LiveDoctor?ref=' + encryptedId;
            navigator.clipboard.writeText(url).then(() => {
                alert('Stream link copied to clipboard!');
            }).catch(() => {
                prompt('Copy this stream link:', url);
            });
        }

        let target1to1DoctorId = null;
        let requestedConsultationId = null;

        function open1to1RequestSheet(docId, docName, rate, isFree) {
            if (!checkGuestInteraction(null, 'request 1-to-1 consultation with doctor')) return;

            target1to1DoctorId = docId;
            requestedConsultationId = null;

            document.getElementById('targetDoctorInfo').textContent = `Dr. ${docName}`;
            const badge = document.getElementById('consultationPricingBadge');
            badge.textContent = isFree ? "FREE Consultation" : `₹${rate}/min`;

            document.getElementById('requestInitialNotice').classList.remove('hidden');
            document.getElementById('requestWaitingState').classList.add('hidden');
            const btn = document.getElementById('btnSend1to1Request');
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="video" class="w-4 h-4"></i><span>Send Request to Doctor</span>';
            btn.classList.remove('hidden');

            document.getElementById('request1to1Modal').classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function close1to1Modal() {
            document.getElementById('request1to1Modal').classList.add('hidden');
            target1to1DoctorId = null;
            requestedConsultationId = null;
        }

        async function submit1to1ConsultationRequest() {
            if (!target1to1DoctorId) return;

            const btn = document.getElementById('btnSend1to1Request');
            btn.disabled = true;
            btn.innerHTML = '<span>Sending Request...</span>';

            try {
                const res = await fetch('/api/consultation/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ doctorId: target1to1DoctorId })
                });

                const data = await res.json();
                if (data.success) {
                    requestedConsultationId = data.data;
                    document.getElementById('requestInitialNotice').classList.add('hidden');
                    document.getElementById('requestWaitingState').classList.remove('hidden');
                    btn.classList.add('hidden');
                } else {
                    alert(data.message || 'Unable to request consultation. Please check your wallet balance.');
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="video" class="w-4 h-4"></i><span>Send Request to Doctor</span>';
                    if (window.lucide) lucide.createIcons();
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="video" class="w-4 h-4"></i><span>Send Request to Doctor</span>';
                if (window.lucide) lucide.createIcons();
            }
        }

        // Global listener for ConsultationAccepted from SignalR
        window.handleConsultationAcceptedByDoctor = function (payload) {
            if (requestedConsultationId && payload.consultationId == requestedConsultationId) {
                // Doctor has accepted! Transition patient to 1-to-1 session!
                window.location.href = `/LiveChat?doctorId=${payload.doctorId}&consultationId=${payload.consultationId}`;
            }
        };
    </script>
    <script src="~/js/live-reel-player.js" asp-append-version="true"></script>
}

@model IEnumerable<CYHDocG.Repo.DTOs.PrescriptionHeaderDto>
@{
    ViewData["Title"] = "My Prescriptions & Dose Reminders";
    var todayDoses = ViewBag.TodayDoses as List<CYHDocG.Repo.DTOs.DoseReminderItemDto> ?? new List<CYHDocG.Repo.DTOs.DoseReminderItemDto>();
    var morningDoses = todayDoses.Where(d => d.Slot == "Morning").ToList();
    var afternoonDoses = todayDoses.Where(d => d.Slot == "Afternoon").ToList();
    var nightDoses = todayDoses.Where(d => d.Slot == "Night").ToList();
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Prescriptions &amp; Dose Alarms</h1>
            <p class="text-xs text-slate-400 mt-1">Track real-time medicine dosage timings ('1-0-1') and refill reorder alerts.</p>
        </div>
    </div>

    <!-- Daily Dose Schedule Banner (Live DB Reminders) -->
    <div class="bg-gradient-to-r from-red-950/40 via-slate-900 to-slate-900 border border-red-500/20 rounded-3xl p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <h3 class="font-heading font-bold text-sm text-white uppercase tracking-wider">Today's Dose Timeline</h3>
            </div>
            <span class="text-[11px] text-slate-400">@todayDoses.Count(d => d.Status == "Pending") Pending Today</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @{
                var doseSlots = new[]
                {
                    (Title: "Morning Dose (08:00 AM)", Icon: "☀️", BadgeClass: "bg-amber-500/10 text-amber-400 border-amber-500/20", EmptyText: "No morning doses scheduled", Items: morningDoses),
                    (Title: "Afternoon Dose (01:00 PM)", Icon: "🌤️", BadgeClass: "bg-blue-500/10 text-blue-400 border-blue-500/20", EmptyText: "No afternoon doses scheduled", Items: afternoonDoses),
                    (Title: "Night Dose (08:30 PM)", Icon: "🌙", BadgeClass: "bg-purple-500/10 text-purple-400 border-purple-500/20", EmptyText: "No night doses scheduled", Items: nightDoses)
                };
            }
            @foreach (var slot in doseSlots)
            {
                <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-4 space-y-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl border flex items-center justify-center font-bold text-xs flex-shrink-0 @slot.BadgeClass">
                            @slot.Icon
                        </div>
                        <div>
                            <span class="text-xs font-bold text-white block">@slot.Title</span>
                            <span class="text-[11px] text-slate-400">@slot.Items.Count medicine(s)</span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        @if (slot.Items.Any())
                        {
                            foreach (var d in slot.Items)
                            {
                                <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="text-xs font-semibold text-white truncate">@d.MedicineName</div>
                                        <div class="text-[10px] text-slate-400">@(d.TimingInstruction ?? "As directed")</div>
                                    </div>
                                    <button type="button" onclick="toggleDoseTaken(@d.ReminderId, '@(d.Status == "Taken" ? "Pending" : "Taken")', this)"
                                            class="px-2.5 py-1 rounded-lg text-[10px] font-bold flex-shrink-0 transition-all @(d.Status == "Taken" ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" : "bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white border border-slate-700")">
                                        @(d.Status == "Taken" ? "✓ Taken" : "Mark Taken")
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-[11px] text-slate-500 italic">@slot.EmptyText</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Prescriptions List -->
    <div class="space-y-4">
        <h3 class="font-heading font-bold text-base text-white">Issued Prescriptions</h3>

        @if (Model != null && Model.Any())
        {
            foreach (var rx in Model)
            {
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-blue-600/20 text-blue-400 flex items-center justify-center font-bold text-xs">
                                Rx
                            </div>
                            <div>
                                <h4 class="font-heading font-bold text-sm text-white">Prescription by @rx.DoctorName</h4>
                                <span class="text-xs text-slate-400">@rx.Specialty • Issued on @rx.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(rx.CompressedFileUrl))
                        {
                            <a href="@rx.CompressedFileUrl" target="_blank" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 border border-slate-700 flex items-center gap-1.5 transition-all self-start sm:self-auto">
                                <i data-lucide="file-down" class="w-3.5 h-3.5"></i>
                                View Slip
                            </a>
                        }
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var med in rx.Medicines)
                        {
                            <div class="bg-slate-950 border border-slate-800/80 rounded-2xl p-4 flex items-center justify-between">
                                <div>
                                    <h5 class="font-heading font-bold text-xs sm:text-sm text-white">@med.MedicineName</h5>
                                    <span class="text-[11px] text-slate-400">Dosage: <strong class="text-slate-200">@med.DosageSchedule</strong> (@med.TimingInstruction)</span>
                                    <div class="text-[10px] text-slate-400 mt-1">Course ends: @med.CourseEndDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="text-right">
                                    <span class="px-2.5 py-1 rounded-full bg-red-600/20 border border-red-500/30 text-red-400 text-[10px] font-bold block">
                                        Refill Alert: @med.RefillAlertDate.ToString("dd MMM")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(rx.DoctorNotes))
                    {
                        <div class="text-xs text-slate-400 bg-slate-950/60 p-3 rounded-xl border border-slate-800/60">
                            <strong class="text-slate-300">Doctor Advice:</strong> @rx.DoctorNotes
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center text-slate-400">
                <i data-lucide="file-text" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
                <h4 class="font-heading font-bold text-base text-white">No Active Prescriptions Found</h4>
                <p class="text-xs text-slate-400 mt-1">Your doctor will upload or generate prescriptions during your consultations.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function toggleDoseTaken(reminderId, nextStatus, btn) {
            if (!reminderId) return;
            btn.disabled = true;
            try {
                const res = await fetch(`/api/prescriptions/reminders/${reminderId}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(nextStatus)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message || 'Unable to update dose status');
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
            }
        }
    </script>
}

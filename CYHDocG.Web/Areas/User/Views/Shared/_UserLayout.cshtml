@inject IWalletRepository WalletRepo
@{
    var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    decimal walletBal = 0.00m;
    if (long.TryParse(userIdClaim, out long uId))
    {
        var wallet = await WalletRepo.GetBalanceAsync(uId);
        walletBal = wallet?.Balance ?? 0.00m;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patient Portal | CYHDocGuru</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/theme/assets/style.css" asp-append-version="true" />
    
    <!-- Tailwind CSS Play Engine -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#dc2626',
                        secondary: '#0f172a',
                        accent: '#0ea5e9'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body class="bg-slate-950 font-body text-slate-100 flex min-h-screen">

    <div id="userBackdrop" onclick="toggleUserSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden"></div>

    <!-- User Sidebar -->
    <aside id="userSidebar" class="fixed top-0 bottom-0 left-0 w-64 bg-slate-900 border-r border-slate-800 z-50 flex flex-col transition-transform duration-300 transform -translate-x-full md:translate-x-0">
        <div class="h-16 flex items-center gap-3 px-6 border-b border-slate-800">
            <div class="w-9 h-9 bg-red-600 rounded-xl flex items-center justify-center shadow-lg shadow-red-600/30">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7" cy="5" r="1.5" fill="white" stroke="none" />
                    <circle cx="13" cy="5" r="1.5" fill="white" stroke="none" />
                    <path d="M7 6.5 C7 9.5 8.5 12 10 12 C11.5 12 13 9.5 13 6.5" />
                    <path d="M10 12 v2.5 C10 18.5 13.5 21 16.5 19.5 C18 18.8 18.5 17 18.5 15 v-1.5" />
                    <circle cx="18.5" cy="11.5" r="2.8" stroke-width="2" fill="white" fill-opacity="0.25" />
                    <circle cx="18.5" cy="11.5" r="1" fill="white" stroke="none" />
                </svg>
            </div>
            <div>
                <span class="font-heading font-extrabold text-base text-white">CYHDOC <span class="text-red-500">Guru</span></span>
                <span class="block text-[10px] text-red-400 font-bold tracking-widest uppercase">Patient Portal</span>
            </div>
        </div>

        <!-- Wallet Quick Card in Sidebar -->
        <div class="p-4 mx-4 my-4 bg-gradient-to-br from-red-950/60 to-slate-900 border border-red-500/20 rounded-2xl">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span>My Wallet</span>
                <i data-lucide="wallet" class="w-3.5 h-3.5 text-red-400"></i>
            </div>
            <div class="font-heading font-bold text-xl text-white">₹@walletBal.ToString("N2")</div>
            <button onclick="openWalletTopUpModal()" class="w-full mt-2.5 py-1.5 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-semibold text-xs transition-all flex items-center justify-center gap-1.5 shadow-md shadow-red-600/20">
                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                Add Money
            </button>
        </div>

        <nav class="flex-1 px-4 space-y-1.5 overflow-y-auto">
            <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-red-600 text-white shadow-lg shadow-red-600/20" : "text-slate-400 hover:text-white hover:bg-slate-800/60")">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                Dashboard
            </a>
            <a asp-area="" asp-controller="LiveDoctor" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="tv" class="w-4 h-4"></i>
                LIVE DOCTOR Reels
            </a>
            <a asp-area="" asp-controller="LiveChat" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="bot" class="w-4 h-4"></i>
                LIVE Chat & AI Triage
            </a>
            <a href="javascript:void(0)" onclick="openWalletTopUpModal()" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="wallet" class="w-4 h-4"></i>
                Wallet & Passbook
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="file-text" class="w-4 h-4"></i>
                My Prescriptions
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="clock" class="w-4 h-4"></i>
                Dose Reminders
            </a>
        </nav>

        <div class="p-4 border-t border-slate-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center font-bold text-red-500">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-white truncate">@(User.Identity?.Name ?? "Patient")</p>
                        <span class="text-[10px] text-slate-400">Standard Account</span>
                    </div>
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="p-2 text-slate-400 hover:text-red-400 hover:bg-slate-800 rounded-lg transition-all" title="Logout">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">
        <header class="h-16 bg-slate-900/80 backdrop-blur-md border-b border-slate-800 px-4 sm:px-8 flex items-center justify-between sticky top-0 z-30">
            <button onclick="toggleUserSidebar()" class="md:hidden p-2 text-slate-400 hover:text-white rounded-lg">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
            <div class="font-heading font-semibold text-slate-200 text-sm hidden sm:block">
                @ViewData["Title"]
            </div>
            <div class="flex items-center gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors">
                    <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                    Public Portal
                </a>
            </div>
        </header>

        <main class="flex-1 p-4 sm:p-8">
            @RenderBody()
        </main>
    </div>

    <!-- Top-Up Wallet Modal -->
    <div id="walletTopUpModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-sm w-full shadow-2xl relative">
            <button onclick="closeWalletTopUpModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <div class="text-center mb-5">
                <div class="w-12 h-12 bg-red-600/20 text-red-500 rounded-2xl mx-auto flex items-center justify-center mb-3">
                    <i data-lucide="credit-card" class="w-6 h-6"></i>
                </div>
                <h3 class="font-heading font-bold text-lg text-white">Top-Up Wallet</h3>
                <p class="text-xs text-slate-400 mt-1">Add credits for 1-to-1 live doctor consultations.</p>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="text-xs text-slate-400 uppercase font-semibold">Enter Amount (INR)</label>
                    <input type="number" id="topUpAmount" value="500" min="50" step="50" class="w-full mt-1.5 px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-heading font-bold text-lg outline-none focus:border-red-500" />
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="document.getElementById('topUpAmount').value = 200" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 rounded-lg">+₹200</button>
                    <button type="button" onclick="document.getElementById('topUpAmount').value = 500" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 rounded-lg">+₹500</button>
                    <button type="button" onclick="document.getElementById('topUpAmount').value = 1000" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 rounded-lg">+₹1000</button>
                </div>
                <button type="button" onclick="executeWalletTopUp()" class="w-full py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-sm shadow-lg shadow-red-600/30 transition-all">
                    Proceed to Add Funds
                </button>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
        function toggleUserSidebar() {
            const sidebar = document.getElementById('userSidebar');
            const backdrop = document.getElementById('userBackdrop');
            sidebar.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }
        function openWalletTopUpModal() {
            document.getElementById('walletTopUpModal').classList.remove('hidden');
        }
        function closeWalletTopUpModal() {
            document.getElementById('walletTopUpModal').classList.add('hidden');
        }
        async function executeWalletTopUp() {
            const amount = parseFloat(document.getElementById('topUpAmount').value);
            if (!amount || amount <= 0) return alert('Please enter valid amount');
            try {
                const res = await fetch('/api/wallet/topup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount: amount, referenceId: 'TXN_' + Date.now() })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Wallet topped up successfully! New Balance: ₹' + data.data);
                    window.location.reload();
                } else {
                    alert(data.message || 'Top-up failed');
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

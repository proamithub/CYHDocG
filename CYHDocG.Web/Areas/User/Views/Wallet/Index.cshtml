@model List<CYHDocG.Repo.DTOs.WalletTransactionDto>
@{
    ViewData["Title"] = "My Wallet & Passbook";
    decimal balance = ViewBag.WalletBalance ?? 0.00m;
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Patient Wallet & Passbook</h1>
            <p class="text-xs text-slate-400 mt-1">Manage credits for 1-to-1 live doctor video consultations & check billing history.</p>
        </div>
    </div>

    <!-- Wallet Top-Up & Balance Banner -->
    <div class="bg-gradient-to-r from-red-950/50 via-slate-900 to-slate-900 border border-red-500/20 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Available Consultation Balance</span>
            <div class="font-heading font-black text-3xl sm:text-4xl text-emerald-400">₹@balance.ToString("N2")</div>
            <p class="text-xs text-slate-400 mt-2 max-w-sm">
                Funds are automatically deducted according to the consultation timer only when you talk to a doctor.
            </p>
        </div>

        <div class="w-full md:w-auto bg-slate-950/80 border border-slate-800 rounded-2xl p-4 space-y-3">
            <span class="text-xs font-semibold text-slate-300 block">Quick Top-Up Credits</span>
            <div class="flex gap-2">
                <button type="button" onclick="quickTopUp(200)" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white border border-slate-700 transition-all">+₹200</button>
                <button type="button" onclick="quickTopUp(500)" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white border border-slate-700 transition-all">+₹500</button>
                <button type="button" onclick="quickTopUp(1000)" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white border border-slate-700 transition-all">+₹1000</button>
            </div>
            <button type="button" onclick="openWalletTopUpModal()" class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-md shadow-red-600/30 flex items-center justify-center gap-1.5 active:scale-95 transition-all">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Custom Top-Up</span>
            </button>
        </div>
    </div>

    <!-- Passbook Statement -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <h3 class="font-heading font-bold text-base text-white">Wallet Passbook & Billing History</h3>
            <span class="text-xs text-slate-400">@Model.Count Transactions Recorded</span>
        </div>

        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-slate-800/80">
                        <th class="pb-3 font-semibold">Date & Time</th>
                        <th class="pb-3 font-semibold">Description</th>
                        <th class="pb-3 font-semibold">Reference ID</th>
                        <th class="pb-3 font-semibold">Type</th>
                        <th class="pb-3 font-semibold">Amount</th>
                        <th class="pb-3 font-semibold text-right">Balance After</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-200">
                    @if (Model.Any())
                    {
                        foreach (var tx in Model)
                        {
                            <tr class="hover:bg-slate-950/40">
                                <td class="py-3 text-slate-400">@tx.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="py-3 font-medium text-white">@tx.Description</td>
                                <td class="py-3 text-slate-400 font-mono text-[11px]">@(tx.ReferenceId ?? "-")</td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase @(tx.Type == "Credit" ? "bg-emerald-500/20 text-emerald-400" : "bg-red-500/20 text-red-400")">
                                        @tx.Type
                                    </span>
                                </td>
                                <td class="py-3 font-mono font-bold @(tx.Type == "Credit" ? "text-emerald-400" : "text-red-400")">
                                    @(tx.Type == "Credit" ? "+" : "-")₹@tx.Amount.ToString("N2")
                                </td>
                                <td class="py-3 text-right font-mono text-slate-300">₹@tx.BalanceAfter.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-slate-500">No transactions recorded yet. Top up your wallet to start.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function quickTopUp(amt) {
            try {
                const res = await fetch('/api/wallet/topup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount: amt, referenceId: 'TXN_' + Date.now() })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`₹${amt} added to wallet successfully! New Balance: ₹${data.data}`);
                    window.location.reload();
                } else {
                    alert(data.message || 'Top-up failed');
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}

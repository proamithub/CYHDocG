@{
    ViewData["Title"] = "Patient Dashboard";
    decimal walletBal = ViewBag.WalletBalance ?? 0.00m;
}

<div class="space-y-6">
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-red-950/40 via-slate-900 to-slate-900 border border-red-500/20 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> Care 24/7 Active
            </span>
            <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-white">Welcome back, @(User.Identity?.Name ?? "Patient")</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-xl">
                Connect with live specialists, start AI symptom triage, check active prescriptions and refill reminders.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-area="" asp-controller="LiveDoctor" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-red-600/30 transition-all active:scale-[0.98]">
                <i data-lucide="tv" class="w-4 h-4"></i>
                <span>Watch LIVE Doctors</span>
            </a>
            <a asp-area="" asp-controller="LiveChat" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-xs sm:text-sm border border-slate-700 transition-all flex items-center gap-2">
                <i data-lucide="bot" class="w-4 h-4 text-red-400"></i>
                <span>AI Health Chat</span>
            </a>
        </div>
    </div>

    <!-- Quick Patient Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Wallet Card -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-medium uppercase tracking-wider">Wallet Balance</span>
                <button onclick="openWalletTopUpModal()" class="text-xs text-red-400 hover:text-red-300 font-semibold flex items-center gap-1">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add
                </button>
            </div>
            <div class="font-heading font-bold text-2xl text-emerald-400">₹@walletBal.ToString("N2")</div>
            <span class="text-xs text-slate-400 flex items-center gap-1 mt-1">
                Available for 1-to-1 doctor calls
            </span>
        </div>

        <!-- Prescriptions -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Active Prescriptions</div>
            <div class="font-heading font-bold text-2xl text-white">2</div>
            <span class="text-xs text-purple-400 flex items-center gap-1 mt-1">
                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Dosage schedules active
            </span>
        </div>

        <!-- Today Reminders -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Doses Due Today</div>
            <div class="font-heading font-bold text-2xl text-amber-400">3</div>
            <span class="text-xs text-slate-400 flex items-center gap-1 mt-1">
                <i data-lucide="clock" class="w-3.5 h-3.5"></i> Next dose: 08:30 PM (After meal)
            </span>
        </div>

        <!-- Refill Alerts -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Refill Alerts</div>
            <div class="font-heading font-bold text-2xl text-red-400">1</div>
            <span class="text-xs text-red-400 flex items-center gap-1 mt-1">
                <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i> Pan-D ends in 2 days
            </span>
        </div>
    </div>
</div>

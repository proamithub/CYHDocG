@model List<CYHDocG.Repo.DTOs.DoctorSearchDto>
@{
    ViewData["Title"] = "Multi-Party Platform Ledger & Service Pricing";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Platform Ledger & Doctor Pricing</h1>
            <p class="text-xs text-slate-400 mt-1">Configure Free vs Paid doctor consultation rates and inspect multi-party ledger settlement.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold flex items-center gap-2">
            <i data-lucide="check-circle" class="w-4 h-4"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Financial KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Gross Consultation Volume</span>
            <div class="font-heading font-bold text-2xl text-white">₹2,44,600</div>
            <span class="text-[11px] text-slate-400 flex items-center gap-1 mt-1">
                <i data-lucide="arrow-up-right" class="w-3.5 h-3.5 text-emerald-400"></i> Lifetime Billed
            </span>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Platform Net Revenue (20%)</span>
            <div class="font-heading font-bold text-2xl text-emerald-400">₹48,920</div>
            <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1 mt-1">
                Retained Gross Margin
            </span>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Doctor Payout Balance (80%)</span>
            <div class="font-heading font-bold text-2xl text-blue-400">₹1,95,680</div>
            <span class="text-[11px] text-slate-400 flex items-center gap-1 mt-1">
                Credited to Doctor Wallets
            </span>
        </div>
    </div>

    <!-- Doctor Service Pricing Controls Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
                <h3 class="font-heading font-bold text-base text-white">Doctor Service Pricing Management</h3>
                <p class="text-xs text-slate-400">Set whether a doctor's live 1-to-1 consultation is Free or Paid per minute.</p>
            </div>
            <span class="text-xs text-slate-400">@Model.Count Doctor(s) Registered</span>
        </div>

        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-slate-800/80">
                        <th class="pb-3 font-semibold">Doctor Details</th>
                        <th class="pb-3 font-semibold">Department</th>
                        <th class="pb-3 font-semibold">Service Mode</th>
                        <th class="pb-3 font-semibold">Rate Per Minute (INR)</th>
                        <th class="pb-3 font-semibold text-right">Update</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-200">
                    @if (Model.Any())
                    {
                        foreach (var doc in Model)
                        {
                            <tr class="hover:bg-slate-950/40">
                                <td class="py-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center font-bold text-xs">
                                            Dr
                                        </div>
                                        <div>
                                            <span class="font-bold text-white block">@doc.DoctorName</span>
                                            <span class="text-[11px] text-slate-400">@doc.Specialty</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 text-slate-300">@doc.Department</td>
                                <form asp-area="Admin" asp-controller="Ledger" asp-action="UpdatePricing" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                    <td class="py-3">
                                        <select name="isFree" class="bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-1.5 text-xs text-slate-200 outline-none">
                                            <option value="false" selected="@(!doc.IsFreeConsultation)">Paid Consultation</option>
                                            <option value="true" selected="@(doc.IsFreeConsultation)">Free Consultation</option>
                                        </select>
                                    </td>
                                    <td class="py-3">
                                        <div class="flex items-center gap-1">
                                            <span class="text-slate-400 font-mono">₹</span>
                                            <input type="number" name="feePerMinute" value="@doc.ConsultationFeePerMinute" min="0" step="5" class="w-24 bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-1.5 text-xs text-white font-mono outline-none focus:border-red-500" />
                                            <span class="text-slate-400 text-[10px]">/ min</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-right">
                                        <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs shadow-md shadow-red-600/30 transition-all active:scale-95">
                                            Save
                                        </button>
                                    </td>
                                </form>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-6 text-center text-slate-500">No doctors registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | CYHDocGuru</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/theme/assets/style.css" asp-append-version="true" />
    
    <!-- Tailwind CSS Play Engine -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#dc2626',
                        secondary: '#0f172a',
                        accent: '#0ea5e9'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Outfit', 'sans-serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body class="bg-slate-950 font-body text-slate-100 flex min-h-screen">

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebarBackdrop" onclick="toggleAdminSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden"></div>

    <!-- Sidebar -->
    <aside id="adminSidebar" class="fixed top-0 bottom-0 left-0 w-64 bg-slate-900 border-r border-slate-800 z-50 flex flex-col transition-transform duration-300 transform -translate-x-full md:translate-x-0">
        <!-- Brand -->
        <div class="h-16 flex items-center gap-3 px-6 border-b border-slate-800">
            <div class="w-9 h-9 bg-red-600 rounded-xl flex items-center justify-center shadow-lg shadow-red-600/30">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7" cy="5" r="1.5" fill="white" stroke="none" />
                    <circle cx="13" cy="5" r="1.5" fill="white" stroke="none" />
                    <path d="M7 6.5 C7 9.5 8.5 12 10 12 C11.5 12 13 9.5 13 6.5" />
                    <path d="M10 12 v2.5 C10 18.5 13.5 21 16.5 19.5 C18 18.8 18.5 17 18.5 15 v-1.5" />
                    <circle cx="18.5" cy="11.5" r="2.8" stroke-width="2" fill="white" fill-opacity="0.25" />
                    <circle cx="18.5" cy="11.5" r="1" fill="white" stroke="none" />
                </svg>
            </div>
            <div>
                <span class="font-heading font-extrabold text-base text-white">CYHDOC <span class="text-red-500">Guru</span></span>
                <span class="block text-[10px] text-red-400 font-bold tracking-widest uppercase">Admin Desk</span>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-red-600 text-white shadow-lg shadow-red-600/20" : "text-slate-400 hover:text-white hover:bg-slate-800/60")">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                Dashboard
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="user-check" class="w-4 h-4"></i>
                Doctors & Approvals
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="badge-dollar-sign" class="w-4 h-4"></i>
                Free / Paid Services
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="wallet" class="w-4 h-4"></i>
                Platform Ledger
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="bell" class="w-4 h-4"></i>
                Medicine Alerts
            </a>
            <a href="javascript:void(0)" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all">
                <i data-lucide="shield-alert" class="w-4 h-4"></i>
                Security & Anti-Inspect
            </a>
        </nav>

        <!-- Admin Profile & Logout -->
        <div class="p-4 border-t border-slate-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center font-bold text-red-500">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-white truncate">@(User.Identity?.Name ?? "Administrator")</p>
                        <span class="text-[10px] text-slate-400">Super Admin</span>
                    </div>
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="p-2 text-slate-400 hover:text-red-400 hover:bg-slate-800 rounded-lg transition-all" title="Logout">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content wrapper -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">
        <!-- Top Navigation Bar -->
        <header class="h-16 bg-slate-900/80 backdrop-blur-md border-b border-slate-800 px-4 sm:px-8 flex items-center justify-between sticky top-0 z-30">
            <button onclick="toggleAdminSidebar()" class="md:hidden p-2 text-slate-400 hover:text-white rounded-lg">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
            <div class="font-heading font-semibold text-slate-200 text-sm hidden sm:block">
                @ViewData["Title"]
            </div>
            <div class="flex items-center gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors">
                    <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                    View Public Site
                </a>
            </div>
        </header>

        <!-- Main Body -->
        <main class="flex-1 p-4 sm:p-8">
            @RenderBody()
        </main>
    </div>

    <script>
        lucide.createIcons();
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model List<CYHDocG.Repo.DTOs.DoctorAdminListDto>
@{
    ViewData["Title"] = "Doctors & Approvals Management";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Doctors & Verification Desk</h1>
            <p class="text-xs text-slate-400 mt-1">Approve registered medical practitioners, set consultation rates and oversee live availability.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300">
                Total Doctors: <strong class="text-white">@Model.Count</strong>
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center gap-2">
            <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Doctors Table Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
            <h3 class="font-heading font-bold text-sm text-white">Registered Doctors Roster</h3>
            <span class="text-xs text-slate-400">@Model.Count(d => d.IsApproved) Approved / @Model.Count(d => !d.IsApproved) Pending</span>
        </div>

        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-slate-800/80 bg-slate-950/40">
                        <th class="py-3.5 px-4 font-semibold">Doctor Details</th>
                        <th class="py-3.5 px-4 font-semibold">Specialty & Dept</th>
                        <th class="py-3.5 px-4 font-semibold">Experience</th>
                        <th class="py-3.5 px-4 font-semibold">Pricing / Min</th>
                        <th class="py-3.5 px-4 font-semibold">Live Status</th>
                        <th class="py-3.5 px-4 font-semibold">Approval</th>
                        <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-200">
                    @if (Model.Any())
                    {
                        foreach (var doc in Model)
                        {
                            <tr class="hover:bg-slate-950/40 transition-colors">
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/20 flex items-center justify-center font-bold text-xs flex-shrink-0">
                                            Dr
                                        </div>
                                        <div>
                                            <div class="font-bold text-white text-sm">@doc.FullName</div>
                                            <div class="text-slate-400 text-[11px]">@doc.Email</div>
                                            @if (!string.IsNullOrEmpty(doc.Phone))
                                            {
                                                <div class="text-slate-500 text-[10px]">📞 @doc.Phone</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="font-semibold text-white block">@doc.Specialty</span>
                                    <span class="text-slate-400 text-[11px]">@doc.Department</span>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="text-slate-300">@doc.ExperienceYears yrs exp</span>
                                    <span class="block text-[11px] text-slate-500">@doc.Qualification</span>
                                </td>
                                <td class="py-4 px-4">
                                    @if (doc.IsFreeConsultation)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            FREE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-white font-mono">₹@doc.ConsultationFeePerMinute.ToString("N2")</span>
                                        <span class="text-slate-400 text-[10px]">/min</span>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    @if (doc.IsLive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                                            LIVE NOW
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold text-slate-500 bg-slate-800">
                                            Offline
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    @if (doc.IsApproved)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            <i data-lucide="check" class="w-3 h-3"></i> Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            <i data-lucide="clock" class="w-3 h-3"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <form asp-area="Admin" asp-controller="Doctors" asp-action="ToggleApproval" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                            <input type="hidden" name="isApproved" value="@(!doc.IsApproved)" />
                                            <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(doc.IsApproved ? "bg-amber-600/20 text-amber-300 hover:bg-amber-600/30 border border-amber-500/30" : "bg-emerald-600 text-white hover:bg-emerald-700 shadow-md shadow-emerald-600/20")">
                                                @(doc.IsApproved ? "Revoke" : "Approve")
                                            </button>
                                        </form>

                                        <button type="button" onclick="openPricingModal(@doc.DoctorId, '@doc.FullName', @doc.ConsultationFeePerMinute, '@doc.IsFreeConsultation.ToString().ToLower()')" class="p-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition-all" title="Edit Pricing">
                                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-500">
                                No doctors registered yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Pricing Modal -->
<div id="pricingModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
        <button onclick="closePricingModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
        <h3 class="font-heading font-extrabold text-lg text-white mb-1">Set Doctor Pricing</h3>
        <p id="modalDocName" class="text-xs text-slate-400 mb-6"></p>

        <form asp-area="Admin" asp-controller="Doctors" asp-action="UpdatePricing" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalDoctorId" name="doctorId" value="0" />

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Service Pricing Type</label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex items-center gap-2 p-3 rounded-2xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700">
                        <input type="radio" id="pricingTypePaid" name="isFree" value="false" class="text-red-600 focus:ring-0" />
                        <span class="text-xs text-white font-medium">Paid Service</span>
                    </label>
                    <label class="flex items-center gap-2 p-3 rounded-2xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700">
                        <input type="radio" id="pricingTypeFree" name="isFree" value="true" class="text-red-600 focus:ring-0" />
                        <span class="text-xs text-emerald-400 font-medium">100% Free</span>
                    </label>
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Consultation Fee (₹ per Minute)</label>
                <input type="number" step="0.50" min="0" id="modalFeeInput" name="feePerMinute" class="w-full px-4 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-white text-sm outline-none focus:border-red-500 font-mono" />
            </div>

            <div class="pt-2 flex gap-3">
                <button type="button" onclick="closePricingModal()" class="flex-1 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">Cancel</button>
                <button type="submit" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold shadow-lg shadow-red-600/30">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openPricingModal(id, name, fee, isFree) {
            document.getElementById('modalDoctorId').value = id;
            document.getElementById('modalDocName').textContent = 'Updating consultation rates for ' + name;
            document.getElementById('modalFeeInput').value = fee;
            if (isFree === 'true') {
                document.getElementById('pricingTypeFree').checked = true;
            } else {
                document.getElementById('pricingTypePaid').checked = true;
            }
            document.getElementById('pricingModal').classList.remove('hidden');
        }

        function closePricingModal() {
            document.getElementById('pricingModal').classList.add('hidden');
        }
    </script>
}

@model List<CYHDocG.Repo.DTOs.MasterMedicineDto>
@{
    ViewData["Title"] = "Master Medicine Catalog";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Master Medicines Catalog</h1>
            <p class="text-xs text-slate-400 mt-1">Manage medicines used for fast 3-4 letter autocomplete in smart prescription generator.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="openAddMedicineModal()" class="px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs flex items-center gap-2 shadow-lg shadow-red-600/30 transition-all active:scale-95">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Add Medicine</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold flex items-center gap-2">
            <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Search bar -->
    <form method="get" class="flex items-center gap-3">
        <div class="relative flex-1">
            <i data-lucide="search" class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" name="q" value="@ViewBag.SearchTerm" placeholder="Search medicines by brand or generic name..." 
                   class="w-full pl-11 pr-4 py-3 rounded-2xl bg-slate-900 border border-slate-800 text-white text-xs placeholder-slate-400 outline-none focus:border-red-500" />
        </div>
        <button type="submit" class="px-5 py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition-all">
            Search
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
        {
            <a asp-action="Index" class="px-4 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-400 text-xs font-medium border border-slate-800 transition-all">Clear</a>
        }
    </form>

    <!-- Medicines Table Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
            <h3 class="font-heading font-bold text-sm text-white">Catalog List</h3>
            <span class="text-xs text-slate-400">Showing @Model.Count medicines</span>
        </div>

        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-slate-800/80 bg-slate-950/40">
                        <th class="py-3.5 px-4 font-semibold">Brand Name</th>
                        <th class="py-3.5 px-4 font-semibold">Generic Composition</th>
                        <th class="py-3.5 px-4 font-semibold">Dosage Form</th>
                        <th class="py-3.5 px-4 font-semibold">Strength</th>
                        <th class="py-3.5 px-4 font-semibold">Manufacturer</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-200">
                    @if (Model.Any())
                    {
                        foreach (var med in Model)
                        {
                            <tr class="hover:bg-slate-950/40 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-white text-sm">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-lg bg-red-600/10 text-red-400 flex items-center justify-center">
                                            <i data-lucide="pill" class="w-3.5 h-3.5"></i>
                                        </div>
                                        <span>@med.BrandName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-slate-300">
                                    @(med.GenericName ?? "-")
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                                        @med.DosageForm
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 font-mono text-slate-300">
                                    @(med.Strength ?? "-")
                                </td>
                                <td class="py-3.5 px-4 text-slate-400">
                                    @(med.Manufacturer ?? "-")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-500">
                                No medicines found matching your search.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Medicine Modal -->
<div id="addMedicineModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative">
        <button onclick="closeAddMedicineModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
        <h3 class="font-heading font-extrabold text-lg text-white mb-1">Add Master Medicine</h3>
        <p class="text-xs text-slate-400 mb-6">This medicine will immediately appear in doctor's autocomplete suggestion.</p>

        <form asp-area="Admin" asp-controller="Medicines" asp-action="Add" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Brand / Commercial Name *</label>
                <input type="text" name="BrandName" required placeholder="e.g. Paracetamol 650, Pan-D" class="w-full px-4 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-red-500" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Generic Composition</label>
                <input type="text" name="GenericName" placeholder="e.g. Acetaminophen, Pantoprazole" class="w-full px-4 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-red-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Dosage Form</label>
                    <select name="DosageForm" class="w-full px-4 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-red-500">
                        <option value="Tablet">Tablet</option>
                        <option value="Capsule">Capsule</option>
                        <option value="Syrup">Syrup</option>
                        <option value="Injection">Injection</option>
                        <option value="Ointment">Ointment</option>
                        <option value="Drops">Drops</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Strength</label>
                    <input type="text" name="Strength" placeholder="e.g. 500mg, 40mg" class="w-full px-4 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-red-500" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Manufacturer</label>
                <input type="text" name="Manufacturer" placeholder="e.g. Cipla, Sun Pharma, Dr. Reddy" class="w-full px-4 py-2.5 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-red-500" />
            </div>

            <div class="pt-3 flex gap-3">
                <button type="button" onclick="closeAddMedicineModal()" class="flex-1 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">Cancel</button>
                <button type="submit" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold shadow-lg shadow-red-600/30">Save Medicine</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openAddMedicineModal() {
            document.getElementById('addMedicineModal').classList.remove('hidden');
        }
        function closeAddMedicineModal() {
            document.getElementById('addMedicineModal').classList.add('hidden');
        }
    </script>
}

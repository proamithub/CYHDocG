@{
    ViewData["Title"] = "Platform Overview";
    bool isAntiInspect = ViewBag.AntiInspectEnabled ?? true;
}

<div class="space-y-6">
    <!-- Top Welcome Banner -->
    <div class="bg-gradient-to-r from-red-900/40 via-slate-900 to-slate-900 border border-red-500/20 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> System Live & Operational
            </span>
            <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-white">Welcome, Super Admin!</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-xl">
                Manage doctor live streams, toggle security shields, inspect platform ledgers and oversee real-time patient consultations.
            </p>
        </div>

        <!-- Quick Dynamic Action: Anti-Inspect Security Toggle -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-4 flex items-center gap-4 w-full md:w-auto">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 flex-shrink-0">
                <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-200 block">Anti-Inspect & DevTools Shield</span>
                <span class="text-[11px] text-slate-400">Lock F12 & Context Menu</span>
            </div>
            <label class="relative inline-flex items-center cursor-pointer ml-auto">
                <input type="checkbox" id="antiInspectToggle" class="sr-only peer" @(isAntiInspect ? "checked" : "") onchange="toggleSecurityShield(this.checked)" />
                <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
            </label>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Card 1 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-medium uppercase tracking-wider">Active Doctors</span>
                <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                    <i data-lucide="stethoscope" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="font-heading font-bold text-2xl text-white">24</div>
            <span class="text-[11px] text-emerald-400 font-medium flex items-center gap-1 mt-1">
                <i data-lucide="trending-up" class="w-3 h-3"></i> 6 Currently Streaming Live
            </span>
        </div>

        <!-- Card 2 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-medium uppercase tracking-wider">Consultations Today</span>
                <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center">
                    <i data-lucide="message-square" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="font-heading font-bold text-2xl text-white">182</div>
            <span class="text-[11px] text-purple-300 font-medium flex items-center gap-1 mt-1">
                <i data-lucide="clock" class="w-3 h-3"></i> Avg: 8 mins / session
            </span>
        </div>

        <!-- Card 3 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-medium uppercase tracking-wider">Platform Revenue</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                    <i data-lucide="banknote" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="font-heading font-bold text-2xl text-white">₹48,920</div>
            <span class="text-[11px] text-emerald-400 font-medium flex items-center gap-1 mt-1">
                <i data-lucide="percent" class="w-3 h-3"></i> 20% Net Commission
            </span>
        </div>

        <!-- Card 4 -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="flex items-center justify-between text-slate-400 mb-3">
                <span class="text-xs font-medium uppercase tracking-wider">Prescriptions Issued</span>
                <div class="w-8 h-8 rounded-lg bg-red-500/10 text-red-400 flex items-center justify-center">
                    <i data-lucide="file-text" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="font-heading font-bold text-2xl text-white">340</div>
            <span class="text-[11px] text-red-400 font-medium flex items-center gap-1 mt-1">
                <i data-lucide="bell" class="w-3 h-3"></i> 89 Reminders Due Today
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function toggleSecurityShield(isActive) {
            try {
                const response = await fetch('/api/security/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(isActive)
                });
                const data = await response.json();
                if (data.success) {
                    alert('Anti-Inspect setting updated: ' + (isActive ? 'Shield Active' : 'Shield Disabled'));
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}

@model List<CYHDocG.Repo.DTOs.AdminUserListDto>
@{
    ViewData["Title"] = "Users & Patients Directory";
    Layout = "_AdminLayout";
    int totalCount = Model?.Count ?? 0;
    int activeCount = Model?.Count(u => u.IsActive) ?? 0;
    int inactiveCount = totalCount - activeCount;
}

<div class="space-y-6">
    <!-- Header with Stats -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-red-600/20 border border-red-500/30 flex items-center justify-center text-red-500">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="font-heading font-extrabold text-2xl text-white">Registered Users & Patients Directory</h1>
                    <p class="text-xs text-slate-400">Monitor all accounts, view mobile numbers & email verification, and toggle access status.</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300">
                Total Registered: <strong class="text-white">@totalCount</strong>
            </span>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs flex items-center gap-2.5 shadow-lg">
            <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Accounts</div>
            <div class="text-2xl font-black text-white mt-1">@totalCount</div>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Active Status</div>
            <div class="text-2xl font-black text-emerald-400 mt-1">@activeCount</div>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Suspended / Inactive</div>
            <div class="text-2xl font-black text-slate-300 mt-1">@inactiveCount</div>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4">
            <div class="text-[11px] font-bold uppercase tracking-wider text-blue-400">Doctors Registered</div>
            <div class="text-2xl font-black text-blue-400 mt-1">@(Model?.Count(u => u.RoleName == "Doctor") ?? 0)</div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4">
        <form method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" name="q" value="@ViewBag.SearchTerm" placeholder="Search by name, email, or mobile number..." 
                       class="w-full pl-10 pr-4 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-red-500 transition-colors" />
            </div>
            <button type="submit" class="py-2 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition-colors">
                Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <a asp-action="Index" class="py-2 px-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-white text-xs transition-colors">
                    Clear
                </a>
            }
        </form>
    </div>

    <!-- Users Table Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
            <h3 class="font-heading font-bold text-sm text-white">All Platform Accounts</h3>
            <span class="text-xs text-slate-400">Showing @totalCount accounts</span>
        </div>

        <div class="overflow-x-auto no-scrollbar">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-slate-800/80 bg-slate-950/40">
                        <th class="py-3.5 px-4 font-semibold">User Details</th>
                        <th class="py-3.5 px-4 font-semibold">Contact (Mobile & Email)</th>
                        <th class="py-3.5 px-4 font-semibold">Account Role</th>
                        <th class="py-3.5 px-4 font-semibold">Wallet Balance</th>
                        <th class="py-3.5 px-4 font-semibold">Registration Date</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-200">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr class="hover:bg-slate-950/40 transition-colors">
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl @(user.RoleName == "Doctor" ? "bg-blue-600/20 text-blue-400 border-blue-500/20" : "bg-red-600/20 text-red-400 border-red-500/20") border flex items-center justify-center font-bold text-xs flex-shrink-0">
                                            @(user.RoleName == "Doctor" ? "Dr" : (user.FullName.Length > 0 ? user.FullName.Substring(0, 1).ToUpper() : "U"))
                                        </div>
                                        <div>
                                            <div class="font-bold text-white text-sm">@user.FullName</div>
                                            <div class="text-slate-500 text-[10px]">ID: #@user.UserId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="space-y-0.5">
                                        <div class="font-medium text-slate-200 flex items-center gap-1.5">
                                            <i data-lucide="phone" class="w-3 h-3 text-slate-400"></i>
                                            <span>@(string.IsNullOrEmpty(user.Phone) ? "Not Provided" : user.Phone)</span>
                                        </div>
                                        <div class="text-slate-400 text-[11px] flex items-center gap-1.5">
                                            <i data-lucide="mail" class="w-3 h-3 text-slate-500"></i>
                                            <span>@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase @(user.RoleName == "Doctor" ? "bg-blue-500/10 text-blue-400 border border-blue-500/20" : (user.RoleName == "Admin" ? "bg-purple-500/10 text-purple-400 border border-purple-500/20" : "bg-slate-800 text-slate-300 border border-slate-700"))">
                                        @user.RoleName
                                    </span>
                                    @if (user.RoleName == "Doctor")
                                    {
                                        <div class="mt-1">
                                            @if (user.IsDoctorApproved)
                                            {
                                                <span class="text-[10px] text-emerald-400 font-semibold">✓ Verified Doctor</span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-amber-400 font-semibold">⏳ Pending Approval</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="py-4 px-4 font-mono font-bold text-emerald-400">
                                    ₹@user.WalletBalance.ToString("N2")
                                </td>
                                <td class="py-4 px-4 text-slate-400 text-[11px]">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-4 px-4">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> Suspended
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (user.RoleName == "Doctor" && user.DoctorId.HasValue && user.DoctorId.Value > 0)
                                        {
                                            <form asp-area="Admin" asp-controller="Doctors" asp-action="ToggleApproval" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="doctorId" value="@user.DoctorId.Value" />
                                                <input type="hidden" name="isApproved" value="@(!user.IsDoctorApproved)" />
                                                <input type="hidden" name="returnUrl" value="/Admin/Users" />
                                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(user.IsDoctorApproved ? "bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 border border-amber-500/30" : "bg-blue-600 text-white hover:bg-blue-700 shadow-md shadow-blue-600/20")" title="@(user.IsDoctorApproved ? "Revoke Doctor Approval" : "Approve Doctor Credentials")">
                                                    @(user.IsDoctorApproved ? "Revoke Dr" : "Approve Dr")
                                                </button>
                                            </form>
                                        }
                                        <form asp-area="Admin" asp-controller="Users" asp-action="ToggleActive" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(user.IsActive ? "bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/30" : "bg-emerald-600 text-white hover:bg-emerald-700 shadow-md shadow-emerald-600/20")">
                                                @(user.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-500">
                                No users found matching your search.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model CYHDocG.Repo.DTOs.DoctorEarningsSummaryDto
@{
    ViewData["Title"] = "Doctor Earnings & Payout Wallet";
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Doctor Earnings & Wallet</h1>
            <p class="text-xs text-slate-400 mt-1">Live 80% consultation earnings credit, session history, and bank payouts.</p>
        </div>
        <button type="button" onclick="openPayoutModal()" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-emerald-600/30 flex items-center gap-2 active:scale-95 transition-all">
            <i data-lucide="arrow-down-to-line" class="w-4 h-4"></i>
            <span>Request Bank Payout</span>
        </button>
    </div>

    <!-- Earnings Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Available Payout Balance</span>
            <div class="font-heading font-bold text-2xl text-emerald-400">₹@Model.AvailableBalance.ToString("N2")</div>
            <span class="text-[11px] text-slate-400 flex items-center gap-1 mt-1">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i> Direct Bank Transfer Ready (Min: ₹100)
            </span>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">This Month Consultations</span>
            <div class="font-heading font-bold text-2xl text-white">@Model.MonthSessionsCount Sessions</div>
            <div class="flex items-center justify-between text-[11px] text-slate-400 mt-1">
                <span class="text-blue-400 font-semibold">Avg: @Model.MonthAvgDurationMinutes.ToString("N1") mins/session</span>
                <span class="text-emerald-400 font-semibold">Net: ₹@Model.MonthNetEarnings.ToString("N2")</span>
            </div>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-lg">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Total Net Earned</span>
            <div class="font-heading font-bold text-2xl text-white">₹@Model.TotalNetEarned.ToString("N2")</div>
            <span class="text-[11px] text-slate-400 flex items-center gap-1 mt-1">
                <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-slate-500"></i> Lifetime Withdrawn: ₹@Model.LifetimeWithdrawn.ToString("N2")
            </span>
        </div>
    </div>

    <!-- Consultation Passbook History -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
                <h3 class="font-heading font-bold text-base text-white">Recent Settled Consultations</h3>
                <p class="text-xs text-slate-400 mt-0.5">Real-time ledger of completed 1-to-1 video sessions with automatic 80% revenue credit.</p>
            </div>
            <span class="text-xs text-slate-400 bg-slate-950 px-3 py-1 rounded-full border border-slate-800 font-mono">
                Total: @(Model.RecentConsultations?.Count ?? 0)
            </span>
        </div>

        @if (Model.RecentConsultations != null && Model.RecentConsultations.Any())
        {
            <div class="overflow-x-auto no-scrollbar">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-slate-400 border-b border-slate-800/80 uppercase tracking-wider text-[11px]">
                            <th class="pb-3 font-semibold">Date & Time</th>
                            <th class="pb-3 font-semibold">Patient</th>
                            <th class="pb-3 font-semibold">Duration</th>
                            <th class="pb-3 font-semibold">Rate</th>
                            <th class="pb-3 font-semibold">Gross Fee</th>
                            <th class="pb-3 font-semibold text-right">Your Net (80%)</th>
                            <th class="pb-3 font-semibold text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 text-slate-200">
                        @foreach (var c in Model.RecentConsultations)
                        {
                            <tr class="hover:bg-slate-950/40 transition-colors">
                                <td class="py-3.5 text-slate-400 font-mono">
                                    @(c.EndedAt.HasValue ? c.EndedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") : c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                </td>
                                <td class="py-3.5">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-slate-300 text-[10px]">
                                            @(string.IsNullOrWhiteSpace(c.PatientName) ? "P" : c.PatientName[0].ToString().ToUpper())
                                        </div>
                                        <span class="font-semibold text-white">@c.PatientName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 font-medium">
                                    @(c.DurationMinutes) Mins <span class="text-[10px] text-slate-500">(@c.DurationSeconds s)</span>
                                </td>
                                <td class="py-3.5 font-mono text-slate-300">
                                    @(c.RatePerMinute > 0 ? $"₹{c.RatePerMinute:N0}/min" : "FREE")
                                </td>
                                <td class="py-3.5 font-mono text-slate-300">
                                    ₹@c.GrossFee.ToString("N2")
                                </td>
                                <td class="py-3.5 text-right font-mono font-bold @(c.DoctorNetCut > 0 ? "text-emerald-400" : "text-slate-400")">
                                    +₹@c.DoctorNetCut.ToString("N2")
                                </td>
                                <td class="py-3.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider @(c.Status == "Completed" ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : (c.Status == "Active" ? "bg-blue-500/20 text-blue-400 animate-pulse" : "bg-slate-800 text-slate-400"))">
                                        @c.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 px-4 space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-slate-800/80 border border-slate-700/60 text-slate-500 flex items-center justify-center mx-auto">
                    <i data-lucide="receipt" class="w-6 h-6"></i>
                </div>
                <h4 class="font-heading font-bold text-sm text-slate-300">No Settled Consultations Yet</h4>
                <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
                    When you accept and complete live 1-to-1 video consultations with patients, your real-time 80% credited fees and session details will appear here automatically.
                </p>
            </div>
        }
    </div>
</div>

<!-- ===================== PAYOUT REQUEST MODAL ===================== -->
<div id="payoutModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-7 max-w-md w-full shadow-2xl relative">
        <button onclick="closePayoutModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>

        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold">
                <i data-lucide="arrow-down-to-line" class="w-5 h-5"></i>
            </div>
            <div>
                <h3 class="font-heading font-bold text-base text-white">Request Bank Payout</h3>
                <p class="text-xs text-slate-400">Transfer your consultation earnings to your bank account or UPI.</p>
            </div>
        </div>

        <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 mb-4 flex items-center justify-between">
            <span class="text-xs text-slate-400">Available Balance:</span>
            <span class="font-mono font-bold text-sm text-emerald-400">₹@Model.AvailableBalance.ToString("N2")</span>
        </div>

        <form id="payoutForm" onsubmit="handlePayoutSubmit(event)" class="space-y-3.5">
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="text-xs font-semibold text-slate-300">Withdrawal Amount (₹)</label>
                    <button type="button" onclick="setFullBalance(@Model.AvailableBalance)" class="text-[11px] text-emerald-400 hover:underline font-semibold">
                        Withdraw All
                    </button>
                </div>
                <input type="number" id="payoutAmount" min="100" max="@Model.AvailableBalance" step="1" required
                       placeholder="Min ₹100" value="@(Model.AvailableBalance >= 100 ? Model.AvailableBalance.ToString("0") : "")"
                       class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-emerald-500 font-mono" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">UPI ID (Optional)</label>
                <input type="text" id="payoutUpi" placeholder="e.g. doctor@okhdfcbank"
                       class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-emerald-500" />
            </div>

            <div class="pt-1 border-t border-slate-800/80">
                <span class="text-[11px] text-slate-400 font-semibold block mb-2">Or Bank Account Details:</span>
                <div class="space-y-2">
                    <input type="text" id="payoutBankName" placeholder="Bank Name (e.g. HDFC Bank)"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-emerald-500" />
                    <input type="text" id="payoutAccountNumber" placeholder="Account Number"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-emerald-500 font-mono" />
                    <input type="text" id="payoutIfsc" placeholder="IFSC Code (e.g. HDFC0001234)"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs outline-none focus:border-emerald-500 font-mono uppercase" />
                </div>
            </div>

            <div class="pt-2">
                <button type="submit" id="btnSubmitPayout" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2 transition-all active:scale-95">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Submit Payout Request</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openPayoutModal() {
            const avail = @Model.AvailableBalance;
            if (avail < 100) {
                alert(`Minimum payout withdrawal balance is ₹100.00. Your current available balance is ₹${avail.toFixed(2)}.`);
                return;
            }
            document.getElementById('payoutModal').classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closePayoutModal() {
            document.getElementById('payoutModal').classList.add('hidden');
        }

        function setFullBalance(balance) {
            document.getElementById('payoutAmount').value = Math.floor(balance);
        }

        async function handlePayoutSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitPayout');
            const amount = parseFloat(document.getElementById('payoutAmount').value);
            const upiId = document.getElementById('payoutUpi').value.trim();
            const bankName = document.getElementById('payoutBankName').value.trim();
            const accNum = document.getElementById('payoutAccountNumber').value.trim();
            const ifsc = document.getElementById('payoutIfsc').value.trim();

            if (!amount || amount < 100) {
                alert('Please enter an amount of at least ₹100.');
                return;
            }

            if (!upiId && !accNum) {
                alert('Please provide either your UPI ID or Bank Account Number to receive payment.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span>Submitting Request...</span>';

            try {
                const res = await fetch('/Doctor/Earnings/RequestPayout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: amount,
                        upiId: upiId || null,
                        bankName: bankName || null,
                        accountNumber: accNum || null,
                        ifscCode: ifsc || null
                    })
                });

                const data = await res.json();
                if (data.success) {
                    alert(data.message || 'Payout request submitted successfully!');
                    window.location.reload();
                } else {
                    alert(data.message || 'Unable to submit payout request.');
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Submit Payout Request</span>';
                    if (window.lucide) lucide.createIcons();
                }
            } catch (err) {
                console.error(err);
                alert('Error submitting payout request.');
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Submit Payout Request</span>';
                if (window.lucide) lucide.createIcons();
            }
        }
    </script>
}

@model CYHDocG.Web.Areas.Doctor.Controllers.DoctorChatHistoryViewModel
@{
    ViewData["Title"] = "Live Patient Chat History";
}

<div class="space-y-6">
    <!-- Header with Quick Action & Summary -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">
                    <i data-lucide="history" class="w-3.5 h-3.5"></i>
                    <span>TRANSCRIPTS & ARCHIVES</span>
                </span>
            </div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Live Patient Chat History</h1>
            <p class="text-xs text-slate-400 mt-1">Filter session-wise broadcasts, review patient questions, and export consultation chat logs.</p>
        </div>

        <div class="flex items-center gap-2">
            <a asp-area="Doctor" asp-controller="LiveStudio" asp-action="Index" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs flex items-center gap-2 shadow-lg shadow-red-600/20 transition-all active:scale-95">
                <i data-lucide="radio" class="w-4 h-4"></i>
                <span>Open Live Studio</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar (Presets & Custom Date) -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl space-y-3">
        <form method="get" asp-area="Doctor" asp-controller="ChatHistory" asp-action="Index" class="flex flex-wrap items-center justify-between gap-3">
            <input type="hidden" name="sessionId" value="@Model.SelectedSession?.StreamId" />

            <!-- Presets -->
            <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-medium text-slate-400 mr-1">Time Filter:</span>
                <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", range = "all", search = Model.Search })"
                   class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(Model.Range == "all" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700")">
                    All Sessions
                </a>
                <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", range = "today", search = Model.Search })"
                   class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(Model.Range == "today" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700")">
                    Today
                </a>
                <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", range = "yesterday", search = Model.Search })"
                   class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(Model.Range == "yesterday" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700")">
                    Yesterday
                </a>
                <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", range = "week", search = Model.Search })"
                   class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(Model.Range == "week" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700")">
                    Last 7 Days
                </a>
                <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", range = "month", search = Model.Search })"
                   class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-all @(Model.Range == "month" ? "bg-blue-600 text-white shadow-md shadow-blue-600/30" : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700")">
                    This Month
                </a>
            </div>

            <!-- Search Title & Custom Date Inputs -->
            <div class="flex items-center gap-2 flex-wrap w-full lg:w-auto">
                <input type="hidden" name="range" value="@Model.Range" />
                <div class="relative flex-1 sm:w-56">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input type="text" name="search" value="@Model.Search" placeholder="Search session title..."
                           class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-slate-400 outline-none focus:border-blue-500 transition-colors" />
                </div>
                <button type="submit" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition-all flex items-center gap-1.5">
                    <i data-lucide="filter" class="w-3.5 h-3.5 text-blue-400"></i>
                    <span>Filter</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Range != "all")
                {
                    <a asp-area="Doctor" asp-controller="ChatHistory" asp-action="Index" class="px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-400 text-xs transition-all" title="Reset Filters">
                        ✕ Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Master-Detail Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Sessions Browser (4 cols) -->
        <div class="lg:col-span-5 xl:col-span-4 bg-slate-900 border border-slate-800 rounded-3xl p-4 shadow-xl flex flex-col h-[650px]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 px-2">
                <div class="flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4 text-blue-400"></i>
                    <h3 class="font-heading font-bold text-sm text-white">Broadcast Sessions</h3>
                </div>
                <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold border border-slate-700">
                    @Model.Sessions.Count @(Model.Sessions.Count == 1 ? "Session" : "Sessions")
                </span>
            </div>

            <!-- Sessions List -->
            <div class="flex-1 overflow-y-auto space-y-2 mt-3 pr-1 no-scrollbar">
                @if (Model.Sessions.Any())
                {
                    foreach (var s in Model.Sessions)
                    {
                        var isSelected = Model.SelectedSession?.StreamId == s.StreamId;
                        var sessionDate = s.StartedAt ?? s.CreatedAt;
                        <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", sessionId = s.StreamId, range = Model.Range, search = Model.Search })"
                           class="block p-3.5 rounded-2xl border transition-all text-left group relative @(isSelected ? "bg-blue-950/40 border-blue-500/60 shadow-lg shadow-blue-900/20" : "bg-slate-950/60 hover:bg-slate-950 border-slate-800/80 hover:border-slate-700")">
                            
                            <div class="flex items-start justify-between gap-2 mb-1.5">
                                <span class="text-[11px] font-bold text-slate-400 group-hover:text-blue-300 transition-colors flex items-center gap-1.5">
                                    <i data-lucide="clock" class="w-3 h-3 text-slate-400"></i>
                                    @sessionDate.ToString("dd MMM yyyy, hh:mm tt")
                                </span>

                                @if (s.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 text-[10px] font-extrabold border border-red-500/40 uppercase animate-pulse">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> LIVE
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-400 font-medium">
                                        Ended
                                    </span>
                                }
                            </div>

                            <h4 class="font-bold text-xs text-white line-clamp-1 leading-snug @(isSelected ? "text-blue-200" : "")">
                                @s.Title
                            </h4>

                            <div class="flex items-center justify-between text-[11px] text-slate-400 mt-2.5 pt-2 border-t border-slate-800/60">
                                <div class="flex items-center gap-3">
                                    <span class="flex items-center gap-1 text-emerald-400 font-bold">
                                        <i data-lucide="message-square" class="w-3 h-3"></i>
                                        @s.TotalComments @(s.TotalComments == 1 ? "chat" : "chats")
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <i data-lucide="timer" class="w-3 h-3 text-slate-400"></i>
                                        @(s.DurationMinutes > 0 ? $"{s.DurationMinutes}m" : "<1m")
                                    </span>
                                </div>
                                <span class="flex items-center gap-1 text-slate-400">
                                    <i data-lucide="heart" class="w-3 h-3 text-rose-400"></i>
                                    @s.TotalLikes
                                </span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="h-full flex flex-col items-center justify-center p-6 text-center text-slate-400">
                        <div class="w-12 h-12 rounded-2xl bg-slate-800/70 text-slate-500 flex items-center justify-center mb-3">
                            <i data-lucide="video-off" class="w-6 h-6"></i>
                        </div>
                        <h4 class="text-white text-xs font-bold">No Sessions Found</h4>
                        <p class="text-[11px] text-slate-400 mt-1">No broadcast sessions matched your filter criteria.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Active Session Chat Transcript & Export (8 cols) -->
        <div class="lg:col-span-7 xl:col-span-8 bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-xl flex flex-col h-[650px]">
            @if (Model.SelectedSession != null)
            {
                var s = Model.SelectedSession;
                var startDate = s.StartedAt ?? s.CreatedAt;
                
                <!-- Session Header & Download Actions -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-4 mb-4">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs font-bold text-white">Session #@s.StreamId</span>
                            <span class="text-slate-400 text-xs">•</span>
                            <span class="text-xs text-slate-300">@startDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                            @if (s.IsActive)
                            {
                                <span class="px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 text-[10px] font-bold border border-red-500/30">Active Stream</span>
                            }
                        </div>
                        <h2 class="font-heading font-extrabold text-base text-white">@s.Title</h2>
                        <div class="flex items-center gap-3 mt-1.5 text-xs text-slate-400">
                            <span>Total Messages: <strong class="text-emerald-400 font-bold">@Model.Comments.Count</strong></span>
                            <span>•</span>
                            <span>Duration: <strong class="text-white">@(s.DurationMinutes > 0 ? $"{s.DurationMinutes} mins" : "< 1 min")</strong></span>
                            <span>•</span>
                            <span>Total Likes: <strong class="text-rose-400 font-bold">@s.TotalLikes</strong></span>
                        </div>
                    </div>

                    <!-- Export Download Buttons -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <a href="@Url.Action("Download", "ChatHistory", new { area = "Doctor", sessionId = s.StreamId, format = "csv" })"
                           class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-md shadow-emerald-600/20 transition-all active:scale-95"
                           title="Download full chat transcript as CSV Spreadsheet">
                            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                            <span>Download CSV</span>
                        </a>

                        <a href="@Url.Action("Download", "ChatHistory", new { area = "Doctor", sessionId = s.StreamId, format = "txt" })"
                           class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-bold flex items-center gap-1.5 transition-all active:scale-95"
                           title="Download full chat transcript as Plain Text">
                            <i data-lucide="file-text" class="w-4 h-4"></i>
                            <span>TXT</span>
                        </a>

                        <button type="button" onclick="window.print()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs font-semibold flex items-center gap-1 transition-all" title="Print Transcript">
                            <i data-lucide="printer" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <!-- Chat Filter Within Session -->
                <form method="get" asp-area="Doctor" asp-controller="ChatHistory" asp-action="Index" class="mb-3">
                    <input type="hidden" name="sessionId" value="@s.StreamId" />
                    <input type="hidden" name="range" value="@Model.Range" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <div class="relative">
                        <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" name="chatSearch" value="@Model.ChatSearch" placeholder="Filter questions or messages within this session..."
                               class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-9 py-2 text-xs text-white placeholder-slate-400 outline-none focus:border-blue-500 transition-colors" />
                        @if (!string.IsNullOrWhiteSpace(Model.ChatSearch))
                        {
                            <a href="@Url.Action("Index", "ChatHistory", new { area = "Doctor", sessionId = s.StreamId, range = Model.Range, search = Model.Search })"
                               class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs">✕</a>
                        }
                    </div>
                </form>

                <!-- Comments Transcript Feed -->
                <div id="transcriptBox" class="flex-1 overflow-y-auto space-y-3 pr-2 no-scrollbar text-xs">
                    @if (Model.Comments.Any())
                    {
                        foreach (var c in Model.Comments)
                        {
                            var cleanName = (c.UserName ?? "").Trim();
                            if (cleanName.StartsWith("Dr. Dr.", StringComparison.OrdinalIgnoreCase))
                            {
                                cleanName = cleanName.Substring(4).Trim();
                            }
                            var isDoc = cleanName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) 
                                        || cleanName.Equals(Model.DoctorName, StringComparison.OrdinalIgnoreCase);
                            var isSystem = cleanName.Equals("System", StringComparison.OrdinalIgnoreCase);
                            var initial = !string.IsNullOrEmpty(cleanName) ? cleanName.Substring(0, 1).ToUpper() : "U";

                            if (isSystem)
                            {
                                <div class="flex justify-center my-1.5">
                                    <div class="px-3.5 py-1 rounded-full bg-slate-950/90 border border-slate-800 text-slate-400 text-[10px] text-center shadow">
                                        @c.Message
                                    </div>
                                </div>
                            }
                            else if (isDoc)
                            {
                                <!-- Doctor Reply: Right Side -->
                                <div class="flex justify-end w-full animate-fade-in">
                                    <div class="max-w-[80%] bg-gradient-to-br from-red-950/60 via-slate-900 to-slate-950 border border-red-500/30 rounded-2xl rounded-tr-xs p-3.5 shadow-md flex flex-col gap-1.5 text-right">
                                        <div class="flex items-center justify-between gap-4 border-b border-red-500/20 pb-1">
                                            <span class="text-[10px] text-slate-400 font-mono">@c.CreatedAt.ToString("hh:mm:ss tt")</span>
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-bold text-white text-[11px]">@cleanName</span>
                                                <span class="px-1.5 py-0.5 rounded-full bg-red-500/20 text-red-300 border border-red-500/40 text-[9px] font-extrabold uppercase">Doctor</span>
                                            </div>
                                        </div>
                                        <div class="text-white text-xs leading-relaxed break-words text-left">
                                            @c.Message
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Patient Message: Left Side -->
                                <div class="flex justify-start w-full animate-fade-in">
                                    <div class="max-w-[80%] bg-slate-950/90 border border-slate-800 rounded-2xl rounded-tl-xs p-3.5 shadow-md flex flex-col gap-1.5 text-left">
                                        <div class="flex items-center justify-between gap-4 border-b border-slate-800/60 pb-1">
                                            <div class="flex items-center gap-1.5">
                                                <div class="w-5 h-5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center font-bold text-[10px]">
                                                    @initial
                                                </div>
                                                <span class="font-bold text-white text-[11px]">@cleanName</span>
                                                <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-slate-800 text-slate-400">Patient</span>
                                            </div>
                                            <span class="text-[10px] text-slate-400 font-mono">@c.CreatedAt.ToString("hh:mm:ss tt")</span>
                                        </div>
                                        <div class="text-slate-200 text-xs leading-relaxed break-words">
                                            @c.Message
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="h-full flex flex-col items-center justify-center p-8 text-center text-slate-400">
                            <div class="w-12 h-12 rounded-2xl bg-slate-800/70 text-slate-500 flex items-center justify-center mb-3">
                                <i data-lucide="message-square-off" class="w-6 h-6"></i>
                            </div>
                            <h4 class="text-white text-sm font-bold">No Messages in this Session</h4>
                            <p class="text-xs text-slate-400 mt-1 max-w-sm">No patient comments were received during this live session, or none matched your search filter.</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="h-full flex flex-col items-center justify-center p-12 text-center text-slate-400">
                    <div class="w-16 h-16 rounded-3xl bg-slate-800/80 text-slate-500 border border-slate-700/60 flex items-center justify-center mb-4">
                        <i data-lucide="message-circle" class="w-8 h-8 text-blue-400"></i>
                    </div>
                    <h3 class="font-heading font-bold text-base text-white">Select a Broadcast Session</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-md">Choose any live broadcast session from the left list to inspect the complete conversation transcript and export patient comments.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto scroll to bottom of transcript on load if exists
        window.addEventListener('DOMContentLoaded', () => {
            const box = document.getElementById('transcriptBox');
            if (box) {
                box.scrollTop = box.scrollHeight;
            }
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}

@model CYHDocG.Repo.DTOs.DoctorStudioMetricsDto
@{
    ViewData["Title"] = "Doctor Live Broadcasting Studio";
}

<!-- LiveKit Real-Time WebRTC SDK & SignalR -->
<script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span id="liveStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700">
                    <span id="liveStatusDot" class="w-2 h-2 rounded-full bg-slate-500"></span>
                    <span id="liveStatusText">STUDIO OFFLINE</span>
                </span>
                <span class="text-xs text-slate-400">Stream Room: <span class="font-mono text-slate-300">@ViewBag.RoomName</span></span>
            </div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Live Health Studio</h1>
        </div>

        <div class="flex items-center gap-3">
            <button id="btnStartBroadcast" onclick="startBroadcast()" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-red-600/30 transition-all active:scale-95">
                <i data-lucide="radio" class="w-4 h-4"></i>
                <span>Start Live Broadcast</span>
            </button>
            <button id="btnEndBroadcast" onclick="endBroadcast()" class="hidden px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-red-400 border border-red-500/30 font-bold text-xs sm:text-sm flex items-center gap-2 transition-all">
                <i data-lucide="square" class="w-4 h-4"></i>
                <span>End Broadcast</span>
            </button>
        </div>
    </div>

    <!-- Main Studio Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Video Camera Viewport (2 cols) -->
        <div class="lg:col-span-2 space-y-4">
            <div class="relative bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden aspect-video shadow-2xl flex items-center justify-center">
                <!-- Video Element -->
                <video id="doctorStudioVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>

                <!-- Offline Placeholder -->
                <div id="videoPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 text-center p-6">
                    <div class="w-16 h-16 rounded-3xl bg-red-600/20 text-red-500 border border-red-500/30 flex items-center justify-center mb-4">
                        <i data-lucide="camera-off" class="w-8 h-8"></i>
                    </div>
                    <h3 class="font-heading font-bold text-lg text-white">Camera Offline</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-sm">Click "Start Live Broadcast" to activate your camera and microphone for patient reels.</p>
                </div>

                <!-- Floating Live Stats Overlay -->
                <div id="studioLiveOverlay" class="hidden absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-600/90 backdrop-blur-md text-white text-xs font-bold shadow-lg">
                        <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                        LIVE ON REELS FEED
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/60 backdrop-blur-md text-slate-200 text-xs font-semibold border border-white/10">
                        <i data-lucide="users" class="w-3.5 h-3.5 text-blue-400"></i>
                        <span id="liveViewerCount">1</span> Viewers
                    </span>
                </div>
            </div>

            <!-- Device Controls Bar -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <button type="button" id="btnToggleMic" onclick="toggleMic()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-700 transition-all">
                        <i data-lucide="mic" id="micIcon" class="w-4 h-4"></i>
                        <span id="micText">Mute</span>
                    </button>
                    <button type="button" id="btnToggleCam" onclick="toggleCam()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-700 transition-all">
                        <i data-lucide="video" id="camIcon" class="w-4 h-4"></i>
                        <span id="camText">Stop Video</span>
                    </button>
                </div>

                <div class="text-xs text-slate-400">
                    Consultation rate: <strong class="text-emerald-400">@(Model?.IsFreeConsultation == true ? "FREE" : "₹" + (Model?.ConsultationFeePerMinute ?? 30) + "/min")</strong>
                </div>
            </div>

            <!-- Live Pinned Health Tip & Medicine Advisory Banner Control -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center">
                            <i data-lucide="pin" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <h3 class="font-heading font-bold text-sm text-white">Live Stream Pinned Banner</h3>
                            <p class="text-[11px] text-slate-400">Pin a clinical advisory, medicine recommendation, or diet tip for all viewers</p>
                        </div>
                    </div>
                    <!-- Active Status Tag -->
                    <div id="pinnedBannerStatus" class="hidden px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 animate-pulse">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active on Patient Reels
                    </div>
                </div>

                <!-- Active Banner Display (When pinned) -->
                <div id="activePinnedBannerContainer" class="hidden p-3.5 rounded-2xl bg-slate-950 border border-amber-500/40 flex items-start justify-between gap-3 shadow-inner">
                    <div class="flex items-start gap-2.5">
                        <span id="activeBannerIcon" class="mt-0.5 text-amber-400 text-lg">💡</span>
                        <div>
                            <div class="flex items-center gap-2">
                                <span id="activeBannerTypeLabel" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300">Health Tip</span>
                                <span id="activeBannerMedTag" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-md bg-red-500/20 text-red-300 border border-red-500/30"></span>
                            </div>
                            <p id="activeBannerText" class="text-xs text-white font-medium mt-1 leading-snug"></p>
                        </div>
                    </div>
                    <button type="button" onclick="handleUnpinBanner()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-red-500/20 text-slate-300 hover:text-red-400 border border-slate-700 text-xs font-semibold transition-all flex items-center gap-1">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                        <span>Unpin</span>
                    </button>
                </div>

                <!-- Banner Creation Form -->
                <div id="pinnedBannerForm" class="space-y-3">
                    <!-- Quick Presets -->
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="text-[11px] text-slate-400 mr-1">Quick Presets:</span>
                        <button type="button" onclick="applyPreset('tip', '💧 Hydration Advisory: Drink 2.5-3 Litres of clean water daily to prevent kidney stones & dehydration.', '')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300 transition-all border border-slate-700">
                            💧 Hydration
                        </button>
                        <button type="button" onclick="applyPreset('medicine', 'Take Tab Pan-D 40mg 30 minutes before breakfast for severe acidity & reflux relief.', 'Tab Pan-D 40mg')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300 transition-all border border-slate-700">
                            💊 Acidity (Pan-D)
                        </button>
                        <button type="button" onclick="applyPreset('diet', '🥗 Diabetic Care: Avoid high-glycemic fruits like mango/banana on an empty stomach.', '')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300 transition-all border border-slate-700">
                            🥗 Sugar Spikes
                        </button>
                        <button type="button" onclick="applyPreset('warning', '⚠️ Urgent Warning: Persistent chest pain radiating to left arm requires immediate ER visit. Call 112/108.', '')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-red-400 transition-all border border-red-500/30">
                            ⚠️ Chest Pain Alert
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5">
                        <select id="bannerTypeSelect" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-red-500">
                            <option value="tip">💡 Clinical Tip</option>
                            <option value="medicine">💊 Medicine Rx</option>
                            <option value="diet">🥗 Diet & Nutrition</option>
                            <option value="warning">⚠️ Emergency / Warning</option>
                        </select>
                        <input type="text" id="bannerMedInput" placeholder="Medicine name (optional)..." class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 outline-none focus:border-red-500" />
                        <input type="text" id="bannerTextInput" placeholder="Type clinical advice or recommendation (max 180 chars)..." maxlength="180" class="sm:col-span-2 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-400 outline-none focus:border-red-500" />
                    </div>

                    <div class="flex justify-end gap-2">
                        <button type="button" onclick="handlePinBannerSubmit()" class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-lg shadow-amber-500/20 transition-all active:scale-95">
                            <i data-lucide="pin" class="w-3.5 h-3.5"></i>
                            <span>Pin to Live Stream</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Real-Time Patient Comments & Interactions -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 flex flex-col h-[520px] shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
                <div class="flex items-center gap-2">
                    <i data-lucide="message-square" class="w-4 h-4 text-red-500"></i>
                    <h3 class="font-heading font-bold text-sm text-white">Live Patient Chat</h3>
                </div>
                <span class="text-[11px] text-slate-400">Real-time Stream</span>
            </div>

            <!-- Comments Log -->
            <div id="studioCommentsBox" class="flex-1 overflow-y-auto space-y-2.5 pr-1 no-scrollbar text-xs">
                @if (ViewBag.RecentComments != null && ((List<CYHDocG.Repo.DTOs.LiveCommentDto>)ViewBag.RecentComments).Any())
                {
                    foreach (var c in (List<CYHDocG.Repo.DTOs.LiveCommentDto>)ViewBag.RecentComments)
                    {
                        <div id="comment_@c.CommentId" data-user-id="@c.UserId" class="comment-item p-2.5 rounded-xl bg-slate-950/80 border border-slate-800/80 flex flex-col gap-0.5">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-white text-[11px]">@c.UserName</span>
                                <div class="flex items-center gap-1.5">
                                    <button type="button" onclick="handleBlockUser(@c.UserId, '@c.UserName')" class="text-[10px] text-red-400 hover:text-red-300 px-1.5 py-0.5 rounded bg-red-500/10 border border-red-500/20" title="Block User">Block</button>
                                    <button type="button" onclick="handleDeleteComment(@c.CommentId)" class="text-[10px] text-slate-400 hover:text-slate-200 px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700" title="Delete Comment">Delete</button>
                                </div>
                            </div>
                            <span class="text-slate-300 text-xs">@c.Message</span>
                        </div>
                    }
                }
                else
                {
                    <div id="noCommentsYetMsg" class="p-3 rounded-2xl bg-slate-950/60 border border-slate-800 text-slate-400 text-center text-[11px]">
                        No comments yet. When patients watch your stream, their questions will appear here in real-time.
                    </div>
                }
            </div>

            <!-- Doctor Broadcast Message Input -->
            <form onsubmit="handleSendDoctorStudioComment(event)" class="mt-3 pt-3 border-t border-slate-800 flex gap-2">
                <input type="text" id="studioCommentInput" placeholder="Reply to viewers..." 
                       class="flex-1 px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs placeholder-slate-400 outline-none focus:border-red-500" />
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-semibold transition-all">
                    Send
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ===================== INCOMING 1-TO-1 CONSULTATION MODAL ===================== -->
<div id="incomingConsultationModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border-2 border-emerald-500/60 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl relative text-center">
        <!-- Pulsing Phone Icon -->
        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 mx-auto flex items-center justify-center mb-4 animate-bounce">
            <i data-lucide="phone-call" class="w-8 h-8"></i>
        </div>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Live 1-to-1 Call Request
        </span>

        <h3 id="incomingPatientName" class="font-heading font-extrabold text-xl text-white mt-1">Patient Requesting Call</h3>
        <p class="text-xs text-slate-300 mt-2 leading-relaxed">
            A viewer has requested an immediate 1-to-1 private video consultation at <strong class="text-emerald-400">@(Model?.IsFreeConsultation == true ? "FREE" : "₹" + (Model?.ConsultationFeePerMinute ?? 30) + "/min")</strong>.
        </p>
        <p class="text-[11px] text-amber-400/90 mt-1">
            ⏱️ Timer will start ticking ONLY after you accept.
        </p>

        <div class="grid grid-cols-2 gap-3 mt-6">
            <button type="button" onclick="handleDeclineConsultation()" class="py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs border border-slate-700 transition-all">
                Decline
            </button>
            <button type="button" id="btnAcceptConsultation" onclick="handleAcceptConsultation()" class="py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-1.5 transition-all active:scale-95">
                <i data-lucide="video" class="w-4 h-4"></i>
                <span>Accept Call</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const livekitServerUrl = "@ViewBag.ServerUrl";
        const livekitToken = "@ViewBag.Token";
        const roomName = "@ViewBag.RoomName";
        const doctorId = @ViewBag.DoctorId;

        let livekitRoom = null;
        let isBroadcasting = false;
        let signalrConn = null;
        let localMediaStream = null;
        let pendingConsultation = null;

        // SignalR setup for comments, moderation, and incoming 1-to-1 calls
        async function setupSignalR() {
            try {
                signalrConn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/live-reel")
                    .withAutomaticReconnect([0, 2000, 5000, 10000])
                    .build();

                // Live Comments
                signalrConn.on("ReceiveNewComment", (streamId, comment) => {
                    appendComment(comment.userName, comment.message, comment.userId, comment.commentId);
                });

                // Moderation listeners
                signalrConn.on("UserRemovedFromChat", (data) => {
                    removeCommentsByUserId(data.targetUserId);
                });

                signalrConn.on("CommentDeleted", (commentId) => {
                    removeCommentById(commentId);
                });

                // Real-time Viewer count
                signalrConn.on("UpdateViewerCount", (streamKey, count) => {
                    if (streamKey == doctorId.toString()) {
                        const viewerEl = document.getElementById("liveViewerCount");
                        if (viewerEl) {
                            viewerEl.textContent = count;
                            viewerEl.classList.add("text-emerald-400", "scale-125");
                            setTimeout(() => viewerEl.classList.remove("text-emerald-400", "scale-125"), 400);
                        }
                    }
                });

                // Incoming 1-to-1 Consultation Request Alert
                signalrConn.on("ReceiveIncomingConsultationRequest", (request) => {
                    console.log("[LiveStudio] Incoming 1-to-1 request received:", request);
                    showIncomingCallModal(request);
                });

                // Listen for Pinned Banner sync
                signalrConn.on("ReceivePinnedBanner", (streamKey, banner) => {
                    if (streamKey == doctorId.toString()) {
                        renderStudioPinnedBanner(banner);
                    }
                });

                signalrConn.on("ClearPinnedBanner", (streamKey) => {
                    if (streamKey == doctorId.toString()) {
                        clearStudioPinnedBanner();
                    }
                });

                await signalrConn.start();
                console.log("[LiveStudio] Connected to SignalR Live Hub for room:", doctorId);
                
                // Register doctor connection for auto-offline & room notifications
                await signalrConn.invoke("RegisterDoctorBroadcaster", doctorId);
            } catch (err) {
                console.warn("SignalR live reel hub connect error:", err);
            }
        }

        async function startBroadcast() {
            try {
                // 1. Get User Media (Camera & Mic)
                localMediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                const videoEl = document.getElementById('doctorStudioVideo');
                videoEl.srcObject = localMediaStream;
                document.getElementById('videoPlaceholder').classList.add('hidden');

                // 2. Connect to LiveKit if available
                if (window.LivekitClient && livekitServerUrl && livekitToken) {
                    try {
                        livekitRoom = new LivekitClient.Room({
                            adaptiveStream: true,
                            dynacast: true
                        });
                        await livekitRoom.connect(livekitServerUrl, livekitToken);
                        await livekitRoom.localParticipant.enableCameraAndMicrophone();
                    } catch (lkErr) {
                        console.warn("LiveKit server connect fallback to local WebRTC:", lkErr);
                    }
                }

                // 3. Notify backend that doctor is LIVE
                await fetch('/Doctor/LiveStudio/ToggleLive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLive: true, streamUrl: '/Doctor/LiveStudio' })
                });

                // Update UI state
                isBroadcasting = true;
                document.getElementById('btnStartBroadcast').classList.add('hidden');
                document.getElementById('btnEndBroadcast').classList.remove('hidden');
                document.getElementById('studioLiveOverlay').classList.remove('hidden');

                const badge = document.getElementById('liveStatusBadge');
                badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-600/20 text-red-400 border border-red-500/30";
                document.getElementById('liveStatusDot').className = "w-2 h-2 rounded-full bg-red-500 animate-ping";
                document.getElementById('liveStatusText').textContent = "BROADCASTING LIVE";

                appendComment("System", "Live stream started! Patients on the reels feed can now tune in.");
            } catch (err) {
                alert("Camera or Microphone permission denied: " + err.message);
            }
        }

        async function endBroadcast() {
            if (localMediaStream) {
                localMediaStream.getTracks().forEach(track => track.stop());
            }
            if (livekitRoom) {
                await livekitRoom.disconnect();
                livekitRoom = null;
            }

            const videoEl = document.getElementById('doctorStudioVideo');
            videoEl.srcObject = null;
            document.getElementById('videoPlaceholder').classList.remove('hidden');

            await fetch('/Doctor/LiveStudio/ToggleLive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isLive: false })
            });

            isBroadcasting = false;
            document.getElementById('btnStartBroadcast').classList.remove('hidden');
            document.getElementById('btnEndBroadcast').classList.add('hidden');
            document.getElementById('studioLiveOverlay').classList.add('hidden');

            const badge = document.getElementById('liveStatusBadge');
            badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700";
            document.getElementById('liveStatusDot').className = "w-2 h-2 rounded-full bg-slate-500";
            document.getElementById('liveStatusText').textContent = "STUDIO OFFLINE";
        }

        function toggleMic() {
            if (!localMediaStream) return;
            const audioTrack = localMediaStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = !audioTrack.enabled;
                document.getElementById('micText').textContent = audioTrack.enabled ? "Mute" : "Unmute";
            }
        }

        function toggleCam() {
            if (!localMediaStream) return;
            const videoTrack = localMediaStream.getVideoTracks()[0];
            if (videoTrack) {
                videoTrack.enabled = !videoTrack.enabled;
                document.getElementById('camText').textContent = videoTrack.enabled ? "Stop Video" : "Start Video";
            }
        }

        function appendComment(user, text, userId, commentId) {
            const noMsg = document.getElementById('noCommentsYetMsg');
            if (noMsg) noMsg.remove();

            const box = document.getElementById('studioCommentsBox');
            const item = document.createElement('div');
            item.className = "comment-item p-2.5 rounded-xl bg-slate-950/80 border border-slate-800/80 flex flex-col gap-0.5 animate-fade-in";
            if (commentId) item.id = `comment_${commentId}`;
            if (userId) item.setAttribute('data-user-id', userId);

            const isDoctor = user.includes("Dr.") || user === "System";

            item.innerHTML = `
                <div class="flex items-center justify-between">
                    <span class="font-bold text-white text-[11px]">${escapeHtml(user)}</span>
                    ${!isDoctor && userId ? `
                        <div class="flex items-center gap-1.5">
                            <button type="button" onclick="handleBlockUser(${userId}, '${escapeHtml(user)}')" class="text-[10px] text-red-400 hover:text-red-300 px-1.5 py-0.5 rounded bg-red-500/10 border border-red-500/20" title="Block User from Stream">Block</button>
                            ${commentId ? `<button type="button" onclick="handleDeleteComment(${commentId})" class="text-[10px] text-slate-400 hover:text-slate-200 px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700" title="Delete Comment">Delete</button>` : ''}
                        </div>
                    ` : ''}
                </div>
                <span class="text-slate-300 text-xs">${escapeHtml(text)}</span>
            `;
            box.appendChild(item);
            box.scrollTop = box.scrollHeight;
        }

        async function handleBlockUser(targetUserId, targetUserName) {
            if (!confirm(`Are you sure you want to block ${targetUserName} from your live chat?`)) return;
            if (signalrConn && signalrConn.state === "Connected") {
                try {
                    await signalrConn.invoke("ModerateBlockUser", doctorId, targetUserId, "Blocked by doctor in live studio");
                    removeCommentsByUserId(targetUserId);
                    appendComment("System", `🚫 You blocked ${targetUserName}.`);
                } catch (err) {
                    console.error("Block user error:", err);
                }
            }
        }

        async function handleDeleteComment(commentId) {
            if (signalrConn && signalrConn.state === "Connected") {
                try {
                    await signalrConn.invoke("DeleteComment", doctorId, commentId);
                    removeCommentById(commentId);
                } catch (err) {
                    console.error("Delete comment error:", err);
                }
            }
        }

        function removeCommentsByUserId(targetUserId) {
            document.querySelectorAll(`.comment-item[data-user-id="${targetUserId}"]`).forEach(el => el.remove());
        }

        function removeCommentById(commentId) {
            const el = document.getElementById(`comment_${commentId}`);
            if (el) el.remove();
        }

        function showIncomingCallModal(request) {
            pendingConsultation = request;
            const nameEl = document.getElementById('incomingPatientName');
            if (nameEl) nameEl.textContent = request.patientName || "Patient";
            const modal = document.getElementById('incomingConsultationModal');
            if (modal) {
                modal.classList.remove('hidden');
                playAlertChime();
            }
            if (window.lucide) window.lucide.createIcons();
        }

        function playAlertChime() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
                osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.4);
            } catch (e) {}
        }

        async function handleAcceptConsultation() {
            if (!pendingConsultation) return;
            const consultationId = pendingConsultation.consultationId;
            const btn = document.getElementById('btnAcceptConsultation');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = 'Connecting...';
            }

            try {
                const res = await fetch('/api/consultation/accept', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(consultationId)
                });
                const data = await res.json();
                if (data.success) {
                    // Navigate smoothly into the 1-to-1 consultation session
                    window.location.href = `/LiveChat?doctorId=${doctorId}&consultationId=${consultationId}`;
                } else {
                    alert(data.message || "Failed to accept consultation");
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = 'Accept Call';
                    }
                }
            } catch (err) {
                console.error(err);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = 'Accept Call';
                }
            }
        }

        function handleDeclineConsultation() {
            const modal = document.getElementById('incomingConsultationModal');
            if (modal) modal.classList.add('hidden');
            pendingConsultation = null;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.toString().replace(/[&<>"']/g, m => map[m]);
        }

        // Pinned Banner Handlers
        function applyPreset(type, text, medName) {
            document.getElementById('bannerTypeSelect').value = type;
            document.getElementById('bannerTextInput').value = text;
            document.getElementById('bannerMedInput').value = medName || '';
        }

        async function handlePinBannerSubmit() {
            const text = document.getElementById('bannerTextInput').value.trim();
            if (!text) {
                alert('Please enter a clinical advice or recommendation to pin.');
                return;
            }
            const type = document.getElementById('bannerTypeSelect').value;
            const medName = document.getElementById('bannerMedInput').value.trim();

            if (signalrConn && signalrConn.state === "Connected") {
                try {
                    await signalrConn.invoke("PinStreamBanner", doctorId, text, type, medName);
                    appendComment("System", `📌 Pinned to live stream: "${text}"`);
                } catch (err) {
                    console.error("Failed to pin banner:", err);
                }
            }
        }

        async function handleUnpinBanner() {
            if (signalrConn && signalrConn.state === "Connected") {
                try {
                    await signalrConn.invoke("UnpinStreamBanner", doctorId);
                    appendComment("System", `📌 Banner unpinned from live stream.`);
                } catch (err) {
                    console.error("Failed to unpin banner:", err);
                }
            }
        }

        function renderStudioPinnedBanner(banner) {
            if (!banner) return;
            const container = document.getElementById('activePinnedBannerContainer');
            const statusTag = document.getElementById('pinnedBannerStatus');
            const textEl = document.getElementById('activeBannerText');
            const typeLabel = document.getElementById('activeBannerTypeLabel');
            const iconEl = document.getElementById('activeBannerIcon');
            const medTag = document.getElementById('activeBannerMedTag');

            const icons = { tip: '💡', medicine: '💊', diet: '🥗', warning: '⚠️' };
            const labels = { tip: 'Clinical Tip', medicine: 'Medicine Rx', diet: 'Diet & Nutrition', warning: 'Urgent Advisory' };

            iconEl.textContent = icons[banner.bannerType] || '💡';
            typeLabel.textContent = labels[banner.bannerType] || 'Health Advisory';
            textEl.textContent = banner.bannerText;

            if (banner.medicineName) {
                medTag.textContent = 'Rx: ' + banner.medicineName;
                medTag.classList.remove('hidden');
            } else {
                medTag.classList.add('hidden');
            }

            container.classList.remove('hidden');
            statusTag.classList.remove('hidden');
        }

        function clearStudioPinnedBanner() {
            const container = document.getElementById('activePinnedBannerContainer');
            const statusTag = document.getElementById('pinnedBannerStatus');
            if (container) container.classList.add('hidden');
            if (statusTag) statusTag.classList.add('hidden');
            document.getElementById('bannerTextInput').value = '';
            document.getElementById('bannerMedInput').value = '';
        }

        function handleSendDoctorStudioComment(e) {
            e.preventDefault();
            const input = document.getElementById('studioCommentInput');
            const val = input.value.trim();
            if (!val) return;
            appendComment("Dr. @(ViewBag.DoctorName)", val);
            if (signalrConn && signalrConn.state === "Connected") {
                signalrConn.invoke("SendLiveComment", doctorId, val).catch(console.error);
            }
            input.value = "";
        }

        window.addEventListener('DOMContentLoaded', () => {
            setupSignalR();
        });
    </script>
}

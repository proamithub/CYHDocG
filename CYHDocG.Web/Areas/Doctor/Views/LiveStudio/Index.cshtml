@model CYHDocG.Repo.DTOs.DoctorStudioMetricsDto
@{
    ViewData["Title"] = "Doctor Live Broadcasting Studio";
}

<!-- LiveKit Real-Time WebRTC SDK & SignalR -->
<script src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span id="liveStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700">
                    <span id="liveStatusDot" class="w-2 h-2 rounded-full bg-slate-500"></span>
                    <span id="liveStatusText">STUDIO OFFLINE</span>
                </span>
                <span class="text-xs text-slate-400">Stream Room: <span class="font-mono text-slate-300">@ViewBag.RoomName</span></span>
            </div>
            <h1 class="font-heading font-extrabold text-2xl text-white">Live Health Studio</h1>
        </div>

        <div class="flex items-center gap-3">
            <button id="btnStartBroadcast" onclick="startBroadcast()" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-red-600/30 transition-all active:scale-95">
                <i data-lucide="radio" class="w-4 h-4"></i>
                <span>Start Live Broadcast</span>
            </button>
            <button id="btnEndBroadcast" onclick="endBroadcast()" class="hidden px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-red-400 border border-red-500/30 font-bold text-xs sm:text-sm flex items-center gap-2 transition-all">
                <i data-lucide="square" class="w-4 h-4"></i>
                <span>End Broadcast</span>
            </button>
        </div>
    </div>

    <!-- Main Studio Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Video Camera Viewport (2 cols) -->
        <div class="lg:col-span-2 space-y-4">
            <div class="relative bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden aspect-video shadow-2xl flex items-center justify-center">
                <!-- Video Element -->
                <video id="doctorStudioVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>

                <!-- Offline Placeholder -->
                <div id="videoPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 text-center p-6">
                    <div class="w-16 h-16 rounded-3xl bg-red-600/20 text-red-500 border border-red-500/30 flex items-center justify-center mb-4">
                        <i data-lucide="camera-off" class="w-8 h-8"></i>
                    </div>
                    <h3 class="font-heading font-bold text-lg text-white">Camera Offline</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-sm">Click "Start Live Broadcast" to activate your camera and microphone for patient reels.</p>
                </div>

                <!-- Floating Live Stats Overlay -->
                <div id="studioLiveOverlay" class="hidden absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-600/90 backdrop-blur-md text-white text-xs font-bold shadow-lg">
                        <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                        LIVE ON REELS FEED
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/60 backdrop-blur-md text-slate-200 text-xs font-semibold border border-white/10">
                        <i data-lucide="users" class="w-3.5 h-3.5 text-blue-400"></i>
                        <span id="liveViewerCount">1</span> Viewers
                    </span>
                </div>
            </div>

            <!-- Device Controls Bar -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <button type="button" id="btnToggleMic" onclick="toggleMic()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-700 transition-all">
                        <i data-lucide="mic" id="micIcon" class="w-4 h-4"></i>
                        <span id="micText">Mute</span>
                    </button>
                    <button type="button" id="btnToggleCam" onclick="toggleCam()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-700 transition-all">
                        <i data-lucide="video" id="camIcon" class="w-4 h-4"></i>
                        <span id="camText">Stop Video</span>
                    </button>
                </div>

                <div class="text-xs text-slate-400">
                    Consultation rate: <strong class="text-emerald-400">@(Model?.IsFreeConsultation == true ? "FREE" : "₹" + (Model?.ConsultationFeePerMinute ?? 30) + "/min")</strong>
                </div>
            </div>
        </div>

        <!-- Right Side: Real-Time Patient Comments & Interactions -->
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-5 flex flex-col h-[520px] shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
                <div class="flex items-center gap-2">
                    <i data-lucide="message-square" class="w-4 h-4 text-red-500"></i>
                    <h3 class="font-heading font-bold text-sm text-white">Live Patient Chat</h3>
                </div>
                <span class="text-[11px] text-slate-400">Real-time Stream</span>
            </div>

            <!-- Comments Log -->
            <div id="studioCommentsBox" class="flex-1 overflow-y-auto space-y-2.5 pr-1 no-scrollbar text-xs">
                <div class="p-3 rounded-2xl bg-slate-950/60 border border-slate-800 text-slate-400 text-center text-[11px]">
                    No comments yet. When patients watch your stream, their questions will appear here in real-time.
                </div>
            </div>

            <!-- Doctor Broadcast Message Input -->
            <form onsubmit="handleSendDoctorStudioComment(event)" class="mt-3 pt-3 border-t border-slate-800 flex gap-2">
                <input type="text" id="studioCommentInput" placeholder="Reply to viewers..." 
                       class="flex-1 px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs placeholder-slate-400 outline-none focus:border-red-500" />
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-semibold transition-all">
                    Send
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const livekitServerUrl = "@ViewBag.ServerUrl";
        const livekitToken = "@ViewBag.Token";
        const roomName = "@ViewBag.RoomName";
        const doctorId = @ViewBag.DoctorId;

        let livekitRoom = null;
        let isBroadcasting = false;
        let signalrConn = null;
        let localMediaStream = null;

        // SignalR setup for comments
        async function setupSignalR() {
            try {
                signalrConn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/live-reel")
                    .withAutomaticReconnect()
                    .build();

                signalrConn.on("ReceiveNewComment", (streamId, comment) => {
                    appendComment(comment.userName, comment.message);
                });

                await signalrConn.start();
                await signalrConn.invoke("JoinStreamRoom", doctorId.toString());
            } catch (err) {
                console.warn("SignalR live reel hub connect error:", err);
            }
        }

        async function startBroadcast() {
            try {
                // 1. Get User Media (Camera & Mic)
                localMediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                const videoEl = document.getElementById('doctorStudioVideo');
                videoEl.srcObject = localMediaStream;
                document.getElementById('videoPlaceholder').classList.add('hidden');

                // 2. Connect to LiveKit if available
                if (window.LivekitClient && livekitServerUrl && livekitToken) {
                    try {
                        livekitRoom = new LivekitClient.Room({
                            adaptiveStream: true,
                            dynacast: true
                        });
                        await livekitRoom.connect(livekitServerUrl, livekitToken);
                        await livekitRoom.localParticipant.enableCameraAndMicrophone();
                    } catch (lkErr) {
                        console.warn("LiveKit server connect fallback to local WebRTC:", lkErr);
                    }
                }

                // 3. Notify backend that doctor is LIVE
                await fetch('/Doctor/LiveStudio/ToggleLive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isLive: true, streamUrl: '/Doctor/LiveStudio' })
                });

                // Update UI state
                isBroadcasting = true;
                document.getElementById('btnStartBroadcast').classList.add('hidden');
                document.getElementById('btnEndBroadcast').classList.remove('hidden');
                document.getElementById('studioLiveOverlay').classList.remove('hidden');

                const badge = document.getElementById('liveStatusBadge');
                badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-600/20 text-red-400 border border-red-500/30";
                document.getElementById('liveStatusDot').className = "w-2 h-2 rounded-full bg-red-500 animate-ping";
                document.getElementById('liveStatusText').textContent = "BROADCASTING LIVE";

                appendComment("System", "Live stream started! Patients on the reels feed can now tune in.");
            } catch (err) {
                alert("Camera or Microphone permission denied: " + err.message);
            }
        }

        async function endBroadcast() {
            if (localMediaStream) {
                localMediaStream.getTracks().forEach(track => track.stop());
            }
            if (livekitRoom) {
                await livekitRoom.disconnect();
                livekitRoom = null;
            }

            const videoEl = document.getElementById('doctorStudioVideo');
            videoEl.srcObject = null;
            document.getElementById('videoPlaceholder').classList.remove('hidden');

            await fetch('/Doctor/LiveStudio/ToggleLive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isLive: false })
            });

            isBroadcasting = false;
            document.getElementById('btnStartBroadcast').classList.remove('hidden');
            document.getElementById('btnEndBroadcast').classList.add('hidden');
            document.getElementById('studioLiveOverlay').classList.add('hidden');

            const badge = document.getElementById('liveStatusBadge');
            badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700";
            document.getElementById('liveStatusDot').className = "w-2 h-2 rounded-full bg-slate-500";
            document.getElementById('liveStatusText').textContent = "STUDIO OFFLINE";
        }

        function toggleMic() {
            if (!localMediaStream) return;
            const audioTrack = localMediaStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = !audioTrack.enabled;
                document.getElementById('micText').textContent = audioTrack.enabled ? "Mute" : "Unmute";
            }
        }

        function toggleCam() {
            if (!localMediaStream) return;
            const videoTrack = localMediaStream.getVideoTracks()[0];
            if (videoTrack) {
                videoTrack.enabled = !videoTrack.enabled;
                document.getElementById('camText').textContent = videoTrack.enabled ? "Stop Video" : "Start Video";
            }
        }

        function appendComment(user, text) {
            const box = document.getElementById('studioCommentsBox');
            const item = document.createElement('div');
            item.className = "p-2.5 rounded-xl bg-slate-950/80 border border-slate-800/80 flex flex-col gap-0.5";
            item.innerHTML = `<span class="font-bold text-white text-[11px]">${user}</span><span class="text-slate-300 text-xs">${text}</span>`;
            box.appendChild(item);
            box.scrollTop = box.scrollHeight;
        }

        function handleSendDoctorStudioComment(e) {
            e.preventDefault();
            const input = document.getElementById('studioCommentInput');
            const val = input.value.trim();
            if (!val) return;
            appendComment("Dr. @(ViewBag.DoctorName)", val);
            if (signalrConn && signalrConn.state === "Connected") {
                signalrConn.invoke("SendLiveComment", doctorId, val).catch(console.error);
            }
            input.value = "";
        }

        window.addEventListener('DOMContentLoaded', () => {
            setupSignalR();
        });
    </script>
}

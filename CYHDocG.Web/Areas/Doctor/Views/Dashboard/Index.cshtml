@model CYHDocG.Repo.DTOs.DoctorStudioMetricsDto
@{
    ViewData["Title"] = "Doctor Studio Dashboard";
}

<div class="space-y-6">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-red-950/80 border border-red-500/40 text-red-300 text-xs flex items-center gap-2.5 shadow-lg">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-red-400 flex-shrink-0"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="bg-gradient-to-r from-blue-900/40 via-slate-900 to-slate-900 border border-blue-500/20 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-2">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> Doctor Consultation Portal
            </span>
            <h1 class="font-heading font-extrabold text-2xl sm:text-3xl text-white">Hello, Dr. @(Model?.DoctorName ?? User.Identity?.Name ?? "Specialist")</h1>
        </div>

        <div class="flex items-center gap-3">
            @if (Model?.IsApproved == true)
            {
                <a asp-area="Doctor" asp-controller="LiveStudio" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-red-600/30 transition-all active:scale-[0.98]">
                    <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                    <span>Go Live Now</span>
                </a>
                <a asp-area="Doctor" asp-controller="Consultations" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-medium text-xs sm:text-sm border border-slate-700 transition-all flex items-center gap-2">
                    <i data-lucide="messages-square" class="w-4 h-4"></i>
                    <span>Patient Queue</span>
                </a>
            }
            else
            {
                <button type="button" disabled class="px-5 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-slate-400 font-medium text-xs sm:text-sm flex items-center gap-2 cursor-not-allowed select-none opacity-80" title="Awaiting Admin Verification">
                    <i data-lucide="lock" class="w-4 h-4 text-amber-400"></i>
                    <span>Studio Locked (Pending Approval)</span>
                </button>
            }
        </div>
    </div>

    @if (Model?.IsApproved != true)
    {
        <!-- Pending Verification Notice -->
        <div class="p-5 sm:p-6 rounded-3xl bg-amber-950/40 border border-amber-500/40 text-amber-200 shadow-xl space-y-3">
            <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <i data-lucide="shield-alert" class="w-5 h-5"></i>
                </div>
                <div class="flex-1 space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h3 class="font-heading font-bold text-base text-white">Account Under Admin Verification</h3>
                        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-[10px] text-amber-300 font-bold uppercase tracking-wider border border-amber-500/30">Pending Approval</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Your doctor account has been registered and is currently under verification by CYHDocGuru medical administration. For patient safety and statutory compliance, live video broadcasting, patient consultation queues, and digital prescriptions remain locked until your credentials are confirmed.
                    </p>
                    <div class="pt-1 flex flex-wrap items-center gap-3 text-xs text-amber-300/90 font-medium">
                        <span class="flex items-center gap-1.5"><i data-lucide="clock" class="w-3.5 h-3.5 text-amber-400"></i> Status: Inactive / Pending Admin Action</span>
                        <span class="text-slate-600 hidden sm:inline">•</span>
                        <span>Full studio access will activate automatically once verified</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Doctor Metrics (Dynamic) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">My Live Stream Followers</div>
            <div class="font-heading font-bold text-2xl text-white">@(Model?.FollowerCount ?? 0)</div>
            <span class="text-xs text-blue-400 flex items-center gap-1 mt-1">
                <i data-lucide="users" class="w-3.5 h-3.5"></i> Active followers
            </span>
        </div>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">1-to-1 Patient Chats Today</div>
            <div class="font-heading font-bold text-2xl text-white">@(Model?.ConsultationsToday ?? 0)</div>
            <span class="text-xs text-purple-400 flex items-center gap-1 mt-1">
                <i data-lucide="clock" class="w-3.5 h-3.5"></i> Consultations today
            </span>
        </div>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">Consultation Rate</div>
            <div class="font-heading font-bold text-2xl text-white">
                @if (Model?.IsFreeConsultation == true)
                {
                    <span class="text-emerald-400">FREE</span>
                }
                else
                {
                    <span>₹@((Model?.ConsultationFeePerMinute ?? 0.00m).ToString("N2")) <span class="text-sm font-normal text-slate-400">/ min</span></span>
                }
            </div>
            @if (Model?.IsApproved == true)
            {
                <span class="text-xs text-emerald-400 flex items-center gap-1 mt-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Admin Approved
                </span>
            }
            else
            {
                <span class="text-xs text-amber-400 flex items-center gap-1 mt-1">
                    <i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending Verification
                </span>
            }
        </div>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all">
            <div class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">My Wallet Balance</div>
            <div class="font-heading font-bold text-2xl text-emerald-400">₹@((Model?.WalletBalance ?? 0.00m).ToString("N2"))</div>
            <a asp-area="Doctor" asp-controller="Earnings" asp-action="Index" class="text-xs text-slate-400 hover:text-white flex items-center gap-1 mt-1">
                <i data-lucide="arrow-down-circle" class="w-3.5 h-3.5"></i> View Earnings Details
            </a>
        </div>
    </div>
</div>
